xt the default placeholders announce to VoiceOver for"},{"type":"text","text":" "},{"type":"text","text":"this case, reusable by a fully custom placeholder that wants to"},{"type":"text","text":" "},{"type":"text","text":"announce transitions with the same wording instead of inventing its"},{"type":"text","text":" "},{"type":"text","text":"own. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for "},{"type":"codeVoice","code":".data"},{"type":"text","text":", since at that point a custom placeholder’s"},{"type":"text","text":" "},{"type":"text","text":"own content is what VoiceOver should read, not a transition"},{"type":"text","text":" "},{"type":"text","text":"announcement."}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstate\/accessibilityannouncement","title":"accessibilityAnnouncement","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityAnnouncement"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"abstract":[{"type":"text","text":"Drive a UIKit screen’s four states with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView"},{"type":"text","text":"."}],"kind":"article","url":"\/documentation\/screenstates\/gettingstartedwithuikit","title":"Getting Started with UIKit","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","role":"article","type":"topic"},"doc://screensta