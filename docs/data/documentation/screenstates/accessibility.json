ntifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"The same text the default placeholders announce to VoiceOver for","type":"text"},{"text":" ","type":"text"},{"text":"this case, reusable by a fully custom placeholder that wants to","type":"text"},{"text":" ","type":"text"},{"text":"announce transitions with the same wording instead of inventing its","type":"text"},{"text":" ","type":"text"},{"text":"own. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".data","type":"codeVoice"},{"text":", since at that point a custom placeholder’s","type":"text"},{"text":" ","type":"text"},{"text":"own content is what VoiceOver should read, not a transition","type":"text"},{"text":" ","type":"text"},{"text":"announcement.","type":"text"}],"url":"\/documentation\/screenstates\/screenstate\/accessibilityannouncement","title":"accessibilityAnnouncement","type":"topic","role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","role":"symbol","kind":"symbol","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"UIView"},{"text":" that swaps its content for the right placeholder based on a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"text":", mirroring ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":" from the SwiftUI side.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ScreenStateContainerView"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateContainerView"}],"type":"topic","title":"ScreenStateContainerView","url":"\/documentation