":"text","text":"?"}],"role":"symbol","abstract":[{"type":"text","text":"The same text the default placeholders announce to VoiceOver for"},{"type":"text","text":" "},{"type":"text","text":"this case, reusable by a fully custom placeholder that wants to"},{"type":"text","text":" "},{"type":"text","text":"announce transitions with the same wording instead of inventing its"},{"type":"text","text":" "},{"type":"text","text":"own. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for "},{"type":"codeVoice","code":".data"},{"type":"text","text":", since at that point a custom placeholder’s"},{"type":"text","text":" "},{"type":"text","text":"own content is what VoiceOver should read, not a transition"},{"type":"text","text":" "},{"type":"text","text":"announcement."}],"kind":"symbol"}}}