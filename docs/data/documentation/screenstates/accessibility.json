tates\/ScreenState","isActive":true,"type":"reference"},{"text":", mirroring ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"text":" from the SwiftUI side.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateContainerView"}],"title":"ScreenStateContainerView","navigatorTitle":[{"kind":"identifier","text":"ScreenStateContainerView"}],"type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateDefaultLoadingView":{"kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateDefaultLoadingView","abstract":[{"type":"text","text":"Default placeholder shown while a screen’s data is loading."}],"url":"\/documentation\/screenstates\/screenstatedefaultloadingview","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateDefaultLoadingView"}],"title":"ScreenStateDefaultLoadingView","navigatorTitle":[{"kind":"identifier","text":"ScreenStateDefaultLoadingView"}],"type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateDefaultEmptyView":{"kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateDefaultEmptyView","abstract":[{"type":"text","text":"Default placeholder shown when a screen has no data to display."}],"url":"\/documentation\/screenstates\/screenstatedefaultemptyview","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateDefaultEmptyView"}],"title":"ScreenStateDefaultEmptyView","navigatorTitle":[{"kind":"identifier","text":"ScreenStateDefaultEmptyView"}],"type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"kind":"symbol","identifier":"doc:\