n/ScreenStates":{"url":"\/documentation\/screenstates","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","title":"ScreenStates","type":"topic","kind":"symbol","abstract":[{"text":"Give any screen a standard ","type":"text"},{"code":"Empty","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Loading","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" state, usable from both UIKit and SwiftUI.","type":"text"}],"role":"collection"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenState","kind":"identifier"}],"title":"ScreenState","url":"\/documentation\/screenstates\/screenstate","kind":"symbol","abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}],"navigatorTitle":[{"text":"ScreenState","kind":"identifier"}],"type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"navigatorTitle":[{"text":"ScreenStateStore","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" holder of a screen’s "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"type":"text","text":", driving both"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI and UIKit consumers from a single source of truth."}],"title":"ScreenStateStore","url":"\/documentation\/screenstates\/screenstatestore","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateStore","kind":"identi