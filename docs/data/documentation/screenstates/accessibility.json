States\/ScreenState\/accessibilityAnnouncement","title":"accessibilityAnnouncement","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The same text the default placeholders announce to VoiceOver for"},{"type":"text","text":" "},{"type":"text","text":"this case, reusable by a fully custom placeholder that wants to"},{"type":"text","text":" "},{"type":"text","text":"announce transitions with the same wording instead of inventing its"},{"type":"text","text":" "},{"type":"text","text":"own. "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for "},{"code":".data","type":"codeVoice"},{"type":"text","text":", since at that point a custom placeholder’s"},{"type":"text","text":" "},{"type":"text","text":"own content is what VoiceOver should read, not a transition"},{"type":"text","text":" "},{"type":"text","text":"announcement."}],"url":"\/documentation\/screenstates\/screenstate\/accessibilityannouncement","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityAnnouncement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"title":"ScreenStateStore","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" holder of a screen’s "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference"},{"type":"text","text":", driving both"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI and UIKit consumers from a single source of truth."}],"url":"\/documentation\/screenstates\/screenstatestore","fragments":[{"kind":"k