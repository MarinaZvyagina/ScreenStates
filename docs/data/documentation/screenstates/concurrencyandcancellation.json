{"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI"],"title":"Related Documentation"},{"anchor":"Modeling-state","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStatePreviewError","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Pagination"],"generated":true,"title":"Modeling state"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/concurrencyandcancellation"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ConcurrencyAndCancellation"},"kind":"article","abstract":[{"text":"The guarantees ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" makes about overlapping, cancelled, and reset calls.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"article","title":"Concurrency & Cancellation","modules":[{"name":"ScreenStates"}],"roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" and built under Swift 6 strict concurrency. Every "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadWithRetry"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadNextPage"},{"type":"text","text":" call is "},{"type":"codeVoice","code":"async"},{"type":"text","text":", which raises three questions the moment a screen does more than one of them: what happens if a second call starts before the first finishes? How do you stop one early? And how do you force a store back to a known state outside of any of them? This article covers all three."}],"type":"paragraph"},{"level":2,"text":"Overlapping calls only ever apply the latest result","type":"heading","anchor":"Overlapping-calls-only-ever-apply-the-latest-result"},{"inlineContent":[{"type":"text","text":"Nothing extra is needed to handle a screen firing off a second call before an earlier one has finished — a fast double-tap on Retry, or a new search query arriving before the previous one resolved:"}],"type":"paragraph"},{"syntax":"swift","code":["await store.load { try await api.fetchArticle(id: 1) } \/\/ slow — still in flight","await store.load { try await api.fetchArticle(id: 2) } \/\/ fast — resolves first"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Internally, every call stamps itself with a token before running "},{"type":"codeVoice","code":"operation"},{"type":"text","text":", and only applies its result — "},{"type":"codeVoice","code":".data"},{"type":"text","text":", "},{"type":"codeVoice","code":".error"},{"type":"text","text":", or the "},{"type":"codeVoice","code":".empty"},{"type":"text","text":" mapping "},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":" do — if that token is still the most recently started one by the time "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" resolves. In the example above, article 1’s slower fetch resolving "},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"type":"text","text":" article 2’s result is already showing never overwrites it; its result is silently dropped. "},{"type":"codeVoice","code":"refresh(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":" follows the same rule: it only clears once the "},{"type":"emphasis","inlineContent":[{"text":"newest","type":"text"}]},{"type":"text","text":" in-flight refresh finishes, not whichever overlapping one happens to resolve first. "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"isLoadingNextPage"},{"type":"text","text":" follows it too."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You don’t need to call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()"},{"type":"text","text":" for this to hold — it’s automatic. Reach for "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" when you additionally want to stop the older call’s work from running at all, not just prevent its result from landing."}],"type":"paragraph"},{"level":2,"text":"Cancelling explicitly","type":"heading","anchor":"Cancelling-explicitly"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()"},{"text":" to stop whatever call is currently running, without waiting for it to resolve:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["store.cancel() \/\/ e.g. from onDisappear, or right before firing off a newer query"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"state","type":"codeVoice"},{"text":" (and ","type":"text"},{"code":"isRefreshing","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refreshError","type":"codeVoice"},{"text":") are left exactly as they were — cancelling never surfaces a ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" the way letting ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" itself fail would. This applies uniformly, including to ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadWithRetry(maxAttempts:backoff:_:)","isActive":true,"type":"reference"},{"text":" cancelled mid-backoff: it stops retrying and leaves ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" untouched, just like every other call. If nothing is in flight, ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":" does nothing.","type":"text"}]},{"level":2,"text":"Cancelling automatically","type":"heading","anchor":"Cancelling-automatically"},{"inlineContent":[{"text":"A store also cancels whatever it was still tracking when it’s deallocated, as a last-resort safety net — you don’t need to call ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"deinit","type":"codeVoice"},{"text":" yourself. In practice this rarely has anything to do: ","type":"text"},{"code":"load","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refresh","type":"codeVoice"},{"text":"\/etc. already ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" their own work to completion before returning, so by the time a store can actually be deallocated, there’s normally nothing left in flight to cancel. It exists to guard against that assumption changing later, for free.","type":"text"}],"type":"paragraph"},{"text":"Resetting outside of a load","anchor":"Resetting-outside-of-a-load","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)","isActive":true,"type":"reference"},{"text":" snaps a store back to ","type":"text"},{"type":"codeVoice","code":".loading"},{"type":"text","text":" (or any state you give it) without going through "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" at all — useful for a full sign-out flow, where whatever the store was showing or fetching no longer applies to the next signed-in user:"}],"type":"paragraph"},{"code":["func signOut() {","    session.clear()","    articlesStore.reset() \/\/ back to .loading, as if freshly created","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Like "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":", it stops whatever operation is currently in flight; unlike "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":", it also immediately replaces "},{"type":"codeVoice","code":"state"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":", so a screen bound to the store reflects the reset right away instead of waiting for a cancelled operation to unwind."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"type":"topic","title":"ScreenStateStore","url":"\/documentation\/screenstates\/screenstatestore","navigatorTitle":[{"text":"ScreenStateStore","kind":"identifier"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","abstract":[{"text":"An ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" holder of a screen’s ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":", driving both","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI and UIKit consumers from a single source of truth.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateStore","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/previewError(_:)":{"type":"topic","title":"previewError(_:)","url":"\/documentation\/screenstates\/screenstatestore\/previewerror(_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"previewError","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") -> ","kind":"text"},{"text":"ScreenStateStore","kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A10StateStoreC"},{"text":"<","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A10StateStoreC5Valuexmfp"},{"text":">","kind":"text"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/previewError(_:)","kind":"symbol","abstract":[{"type":"text","text":"A store pinned to "},{"type":"codeVoice","code":".error"},{"type":"text","text":", with a generic "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStatePreviewError"},{"type":"text","text":" "},{"type":"text","text":"so a preview doesn’t need a placeholder "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" type of its own."}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"type":"topic","title":"ScreenState","navigatorTitle":[{"kind":"identifier","text":"ScreenState"}],"url":"\/documentation\/screenstates\/screenstate","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenState"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","kind":"symbol","abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/loadNextPage(_:)":{"type":"topic","title":"loadNextPage(_:)","url":"\/documentation\/screenstates\/screenstatestore\/loadnextpage(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loadNextPage","kind":"identifier"},{"text":"(","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A10StateStoreCAASmRzlE5Valuexmfp"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","kind":"symbol","abstract":[{"type":"text","text":"Fetches another page with "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" and appends it to the"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"type":"codeVoice","code":".data"},{"type":"text","text":" collection instead of replacing "},{"type":"codeVoice","code":"state"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"pagination counterpart of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refresh(_:)"},{"type":"text","text":" keeping data on screen"},{"type":"text","text":" "},{"type":"text","text":"while a background fetch runs. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isLoadingNextPage"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the duration. On failure "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is left alone and the error is"},{"type":"text","text":" "},{"type":"text","text":"reported via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError"},{"type":"text","text":" instead, so the pages already"},{"type":"text","text":" "},{"type":"text","text":"loaded aren’t discarded just because the next one failed. Guarded"},{"type":"text","text":" "},{"type":"text","text":"against the same overlapping-call race as "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":": if a"},{"type":"text","text":" "},{"type":"text","text":"second "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" (or any other "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"-family"},{"type":"text","text":" "},{"type":"text","text":"call) starts before this one’s "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" resolves, this call’s"},{"type":"text","text":" "},{"type":"text","text":"result is silently dropped instead of applied."}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates":{"type":"topic","title":"ScreenStates","url":"\/documentation\/screenstates","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","abstract":[{"text":"Give any screen a standard ","type":"text"},{"code":"Empty","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Loading","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" state, usable from both UIKit and SwiftUI.","type":"text"}],"kind":"symbol","role":"collection"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"type":"topic","title":"ScreenStateView","navigatorTitle":[{"kind":"identifier","text":"ScreenStateView"}],"url":"\/documentation\/screenstates\/screenstateview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateView"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","kind":"symbol","abstract":[{"type":"text","text":"Renders the right content for a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"type":"text","text":"Empty \/ Loading \/ Data \/ Error automatically."}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStatePreviewError":{"type":"topic","title":"ScreenStatePreviewError","navigatorTitle":[{"text":"ScreenStatePreviewError","kind":"identifier"}],"url":"\/documentation\/screenstates\/screenstatepreviewerror","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStatePreviewError","kind":"identifier"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStatePreviewError","abstract":[{"type":"text","text":"A generic error for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/previewError(_:)"},{"type":"text","text":", so a preview"},{"type":"text","text":" "},{"type":"text","text":"doesn’t need its own placeholder "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" type just to show "},{"t