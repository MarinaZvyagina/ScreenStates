 ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"the duration. On failure ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" is left alone and the error is","type":"text"},{"text":" ","type":"text"},{"text":"reported via ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError","type":"reference","isActive":true},{"text":" instead, so the pages already","type":"text"},{"text":" ","type":"text"},{"text":"loaded aren’t discarded just because the next one failed. Guarded","type":"text"},{"text":" ","type":"text"},{"text":"against the same overlapping-call race as ","type":"text"},{"code":"load","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refresh","type":"codeVoice"},{"text":": if a","type":"text"},{"text":" ","type":"text"},{"text":"second ","type":"text"},{"code":"loadNextPage(_:)","type":"codeVoice"},{"text":" (or any other ","type":"text"},{"code":"load","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refresh","type":"codeVoice"},{"text":"-family","type":"text"},{"text":" ","type":"text"},{"text":"call) starts before this one’s ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" resolves, this call’s","type":"text"},{"text":" ","type":"text"},{"text":"result is silently dropped instead of applied.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenState"}],"kind":"symbol","abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}],"role":"symbol","navigatorTitle":[{"text":"ScreenState","kind":"identifier"}],"url":"\/documentation\/screenstates\/screenstate","identifier":"doc:\/\/screenstates.ScreenStates\/