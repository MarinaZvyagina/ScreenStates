":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"type":"text","text":"Empty \/ Loading \/ Data \/ Error automatically."}],"title":"ScreenStateView","role":"symbol","navigatorTitle":[{"text":"ScreenStateView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"topic","url":"\/documentation\/screenstates\/screenstateview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateView","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/loadNextPage(_:)":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Fetches another page with "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" and appends it to the"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"code":".data","type":"codeVoice"},{"type":"text","text":" collection instead of replacing "},{"code":"state","type":"codeVoice"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"pagination counterpart of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refresh(_:)"},{"type":"text","text":" keeping data on screen"},{"type":"text","text":" "},{"type":"text","text":"while a background fetch runs. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isLoadingNextPage"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the duration. On failure "},{"code":"state","type":"codeVoice"},{"type":"text","text":" is left alone and the error is"},{"type":"text","text":" "},{"type":"text","text":"reported via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError"},{"type":"text","text":" instead, so the pages already"},{"type":"text","text":" "},{"type":"text","text":"loaded aren’t discarded just because the next one failed. Guarded"},{"type":"text","text":" "},{"type":"text","text":"against the same overlapping-call race as "},{"code":"load","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refresh","type":"codeVoice"},{"type":"text","text":": if a"},{"type":"text","text":" "},{"type":"text","text":"second "},{"code":"loadNextPage(_:)","type":"codeVoice"},{"type":"text","text":" (or any other "},{"code":"load","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refresh","type":"codeVoice"},{"type":"text","text":"-family"},{"type":"text","text":" "},{"type":"text","text":"call) starts before this one’s "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" resolves, this call’s"},{"type":"text","text":" "},{"type":"text","text":"result is silently dropped instead of applied."}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loadNextPage"},{"kind":"text","text":"("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:12ScreenStates0A10StateStoreCAASmRzlE5Valuexmfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"title":"loadNextPage(_:)","role":"symbol","url":"\/documentation\/screenstates\/screenstatestore\/loadnextpage(_:)"}}}