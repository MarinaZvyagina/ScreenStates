/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError"},{"type":"text","text":" instead, so the pages already"},{"type":"text","text":" "},{"type":"text","text":"loaded aren’t discarded just because the next one failed. Guarded"},{"type":"text","text":" "},{"type":"text","text":"against the same overlapping-call race as "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":": if a"},{"type":"text","text":" "},{"type":"text","text":"second "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" (or any other "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"-family"},{"type":"text","text":" "},{"type":"text","text":"call) starts before this one’s "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" resolves, this call’s"},{"type":"text","text":" "},{"type":"text","text":"result is silently dropped instead of applied."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/cancel()":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"()"}],"url":"\/documentation\/screenstates\/screenstatestore\/cancel()","title":"cancel()","abstract":[{"type":"text","text":"Cancels whatever "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"\/"},{"type":"text","text":" "},{"type":"codeVoice","code":"refreshCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadWithRetry"},{"type":"text","text":" call is currently in flight, if"},{"type":"text","text":" "},{"type":"text","text":"any. "},{"type":"codeVoice","code":"state"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":") are left exactly as"},{"type":"text","text":" "},{"type":"text","text":"they were — cancelling never surfaces a "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"codeVoice","code":"state"},{"type":"text","text":", unlike letting "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" itself fail."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/reset(to:)":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reset"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A5StateO","text":"ScreenState"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A10StateStoreC5Valuexmfp","text":"Value"},{"kind":"text","text":">)"}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstatestore\/reset(to:)","abstract":[{"text":"Snaps the store back to ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" (","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" by default), outside of","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"load","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refresh","type":"codeVoice"},{"text":" call — useful for a full sign-out\/reset flow,","type":"text"},{"text":" ","type":"text"},{"text":"where whatever the store was showing or fetching no longer applies.","type":"text"}],"title":"reset(to:)","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)"},"doc://screen