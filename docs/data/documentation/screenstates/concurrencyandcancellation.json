":"text","text":"settling into "},{"code":".error","type":"codeVoice"},{"type":"text","text":" after the first failure. "},{"code":"state","type":"codeVoice"},{"type":"text","text":" stays"},{"type":"text","text":" "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" across every attempt; only the final failure (once"},{"type":"text","text":" "},{"code":"maxAttempts","type":"codeVoice"},{"type":"text","text":" is reached) or a success changes it."}],"url":"\/documentation\/screenstates\/screenstatestore\/loadwithretry(maxattempts:backoff:_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loadWithRetry","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxAttempts","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":", ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A10StateStoreC5Valuexmfp"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"loadWithRetry(maxAttempts:backoff:_:)"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/load(_:)":{"type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/load(_:)","abstract":[{"type":"text","text":"Runs "},{"type":"codeVoice","code":"operation"},{"type":"text","text":", showing "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" while it’s in flight and"},{"