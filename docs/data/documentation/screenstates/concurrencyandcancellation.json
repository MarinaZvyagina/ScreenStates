{"variants":[{"paths":["\/documentation\/screenstates\/concurrencyandcancellation"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ConcurrencyAndCancellation","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" and built under Swift 6 strict concurrency. Every "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadWithRetry"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadNextPage"},{"type":"text","text":" call is "},{"type":"codeVoice","code":"async"},{"type":"text","text":", which raises three questions the moment a screen does more than one of them: what happens if a second call starts before the first finishes? How do you stop one early? And how do you force a store back to a known state outside of any of them? This article covers all three."}]},{"level":2,"anchor":"Overlapping-calls-only-ever-apply-the-latest-result","type":"heading","text":"Overlapping calls only ever apply the latest result"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing extra is needed to handle a screen firing off a second call before an earlier one has finished — a fast double-tap on Retry, or a new search query arriving before the previous one resolved:"}]},{"syntax":"swift","type":"codeListing","code":["await store.load { try await api.fetchArticle(id: 1) } \/\/ slow — still in flight","await store.load { try await api.fetchArticle(id: 2) } \/\/ fast — resolves first"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Internally, every call stamps itself with a token before running "},{"type":"codeVoice","code":"operation"},{"type":"text","text":", and only applies its result — "},{"type":"codeVoice","code":".data"},{"type":"text","text":", "},{"type":"codeVoice","code":".error"},{"type":"text","text":", or the "},{"type":"codeVoice","code":".empty"},{"type":"text","text":" mapping "},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":" do — if that token is still the most recently started one by the time "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" resolves. In the example above, article 1’s slower fetch resolving "},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"type":"text","text":" article 2’s result is already showing never overwrites it; its result is silently dropped. "},{"type":"codeVoice","code":"refresh(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":" follows the same rule: it only clears once the "},{"inlineContent":[{"text":"newest","type":"text"}],"type":"emphasis"},{"type":"text","text":" in-flight refresh finishes, not whichever overlapping one happens to resolve first. "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"isLoadingNextPage"},{"type":"text","text":" follows it too."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You don’t need to call "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","type":"reference","isActive":true},{"type":"text","text":" for this to hold — it’s automatic. Reach for "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" when you additionally want to stop the older call’s work from running at all, not just prevent its result from landing."}]},{"level":2,"anchor":"Cancelling-explicitly","type":"heading","text":"Cancelling explicitly"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","type":"reference","isActive":true},{"type":"text","text":" to stop whatever call is currently running, without waiting for it to resolve:"}]},{"syntax":"swift","type":"codeListing","code":["store.cancel() \/\/ e.g. from onDisappear, or right before firing off a newer query"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"state"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":") are left exactly as they were — cancelling never surfaces a "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" through "},{"type":"codeVoice","code":"state"},{"type":"text","text":" the way letting "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" itself fail would. This applies uniformly, including to "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadWithRetry(maxAttempts:backoff:_:)","type":"reference","isActive":true},{"type":"text","text":" cancelled mid-backoff: it stops retrying and leaves "},{"type":"codeVoice","code":"state"},{"type":"text","text":" untouched, just like every other call. If nothing is in flight, "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" does nothing."}]},{"level":2,"anchor":"Cancelling-automatically","type":"heading","text":"Cancelling automatically"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store also cancels whatever it was still tracking when it’s deallocated, as a last-resort safety net — you don’t need to call "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" from "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" yourself. In practice this rarely has anything to do: "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"\/etc. already "},{"type":"codeVoice","code":"await"},{"type":"text","text":" their own work to completion before returning, so by the time a store can actually be deallocated, there’s normally nothing left in flight to cancel. It exists to guard against that assumption changing later, for free."}]},{"level":2,"anchor":"Resetting-outside-of-a-load","type":"heading","text":"Resetting outside of a load"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)","type":"reference","isActive":true},{"type":"text","text":" snaps a store back to "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" (or any state you give it) without going through "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" at all — useful for a full sign-out flow, where whatever the store was showing or fetching no longer applies to the next signed-in user:"}]},{"syntax":"swift","type":"codeListing","code":["func signOut() {","    session.clear()","    articlesStore.reset() \/\/ back to .loading, as if freshly created","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":", it stops whatever operation is currently in flight; unlike "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":", it also immediately replaces "},{"type":"codeVoice","code":"state"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":", so a screen bound to the store reflects the reset right away instead of waiting for a cancelled operation to unwind."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"The guarantees "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" makes about overlapping, cancelled, and reset calls."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI"]},{"anchor":"Modeling-state","title":"Modeling state","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStatePreviewError","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Pagination"],"generated":true}],"sections":[],"metadata":{"modules":[{"name":"ScreenStates"}],"roleHeading":"Article","title":"Concurrency & Cancellation","role":"article"},"kind":"article","references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"navigatorTitle":[{"text":"ScreenStateView","kind":"identifier"}],"url":"\/documentation\/screenstates\/screenstateview","title":"ScreenStateView","role":"symbol","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","abstract":[{"type":"text","text":"Renders the right content for a "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Scree