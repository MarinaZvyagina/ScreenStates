of a load","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)"},{"text":" snaps a store back to ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":" (or any state you give it) without going through ","type":"text"},{"type":"codeVoice","code":"load"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"refresh"},{"text":" at all — useful for a full sign-out flow, where whatever the store was showing or fetching no longer applies to the next signed-in user:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func signOut() {","    session.clear()","    articlesStore.reset() \/\/ back to .loading, as if freshly created","}"]},{"type":"paragraph","inlineContent":[{"text":"Like ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":", it stops whatever operation is currently in flight; unlike ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":", it also immediately replaces ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" and clears ","type":"text"},{"code":"isRefreshing","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refreshError","type":"codeVoice"},{"text":", so a screen bound to the store reflects the reset right away instead of waiting for a cancelled operation to unwind.","type":"text"}]}]}],"kind":"article","references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"kind":"article","role":"article","type":"topic","abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"text":"."