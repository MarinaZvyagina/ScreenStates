ype":"text","text":" "},{"type":"text","text":"the duration. On failure "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is left alone and the error is"},{"type":"text","text":" "},{"type":"text","text":"reported via "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError","isActive":true},{"type":"text","text":" instead, so the pages already"},{"type":"text","text":" "},{"type":"text","text":"loaded aren’t discarded just because the next one failed. Guarded"},{"type":"text","text":" "},{"type":"text","text":"against the same overlapping-call race as "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":": if a"},{"type":"text","text":" "},{"type":"text","text":"second "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" (or any other "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"-family"},{"type":"text","text":" "},{"type":"text","text":"call) starts before this one’s "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" resolves, this call’s"},{"type":"text","text":" "},{"type":"text","text":"result is silently dropped instead of applied."}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstatestore\/loadnextpage(_:)","title":"loadNextPage(_:)","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loadNextPage"},{"kind":"text","text":"("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12ScreenStates0A10StateStoreCAAS