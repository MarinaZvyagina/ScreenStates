text","text":" "},{"type":"text","text":"result is silently dropped instead of applied."}],"type":"topic","url":"\/documentation\/screenstates\/screenstatestore\/loadnextpage(_:)","title":"loadNextPage(_:)"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/reset(to:)":{"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"reset"},{"kind":"text","text":"("},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12ScreenStates0A5StateO","text":"ScreenState","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A10StateStoreC5Valuexmfp","text":"Value"},{"kind":"text","text":">)"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)","title":"reset(to:)","abstract":[{"type":"text","text":"Snaps the store back to "},{"type":"codeVoice","code":"state"},{"type":"text","text":" ("},{"type":"codeVoice","code":".loading"},{"type":"text","text":" by default), outside of"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" call — useful for a full sign-out\/reset flow,"},{"type":"text","text":" "},{"type":"text","text":"where whatever the store was showing or fetching no longer applies."}],"url":"\/documentation\/screenstates\/screenstatestore\/reset(to:)","kind":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/loadWithRetry(maxAttempts:backoff:_:)":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loadWithRetry"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxAttempts"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{