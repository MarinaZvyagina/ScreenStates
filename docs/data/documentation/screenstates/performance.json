},{"type":"text","text":" "},{"type":"text","text":"way to learn a background refresh failed. Cleared at the start of the"},{"type":"text","text":" "},{"type":"text","text":"next load or refresh."}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshError","url":"\/documentation\/screenstates\/screenstatestore\/refresherror"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenState","kind":"identifier"}],"navigatorTitle":[{"text":"ScreenState","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic","title":"ScreenState","abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","url":"\/documentation\/screenstates\/screenstate"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/isRefreshing":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isRefreshing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","type":"topic","kind":"symbol","title":"isRefreshing","abstract":[{"code":"true","type":"codeVoice"},{"type":"text","text":" while "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refresh(_:)","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshCollection(_:)"},{"type":"text","text":" is fetching"},{"type":"text","text":" "},{"type":"text","text":"in the background with the previous data still shown in "},{"code":"state","type":"codeVoice"},