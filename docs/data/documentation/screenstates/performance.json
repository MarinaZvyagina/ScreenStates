ode":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"\/"},{"type":"text","text":" "},{"type":"codeVoice","code":"refreshCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadWithRetry"},{"type":"text","text":" call is currently in flight, if"},{"type":"text","text":" "},{"type":"text","text":"any. "},{"type":"codeVoice","code":"state"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":") are left exactly as"},{"type":"text","text":" "},{"type":"text","text":"they were — cancelling never surfaces a "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"codeVoice","code":"state"},{"type":"text","text":", unlike letting "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" itself fail."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"role":"symbol","url":"\/documentation\/screenstates\/screenstatestore\/cancel()","title":"cancel()"},"doc://screenstates.ScreenStates/documentation/ScreenStates":{"kind":"symbol","abstract":[{"type":"text","text":"Give any screen a standard "},{"type":"codeVoice","code":"Empty"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Loading"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" state, usable from both UIKit and SwiftUI."}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","role":"collection","type":"topic","url":"\/documentation\/screenstates","title":"ScreenStates"}}}