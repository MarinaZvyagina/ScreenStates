esh(_:)","title":"refresh(_:)","abstract":[{"type":"text","text":"Like "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/load(_:)","isActive":true},{"type":"text","text":", but keeps any data already in "},{"code":"state","type":"codeVoice"},{"type":"text","text":" on screen"},{"type":"text","text":" "},{"type":"text","text":"while "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" runs instead of switching to "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"pattern behind pull-to-refresh, where the list shouldn’t disappear"},{"type":"text","text":" "},{"type":"text","text":"while it’s being refetched. "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isRefreshing","isActive":true},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"duration. On success "},{"code":"state","type":"codeVoice"},{"type":"text","text":" is replaced as usual; on failure "},{"code":"state","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is left alone and the error is reported via "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshError","isActive":true},{"type":"text","text":" instead."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateStore"}],"url":"\/documentation\/screenstates\/screenstatestore","title":"ScreenStateStore","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" holder of a screen’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":", driving both"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI and UIKit consumers from a single source of truth."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/load(_:)":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/load(_:)","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"load"},{"kind":"text","text":"("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A10StateStoreC5Valuexmfp","text":"Value"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"url":"\/documentation\/screenstates\/screenstatestore\/load(_:)","title":"load(_:)","abstract":[{"type":"text","text":"Runs "},{"type":"codeVoice","code":"operation"},{"type":"text","text":", showing "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" while it’s in flight and"},{"type":"text","text":" "},{"type":"text","text":"mapping its outcome to "},{"type":"codeVoice","code":".data"},{"type":"text","text":" or "},{"type":"codeVoice","code":".error"},{"type":"text","text":"."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/isRefreshing":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isRefreshing","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","t