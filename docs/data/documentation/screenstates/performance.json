"text","text":"?"}],"url":"\/documentation\/screenstates\/screenstatestore\/refresherror"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/load(_:)":{"abstract":[{"type":"text","text":"Runs "},{"code":"operation","type":"codeVoice"},{"type":"text","text":", showing "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" while it’s in flight and"},{"type":"text","text":" "},{"type":"text","text":"mapping its outcome to "},{"type":"codeVoice","code":".data"},{"type":"text","text":" or "},{"type":"codeVoice","code":".error"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/load(_:)","url":"\/documentation\/screenstates\/screenstatestore\/load(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"load","kind":"identifier"},{"text":"(","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:12ScreenStates0A10StateStoreC5Valuexmfp"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"load(_:)"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"article","url":"\/documentation\/screenstates\/gettingstartedwithswiftui","type":"topic","role":"article","title":"Getting Started with SwiftUI","identifier":"doc:\/\