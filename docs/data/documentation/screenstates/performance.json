es\/ScreenStateStore\/refresh(_:)","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Like "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/load(_:)","isActive":true,"type":"reference"},{"type":"text","text":", but keeps any data already in "},{"type":"codeVoice","code":"state"},{"type":"text","text":" on screen"},{"type":"text","text":" "},{"type":"text","text":"while "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" runs instead of switching to "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"pattern behind pull-to-refresh, where the list shouldn’t disappear"},{"type":"text","text":" "},{"type":"text","text":"while it’s being refetched. "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isRefreshing","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"duration. On success "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is replaced as usual; on failure "},{"type":"codeVoice","code":"state"},{"type":"text","text":" "},{"type":"text","text":"is left alone and the error is reported via "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshError","type":"reference","isActive":true},{"type":"text","text":" instead."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refresh"},{"kind":"text","text":"("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A10StateStoreC5Valuexmfp","text":"Value"},{"ki