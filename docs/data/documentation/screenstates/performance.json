","type":"codeVoice"},{"type":"text","text":" instead of"},{"type":"text","text":" "},{"code":".data","type":"codeVoice"},{"type":"text","text":" — convenient when "},{"code":"Value","type":"codeVoice"},{"type":"text","text":" is a list of items to display."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loadCollection"},{"kind":"text","text":"("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A10StateStoreCAASlRzlE5Valuexmfp","text":"Value"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"title":"loadCollection(_:)","type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/refreshError":{"title":"refreshError","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshError","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshError","abstract":[{"type":"text","text":"The error from the most recently failed "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refresh(_:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshCollection(_:)"},{"type":"text","text":". "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is left untouched by a refresh"},{"type":"text","text":" "},{"type":"text","text":"failure — the last good data stays on screen — so t