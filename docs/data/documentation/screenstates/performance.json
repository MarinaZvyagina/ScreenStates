er "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"\/"},{"type":"text","text":" "},{"type":"codeVoice","code":"refreshCollection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadWithRetry"},{"type":"text","text":" call is currently in flight, if"},{"type":"text","text":" "},{"type":"text","text":"any. "},{"type":"codeVoice","code":"state"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":") are left exactly as"},{"type":"text","text":" "},{"type":"text","text":"they were — cancelling never surfaces a "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"codeVoice","code":"state"},{"type":"text","text":", unlike letting "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" itself fail."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"kind":"symbol","title":"ScreenStateView","role":"symbol","type":"topic","url":"\/documentation\/screenstates\/screenstateview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateView"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","navigatorTitle":[{"kind":"identifier","text":"ScreenStateView"}],"abstract":[{"text":"Renders the right content for a ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":", switching between","type":"text"},{"text":" ","type":"text"},{"text":"Empty \/ Loading \/ Data \/ Error automatically.","type":"text"}]}}}