{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":" fetch everything a screen needs in one shot; "},{"type":"codeVoice","code":"refresh(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":" refetch all of it while keeping the old data on screen in the meantime. Neither fits a third common shape: a list that grows one page at a time as the user scrolls, where each new page should be "},{"type":"emphasis","inlineContent":[{"type":"text","text":"appended"}]},{"type":"text","text":" to what’s already there, not replace it. "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","isActive":true},{"type":"text","text":" is that third shape, available when "},{"type":"codeVoice","code":"Value: RangeReplaceableCollection"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Loading more pages","anchor":"Loading-more-pages"},{"syntax":"swift","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","    @State private var nextPage = 2 \/\/ page 1 is already loaded by reload()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","                    .task {","                        if article.id == articles.last?.id {","                            await loadMore()","                        }","                    }","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles(page: 1) }","    }","","    private func loadMore() async {","        await store.loadNextPage { try await api.fetchArticles(page: nextPage) }","        nextPage += 1","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":" fetches the first page as usual; "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" fetches every page after that, appending its result to the existing "},{"type":"codeVoice","code":".data"},{"type":"text","text":" collection. It requires "},{"type":"codeVoice","code":"state"},{"type":"text","text":" to already be "},{"type":"codeVoice","code":".data"},{"type":"text","text":" — call "},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":" first — and does nothing otherwise, so an accidental early call (before the first page has loaded) is a no-op rather than a crash or a replaced state."}]},{"level":2,"type":"heading","text":"isLoadingNextPage and loadNextPageError","anchor":"isLoadingNextPage-and-loadNextPageError"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isLoadingNextPage","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for the duration of a "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" call — show a small spinner at the bottom of the list while it’s "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the pagination equivalent of "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isRefreshing","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the page fetch fails, "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is left exactly as it was (the pages already loaded stay on screen) and the error is reported through "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError","isActive":true},{"type":"text","text":" instead of replacing "},{"type":"codeVoice","code":"state"},{"type":"text","text":" with "},{"type":"codeVoice","code":".error"},{"type":"text","text":" — the same shape as "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refresh(_:)","isActive":true},{"type":"text","text":"\/"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshError","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","code":["if let error = store.loadNextPageError {","    Text(\"Couldn't load more: \\(error.localizedDescription)\")","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"loadNextPageError"},{"type":"text","text":" is cleared at the start of the next "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" call, so a retried page fetch that succeeds clears a stale failure automatically."}]},{"level":2,"type":"heading","text":"Overlapping calls","anchor":"Overlapping-calls"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" follows the same overlapping-call rule as every other "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"-family method (see "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ConcurrencyAndCancellation","isActive":true},{"type":"text","text":"): if a second call — another "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":", or a "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice