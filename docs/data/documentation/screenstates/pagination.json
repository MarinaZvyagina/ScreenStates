":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Loading-more-pages","text":"Loading more pages"},{"type":"codeListing","syntax":"swift","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","    @State private var nextPage = 2 \/\/ page 1 is already loaded by reload()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","                    .task {","                        if article.id == articles.last?.id {","                            await loadMore()","                        }","                    }","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles(page: 1) }","    }","","    private func loadMore() async {","        await store.loadNextPage { try await api.fetchArticles(page: nextPage) }","        nextPage += 1","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":" fetches the first page as usual; "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" fetches every page after that, appending its result to the existing "},{"type":"codeVoice","code":".data"},{"type":"text","text":" collection. It requires "},{"type":"codeVoice","code":"state"},{"type":"text","text":" to already be "},{"type":"codeVoice","code":".data"},{"type":"text","text":" — call "},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":" first — and does nothing otherwise, so an accidental early call (before the first page has loaded) is a no-op rather than a crash or a replaced state."}]},{"type":"heading","level":2,"anchor":"isLoadingNextPage-and-loadNextPageError","text":"isLoadingNextPage and loadNextPageError"},{"type":"paragraph","inlineContent":[{"type":"referenc