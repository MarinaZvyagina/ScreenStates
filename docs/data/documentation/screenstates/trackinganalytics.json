{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/TrackingAnalytics"},"metadata":{"roleHeading":"Article","modules":[{"name":"ScreenStates"}],"title":"Tracking Screen Analytics","role":"article"},"abstract":[{"text":"Send screen-opened and state-transition events to any analytics backend with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","type":"reference"},{"text":".","type":"text"}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"anchor":"Related-Documentation"},{"anchor":"Analytics","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"title":"Analytics","generated":true}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Every screen that models its state with "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" already knows exactly when it was opened and when it moves between Empty, Loading, Data, and Error. "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","type":"reference","isActive":true},{"type":"text","text":" turns those moments into "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","type":"reference","isActive":true},{"type":"text","text":"s and fans them out to as many "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","type":"reference","isActive":true},{"type":"text","text":"s as you register — one per analytics backend (Firebase, Mixpanel, Amplitude, your own logging endpoint, a debug console print, …)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"ScreenStates ships no backend-specific tracker implementations, so the core module stays dependency-free — but it does include "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","type":"reference","isActive":true},{"type":"text","text":" (logs every event to the console) and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker","type":"reference","isActive":true},{"type":"text","text":" (silently discards everything), so you don’t have to hand-roll a console logger just to confirm events fire at the right moments. For a real backend, write one small adapter, converting the event’s backend-agnostic "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","type":"reference","isActive":true},{"type":"text","text":" parameters into that SDK’s own format:"}],"type":"paragraph"},{"syntax":"swift","code":["struct FirebaseScreenTracker: ScreenAnalyticsTracker {","    func track(_ event: ScreenAnalyticsEvent) {","        Analytics.logEvent(event.name, parameters: event.parameters.mapValues { value in","            switch value {","            case .string(let string): string","            case .int(let int): int","            case .double(let double): double","            case .bool(let bool): bool","            }","        })","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"An adapter is also free to remap "},{"type":"codeVoice","code":"event.name"},{"type":"text","text":" to whatever vocabulary its backend expects — Firebase, for example, reserves a specific constant for screen views."}],"type":"paragraph"},{"level":2,"text":"Wiring a screen","anchor":"Wiring-a-screen","type":"heading"},{"syntax":"swift","code":["let analytics = ScreenAnalyticsService(trackers: [FirebaseScreenTracker(), PrintScreenAnalyticsTracker()])","","func onAppear(source: ScreenOpenSource<AppScreen>) {","    analytics.trackScreenOpened(\"Articles\", source: source.analyticsKind)","    analytics.observeStateChanges(of: store, screen: \"Articles\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"trackScreenOpened(_:source:)"},{"type":"text","text":" sends one "},{"type":"codeVoice","code":"screen_opened"},{"type":"text","text":" event. "},{"type":"codeVoice","code":"observeStateChanges(of:screen:)"},{"type":"text","text":" uses the same "},{"type":"codeVoice","code":"withObservationTracking"},{"type":"text","text":" mechanism "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","type":"reference","isActive":true},{"type":"text","text":" uses to mirror a store, and sends a "},{"type":"codeVoice","code":"screen_state_changed"},{"type":"text","text":" event for every subsequent "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":" transition — call it once, right where you create or first observe the store. When a transition lands on "},{"type":"codeVoice","code":".error"},{"type":"text","text":", the event also carries the error’s "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It also times how long the screen spends in "},{"type":"codeVoice","code":".loading"},{"type":"text","text":": the moment the state leaves "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" for "},{"type":"codeVoice","code":".data"},{"type":"text","text":", "},{"type":"codeVoice","code":".empty"},{"type":"text","text":", or "},{"type":"codeVoice","code":".error"},{"type":"text","text":", it sends a "},{"type":"codeVoice","code":"screen_load_duration"},{"type":"text","text":" event ("},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenLoadDuration(screen:outcome:milliseconds:)","type":"reference","isActive":true},{"type":"text","text":") with that outcome and the elapsed time in "},{"type":"codeVoice","code":"duration_ms"},{"type":"text","text":" — useful for a “how long do loads actually take, and how often do they end in an error” dashboard without hand-rolling a stopwatch around every "},{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":" call."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"screen_state_changed"},{"type":"text","text":" event landing on "},{"type":"codeVoice","code":".error"},{"type":"text","text":" tells you a screen failed to load; it doesn’t tell you whether the user gave up or hit Retry. Call "},{"type":"codeVoice","code":"trackRetryTapped(_:)"},{"type":"text","text":" ("},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenRetryTapped(screen:)","type":"reference","isActive":true},{"type":"text","text":") from the same "},{"type":"codeVoice","code":"onRetry"},{"type":"text","text":" closure you pass to the Error placeholder, so that’s a distinct, countable event instead of indistinguishable from the screen’s initial "},{"type":"codeVoice","code":".loading"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["ScreenStateView(store.state, onRetry: {","    analytics.trackRetryTapped(\"Articles\")","    Task { await store.load { try await api.fetchArticles() } }","}) { articles in","    ArticleList(articles)","}"],"type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","type":"reference","isActive":true},{"type":"text","text":" doesn’t move "},{"type":"codeVoice","code":"state"},{"type":"text","text":" off "},{"type":"codeVoice","code":".data"},{"type":"text","text":" on either a success or a failure, so "},{"type":"codeVoice","code":"observeStateChanges(of:screen:)"},{"type":"text","text":" has nothing to report for it — call "},{"type":"codeVoice","code":"trackNextPageLoaded(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"trackNextPageFailed(_:errorDescription:)"},{"type":"text","text":" ("},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageLoaded(screen:)","type":"reference","isActive":true},{"type":"text","text":"\/"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageFailed(screen:errorDescription:)","type":"reference","isActive":true},{"type":"text","text":") from the same place you call "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":", mirroring how "},{"type":"codeVoice","code":"trackRetryTapped(_:)"},{"type":"text","text":" is called from "},{"type":"codeVoice","code":"onRetry"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["func loadMore() async {","    await store.loadNextPage { try await api.fetchArticles(page: nextPage) }","    if let error = store.loa