{"abstract":[{"type":"text","text":"Send screen-opened and state-transition events to any analytics backend with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService"},{"type":"text","text":"."}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/trackinganalytics"]}],"sections":[],"metadata":{"modules":[{"name":"ScreenStates"}],"roleHeading":"Article","title":"Tracking Screen Analytics","role":"article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/TrackingAnalytics","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"title":"Related Documentation","anchor":"Related-Documentation"},{"anchor":"Analytics","title":"Analytics","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Every screen that models its state with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" already knows exactly when it was opened and when it moves between Empty, Loading, Data, and Error. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService"},{"text":" turns those moments into ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent"},{"text":"s and fans them out to as many ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker"},{"text":"s as you register — one per analytics backend (Firebase, Mixpanel, Amplitude, your own logging endpoint, a debug console print, …).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"ScreenStates ships no backend-specific tracker implementations, so the core module stays dependency-free — but it does include ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker"},{"text":" (logs every event to the console) and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"},{"text":" (silently discards everything), so you don’t have to hand-roll a console logger just to confirm events fire at the right moments. For a real backend, write one small adapter, converting the event’s backend-agnostic ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue"},{"text":" parameters into that SDK’s own format:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct FirebaseScreenTracker: ScreenAnalyticsTracker {","    func track(_ event: ScreenAnalyticsEvent) {","        Analytics.logEvent(event.name, parameters: event.parameters.mapValues { value in","            switch value {","            case .string(let string): string","            case .int(let int): int","            case .double(let double): double","            case .bool(let bool): bool","            }","        })","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"An adapter is also free to remap ","type":"text"},{"type":"codeVoice","code":"event.name"},{"text":" to whatever vocabulary its backend expects — Firebase, for example, reserves a specific constant for screen views.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Wiring-a-screen","text":"Wiring a screen","type":"heading"},{"syntax":"swift","code":["let analytics = ScreenAnalyticsService(trackers: [FirebaseScreenTracker(), PrintScreenAnalyticsTracker()])","","func onAppear(source: ScreenOpenSource<AppScreen>) {","    analytics.trackScreenOpened(\"Articles\", source: source.analyticsKind)","    analytics.observeStateChanges(of: store, screen: \"Articles\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"trackScreenOpened(_:source:)"},{"text":" sends one ","type":"text"},{"type":"codeVoice","code":"screen_opened"},{"text":" event. ","type":"text"},{"type":"codeVoice","code":"observeStateChanges(of:screen:)"},{"text":" uses the same ","type":"text"},{"type":"codeVoice","code":"withObservationTracking"},{"text":" mechanism ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView"},{"text":" uses to mirror a store, and sends a ","type":"text"},{"type":"codeVoice","code":"screen_state_changed"},{"text":" event for every subsequent ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"text":" transition — call it once, right where you create or first observe the store. When a transition lands on ","type":"text"},{"type":"codeVoice","code":".error"},{"text":", the event also carries the error’s ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It also times how long the screen spends in ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":": the moment the state leaves ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":" for ","type":"text"},{"type":"codeVoice","code":".data"},{"text":", ","type":"text"},{"type":"codeVoice","code":".empty"},{"text":", or ","type":"text"},{"type":"codeVoice","code":".error"},{"text":", it sends a ","type":"text"},{"type":"codeVoice","code":"screen_load_duration"},{"text":" event (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenLoadDuration(screen:outcome:milliseconds:)"},{"text":") with that outcome and the elapsed time in ","type":"text"},{"type":"codeVoice","code":"duration_ms"},{"text":" — useful for a “how long do loads actually take, and how often do they end in an error” dashboard without hand-rolling a stopwatch around every ","type":"text"},{"type":"codeVoice","code":"load(_:)"},{"text":" call.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"screen_state_changed"},{"text":" event landing on ","type":"text"},{"type":"codeVoice","code":".error"},{"text":" tells you a screen failed to load; it doesn’t tell you whether the user gave up or hit Retry. Call ","type":"text"},{"type":"codeVoice","code":"trackRetryTapped(_:)"},{"text":" (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenRetryTapped(screen:)"},{"text":") from the same ","type":"text"},{"type":"codeVoice","code":"onRetry"},{"text":" closure you pass to the Error placeholder, so that’s a distinct, countable event instead of indistinguishable from the screen’s initial ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ScreenStateView(store.state, onRetry: {","    analytics.trackRetryTapped(\"Articles\")","    Task { await store.load { try await api.fetchArticles() } }","}) { articles in","    ArticleList(articles)","}"],"type":"codeListing"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)"},{"text":" doesn’t move ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" off ","type":"text"},{"type":"codeVoice","code":".data"},{"text":" on either a success or a failure, so ","type":"text"},{"type":"codeVoice","code":"observeStateChanges(of:screen:)"},{"text":" has nothing to report for it — call ","type":"text"},{"type":"codeVoice","code":"trackNextPageLoaded(_:)"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"trackNextPageFailed(_:errorDescription:)"},{"text":" (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageLoaded(screen:)"},{"text":"\/","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageFailed(screen:errorDescription:)"},{"text":") from the same place you call ","type":"text"},{"type":"codeVoice","code":"loadNextPage(_:)"},{"text":", mirroring how ","type":"text"},{"type":"codeVoice","code":"trackRe