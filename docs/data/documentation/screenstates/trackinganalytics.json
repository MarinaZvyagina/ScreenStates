tates\/PrintScreenAnalyticsTracker","title":"PrintScreenAnalyticsTracker","abstract":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","type":"reference"},{"text":" that prints every event to the console —","type":"text"},{"text":" ","type":"text"},{"text":"useful for confirming events fire at the right moments during","type":"text"},{"text":" ","type":"text"},{"text":"development, without wiring up a real analytics backend.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PrintScreenAnalyticsTracker"}],"url":"\/documentation\/screenstates\/printscreenanalyticstracker","type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/NoOpScreenAnalyticsTracker":{"abstract":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker"},{"text":" that does nothing — a harmless placeholder","type":"text"},{"text":" ","type":"text"},{"text":"for tests, SwiftUI Previews, or a build configuration where you don’t","type":"text"},{"text":" ","type":"text"},{"text":"want to wire up a real analytics backend yet.","type":"text"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"NoOpScreenAnalyticsTracker","kind":"identifier"}],"url":"\/documentation\/screenstates\/noopscreenanalyticstracker","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoOpScreenAnalyticsTracker","kind":"identifier"}],"title":"NoOpScreenAnalyticsTracker"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenAnalyticsEvent/screenNextPageLoaded(screen:)":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageLoaded(screen:)","title":"screenNextPageLoaded(screen:)","url":"\/documentation\/screenstates\/screenanalyticsevent\/screennextpageloaded(screen:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"screenNextPageLoaded","kind":"identifier"},{"text":"(","kind":"text"},{"text":"screen","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") -> ","kind":"text"},{"text":"ScreenAnalyticsEvent","kind":"typeIdentifier","preciseIdentifier":"s:12ScreenStates0A14AnalyticsEventV"}],"type":"topic","kind":"symbol","abstract":[{"text":"The default event for a successful ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","type":"reference"},{"text":" ","type":"text"},{"text":"call — distinct from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenStateChanged(screen:from:to:errorDescription:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"since appending a page doesn’t change ","type":"text"},{"code":"state","type":"codeVoice"},{"text":"’s own","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/analyticsKind","type":"reference"},{"text":" the way a ","type":"text"},{"code":"load","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refresh","type":"codeVoice"},{"text":" transition","type":"text"},{"text":" ","type":"text"},{"text":"does. ScreenStates has no way to detect this on its own; call it","type":"text"},{"text":" ","type":"text"},{"text":"from the same place ","type":"text"},{"code":"loadNextPage(_:)","type":"codeVoice"},{"text":" is called.","type":"text"}],"role":"symbol"},"doc://screenstates.ScreenStates/docu