{"sections":[],"variants":[{"paths":["\/documentation\/screenstates\/trackinganalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"anchor":"Related-Documentation"},{"anchor":"Analytics","title":"Analytics","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"generated":true}],"metadata":{"roleHeading":"Article","title":"Tracking Screen Analytics","role":"article","modules":[{"name":"ScreenStates"}]},"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/TrackingAnalytics","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Send screen-opened and state-transition events to any analytics backend with "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","isActive":true},{"type":"text","text":"."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every screen that models its state with "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" already knows exactly when it was opened and when it moves between Empty, Loading, Data, and Error. "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","type":"reference","isActive":true},{"type":"text","text":" turns those moments into "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","type":"reference","isActive":true},{"type":"text","text":"s and fans them out to as many "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","type":"reference","isActive":true},{"type":"text","text":"s as you register — one per analytics backend (Firebase, Mixpanel, Amplitude, your own logging endpoint, a debug console print, …)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"ScreenStates ships no backend-specific tracker implementations, so the core module stays dependency-free — but it does include "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","type":"reference","isActive":true},{"type":"text","text":" (logs every event to the console) and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker","type":"reference","isActive":true},{"type":"text","text":" (silently discards everything), so you don’t have to hand-roll a console logger just to confirm events fire at the right moments. For a real backend, write one small adapter, converting the event’s backend-agnostic "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","type":"reference","isActive":true},{"type":"text","text":" parameters into that SDK’s own format:"}]},{"type":"codeListing","code":["struct FirebaseScreenTracker: ScreenAnalyticsTracker {","    func track(_ event: ScreenAnalyticsEvent) {","        Analytics.logEvent(event.name, parameters: event.parameters.mapValues { value in","            switch value {","            case .string(let string): string","            case .int(let int): int","            case .double(let double): double","            case .bool(let bool): bool","            }","        })","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An adapter is also free to remap "},{"code":"event.name","type":"codeVoice"},{"type":"text","text":" to whatever vocabulary its backend expects — Firebase, for example, reserves a specific constant for screen views."}]},{"type":"heading","level":2,"anchor":"Wiring-a-screen","text":"Wiring a screen"},{"type":"codeListing","code":["let analytics = ScreenAnalyticsService(trackers: [FirebaseScreenTracker(), PrintScreenAnalyticsTracker()])","","func onAppear(source: ScreenOpenSource<AppScreen>) {","    analytics.trackScreenOpened(\"Articles\", source: source.analyticsKind)","    analytics.observeStateChanges(of: store, screen: \"Articles\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"trackScreenOpened(_:source:)","type":"codeVoice"},{"type":"text","text":" sends one "},{"code":"screen_opened","type":"codeVoice"},{"type":"text","text":" event. "},{"code":"observeStateChanges(of:screen:)","type":"codeVoice"},{"type":"text","text":" uses the same "},{"code":"withObservationTracking","type":"codeVoice"},{"type":"text","text":" mechanism "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","type":"reference","isActive":true},{"type":"text","text":" uses to mirror a store, and sends a "},{"code":"screen_state_changed","type":"codeVoice"},{"type":"text","text":" event for every subsequent "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":" transition — call it once, right where you create or first observe the store. When a transition lands on "},{"code":".error","type":"codeVoice"},{"type":"text","text":", the event also carries the error’s "},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It also times how long the screen spends in "},{"code":".loading","type":"codeVoice"},{"type":"text","text":": the moment the state leaves "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" for "},{"code":".data","type":"codeVoice"},{"type":"text","text":", "},{"code":".empty","type":"codeVoice"},{"type":"text","text":", or "},{"code":".error","type":"codeVoice"},{"type":"text","text":", it sends a "},{"code":"screen_load_duration","type":"codeVoice"},{"type":"text","text":" event ("},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenLoadDuration(screen:outcome:milliseconds:)","type":"reference","isActive":true},{"type":"text","text":") with that outcome and the elapsed time in "},{"code":"duration_ms","type":"codeVoice"},{"type":"text","text":" — useful for a “how long do loads actually take, and how often do they end in an error” dashboard without hand-rolling a stopwatch around every "},{"code":"load(_:)","type":"codeVoice"},{"type":"text","text":" call."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"screen_state_changed","type":"codeVoice"},{"type":"text","text":" event landing on "},{"code":".error","type":"codeVoice"},{"type":"text","text":" tells you a screen failed to load; it doesn’t tell you whether the user gave up or hit Retry. Call "},{"code":"trackRetryTapped(_:)","type":"codeVoice"},{"type":"text","text":" ("},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenRetryTapped(screen:)","type":"reference","isActive":true},{"type":"text","text":") from the same "},{"code":"onRetry","type":"codeVoice"},{"type":"text","text":" closure you pass to the Error placeholder, so that’s a distinct, countable event instead of indistinguishable from the screen’s initial "},{"code":".loading","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["ScreenStateView(store.state, onRetry: {","    analytics.trackRetryTapped(\"Articles\")","    Task { await store.load { try await api.fetchArticles() } }","}) { articles in","    ArticleList(articles)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","type":"reference","isActive":true},{"type":"text","text":" doesn’t move "},{"code":"state","type":"codeVoice"},{"type":"text","text":" off "},{"code":".data","type":"codeVoice"},{"type":"text","text":" on either a success or a failure, so "},{"code":"observeStateChanges(of:screen:)","type":"codeVoice"},{"type":"text","text":" has nothing to report for it — call "},{"code":"trackNextPageLoaded(_:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"trackNextPageFailed(_:errorDescription:)","type":"codeVoice"},{"type":"text","text":" ("},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageLoaded(screen:)","type":"reference","isActive":true},{"type":"text","text":"\/"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageFailed(screen:errorDescription:)","type":"reference","isActive":true},{"type":"text","text":") from the same place you call "},{"code":"loadNextPage(_:)","type":"codeVoice"},{"type":"text","text":", mirroring how "},{"code":"trackRetryTapped(_:)","type":"codeVoice"},{"type":"text","text":" is called from "},{"code":"onRetry","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["func loadMore() async {","    await store.loadNextPage { try await api.fetchArticles(page: nextPage) }","    if let error = store.loadNextPageError {","        analytics.trackNextPageFailed(\"Articles\", errorDescription: error.localizedDescription)","    } else {","        analytics.trackNextPageLoaded(\"Articles\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenOpenSource","type":"reference","isActive":true},{"type":"text","text":" expose an "},{"code":"analyticsKind","type":"codeVoice"},{"type":"text","text":" helper — a short, stable, payload-free name for the current case ("},{"code":"\"loading\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"error\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"push\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"deep_link\"","type":"codeVoice"},{"type":"text","text":", …) — so you can build custom "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","type":"reference","isActive":true},{"type":"text","text":"s yourself for anything the built-in factories don’t cover."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/loadNextPage(_:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loadNextPage","kind":"identifier"},{"text":"(","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text