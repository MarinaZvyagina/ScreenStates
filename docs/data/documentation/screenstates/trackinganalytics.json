s initial open. Call it","type":"text"},{"text":" ","type":"text"},{"text":"from the same ","type":"text"},{"code":"onRetry","type":"codeVoice"},{"text":" closure passed to the Error placeholder;","type":"text"},{"text":" ","type":"text"},{"text":"ScreenStates has no way to detect a retry tap on its own, since the","type":"text"},{"text":" ","type":"text"},{"text":"default placeholders know nothing about analytics.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/loadNextPageError":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError","title":"loadNextPageError","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The error from the most recently failed "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"mirroring "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshError","type":"reference"},{"type":"text","text":". "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is left untouched by a failed"},{"type":"text","text":" "},{"type":"text","text":"page fetch — the pages already loaded stay on screen — so this is"},{"type":"text","text":" "},{"type":"text","text":"the only way to learn a page fetch failed. Cleared at the start of"},{"type":"text","text":" "},{"type":"text","text":"the next "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" call."}],"url":"\/documentation\/screenstates\/screenstatestore\/loadnextpageerror","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loadNextPageError","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"