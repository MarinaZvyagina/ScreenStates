xt":" is called from "},{"code":"onRetry","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["func loadMore() async {","    await store.loadNextPage { try await api.fetchArticles(page: nextPage) }","    if let error = store.loadNextPageError {","        analytics.trackNextPageFailed(\"Articles\", errorDescription: error.localizedDescription)","    } else {","        analytics.trackNextPageLoaded(\"Articles\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenOpenSource","type":"reference","isActive":true},{"type":"text","text":" expose an "},{"type":"codeVoice","code":"analyticsKind"},{"type":"text","text":" helper — a short, stable, payload-free name for the current case ("},{"type":"codeVoice","code":"\"loading\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"error\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"push\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"deep_link\""},{"type":"text","text":", …) — so you can build custom "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","type":"reference","isActive":true},{"type":"text","text":"s yourself for anything the built-in factories don’t cover."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState/analyticsKind":{"url":"\/documentation\/screenstates\/screenstate\/analyticskind","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"analyticsKind","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"Str