{"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"title":"Related Documentation"},{"generated":true,"anchor":"Analytics","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"title":"Analytics"}],"variants":[{"paths":["\/documentation\/screenstates\/trackinganalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/TrackingAnalytics","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"Send screen-opened and state-transition events to any analytics backend with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService"},{"type":"text","text":"."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Article","title":"Tracking Screen Analytics","modules":[{"name":"ScreenStates"}],"role":"article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every screen that models its state with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" already knows exactly when it was opened and when it moves between Empty, Loading, Data, and Error. ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","isActive":true,"type":"reference"},{"text":" turns those moments into ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","isActive":true,"type":"reference"},{"text":"s and fans them out to as many ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","isActive":true,"type":"reference"},{"text":"s as you register — one per analytics backend (Firebase, Mixpanel, Amplitude, your own logging endpoint, a debug console print, …).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"ScreenStates ships no backend-specific tracker implementations, so the core module stays dependency-free — but it does include ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","isActive":true,"type":"reference"},{"text":" (logs every event to the console) and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker","isActive":true,"type":"reference"},{"text":" (silently discards everything), so you don’t have to hand-roll a console logger just to confirm events fire at the right moments. For a real backend, write one small adapter, converting the event’s backend-agnostic ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","isActive":true,"type":"reference"},{"text":" parameters into that SDK’s own format:","type":"text"}]},{"code":["struct FirebaseScreenTracker: ScreenAnalyticsTracker {","    func track(_ event: ScreenAnalyticsEvent) {","        Analytics.logEvent(event.name, parameters: event.parameters.mapValues { value in","            switch value {","            case .string(let string): string","            case .int(let int): int","            case .double(let double): double","            case .bool(let bool): bool","            }","        })","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"An adapter is also free to remap ","type":"text"},{"code":"event.name","type":"codeVoice"},{"text":" to whatever vocabulary its backend expects — Firebase, for example, reserves a specific constant for screen views.","type":"text"}]},{"level":2,"anchor":"Wiring-a-screen","type":"heading","text":"Wiring a screen"},{"code":["let analytics = ScreenAnalyticsService(trackers: [FirebaseScreenTracker(), PrintScreenAnalyticsTracker()])","","func onAppear(source: ScreenOpenSource<AppScreen>) {","    analytics.trackScreenOpened(\"Articles\", source: source.analyticsKind)","    analytics.observeStateChanges(of: store, screen: \"Articles\")","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"trackScreenOpened(_:source:)","type":"codeVoice"},{"text":" sends one ","type":"text"},{"code":"screen_opened","type":"codeVoice"},{"text":" event. ","type":"text"},{"code":"observeStateChanges(of:screen:)","type":"codeVoice"},{"text":" uses the same ","type":"text"},{"code":"withObservationTracking","type":"codeVoice"},{"text":" mechanism ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","isActive":true,"type":"reference"},{"text":" uses to mirror a store, and sends a ","type":"text"},{"code":"screen_state_changed","type":"codeVoice"},{"text":" event for every subsequent ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":" transition — call it once, right where you create or first observe the store. When a transition lands on ","type":"text"},{"code":".error","type":"codeVoice"},{"text":", the event also carries the error’s ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It also times how long the screen spends in ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":": the moment the state leaves ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".data","type":"codeVoice"},{"text":", ","type":"text"},{"code":".empty","type":"codeVoice"},{"text":", or ","type":"text"},{"code":".error","type":"codeVoice"},{"text":", it sends a ","type":"text"},{"code":"screen_load_duration","type":"codeVoice"},{"text":" event (","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenLoadDuration(screen:outcome:milliseconds:)","isActive":true,"type":"reference"},{"text":") with that outcome and the elapsed time in ","type":"text"},{"code":"duration_ms","type":"codeVoice"},{"text":" — useful for a “how long do loads actually take, and how often do they end in an error” dashboard without hand-rolling a stopwatch around every ","type":"text"},{"code":"load(_:)","type":"codeVoice"},{"text":" call.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"screen_state_changed","type":"codeVoice"},{"text":" event landing on ","type":"text"},{"code":".error","type":"codeVoice"},{"text":" tells you a screen failed to load; it doesn’t tell you whether the user gave up or hit Retry. Call ","type":"text"},{"code":"trackRetryTapped(_:)","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenRetryTapped(screen:)","isActive":true,"type":"reference"},{"text":") from the same ","type":"text"},{"code":"onRetry","type":"codeVoice"},{"text":" closure you pass to the Error placeholder, so that’s a distinct, countable event instead of indistinguishable from the screen’s initial ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["ScreenStateView(store.state, onRetry: {","    analytics.trackRetryTapped(\"Articles\")","    Task { await store.load { try await api.fetchArticles() } }","}) { articles in","    ArticleList(articles)","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","isActive":true,"type":"reference"},{"text":" doesn’t move ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" off ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" on either a success or a failure, so ","type":"text"},{"code":"observeStateChanges(of:screen:)","type":"codeVoice"},{"text":" has nothing to report for it — call ","type":"text"},{"code":"trackNextPageLoaded(_:)","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"trackNextPageFailed(_:errorDescription:)","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageLoaded(screen:)","isActive":true,"type":"reference"},{"text":"\/","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageFailed(screen:errorDescription:)","isActive":true,"type":"reference"},{"text":") from the same place you call ","type":"text"},{"code":"loadNextPage(_:)","type":"codeVoice"},{"text":", mirroring how ","type":"text"},{"code":"trackRetryTapped(_:)","type":"codeVoice"},{"text":" is called from ","type":"text"},{"code":"onRetry","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["func loadMore() async {","    await store.loadNextPage { try await api.fetchArticles(page: nextPage) }","    if let error = store.loadNextPageError {","        analytics.trackNextPageFailed(\"Articles\", errorDescription: error.localizedDescription)","    } else {","        analytics.trackNextPageLoaded(\"Articles\")","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Both ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenOpenSource","isActive":true,"type":"reference"},{"text":" expose an ","type":"text"},{"code":"analyticsKind","type":"codeVoice"},{"text":" helper — a short, stable, payload-free name for the current case (","type":"text"},{"code":"\"loading\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"error\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"push\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"deep_link\"","type":"codeVoice"},{"text":", …) — so you can build custom ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","isActive":true,"type":"reference"},{"text":"s yourself for anything the built-in factories don’t cover.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenAnalyticsEvent/screenStateChanged(screen:from:to:errorDescription:)":{"type":"topic","title":"screenStateChanged(screen:from:to:errorDescription:)","url":"\/documentation\/screenstates\/screenanalyticsevent\/screenstatechanged(screen:from:to:errordescription:)","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/S