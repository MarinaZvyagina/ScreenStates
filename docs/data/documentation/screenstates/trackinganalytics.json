nStates\/ScreenAnalyticsTracker","isActive":true},{"type":"text","text":" that prints every event to the console —"},{"type":"text","text":" "},{"type":"text","text":"useful for confirming events fire at the right moments during"},{"type":"text","text":" "},{"type":"text","text":"development, without wiring up a real analytics backend."}],"role":"symbol","kind":"symbol","title":"PrintScreenAnalyticsTracker","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"PrintScreenAnalyticsTracker","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","navigatorTitle":[{"text":"PrintScreenAnalyticsTracker","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"abstract":[{"type":"text","text":"Renders the right content for a "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"type":"text","text":"Empty \/ Loading \/ Data \/ Error automatically."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ScreenStateView"}],"kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","url":"\/documentation\/screenstates\/screenstateview","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateView"}],"title":"ScreenStateView"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenAnalyticsEvent/screenNextPageLoaded(screen:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"screenNextPageLoaded","kind":"identifier"},{"text":"(","kind":"text"},{"text":"screen","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":