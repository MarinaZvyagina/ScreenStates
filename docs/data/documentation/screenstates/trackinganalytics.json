{"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/TrackingAnalytics","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/trackinganalytics"]}],"kind":"article","metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"ScreenStates"}],"title":"Tracking Screen Analytics"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"anchor":"Related-Documentation"},{"title":"Analytics","generated":true,"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"anchor":"Analytics"}],"sections":[],"abstract":[{"type":"text","text":"Send screen-opened and state-transition events to any analytics backend with "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","type":"reference"},{"type":"text","text":"."}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Every screen that models its state with ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"text":" already knows exactly when it was opened and when it moves between Empty, Loading, Data, and Error. ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","isActive":true},{"text":" turns those moments into ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","isActive":true},{"text":"s and fans them out to as many ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","isActive":true},{"text":"s as you register — one per analytics backend (Firebase, Mixpanel, Amplitude, your own logging endpoint, a debug console print, …).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"ScreenStates ships no backend-specific tracker implementations, so the core module stays dependency-free — but it does include ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","isActive":true},{"text":" (logs every event to the console) and ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker","isActive":true},{"text":" (silently discards everything), so you don’t have to hand-roll a console logger just to confirm events fire at the right moments. For a real backend, write one small adapter, converting the event’s backend-agnostic ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","isActive":true},{"text":" parameters into that SDK’s own format:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct FirebaseScreenTracker: ScreenAnalyticsTracker {","    func track(_ event: ScreenAnalyticsEvent) {","        Analytics.logEvent(event.name, parameters: event.parameters.mapValues { value in","            switch value {","            case .string(let string): string","            case .int(let int): int","            case .double(let double): double","            case .bool(let bool): bool","            }","        })","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"An adapter is also free to remap ","type":"text"},{"type":"codeVoice","code":"event.name"},{"text":" to whatever vocabulary its backend expects — Firebase, for example, reserves a specific constant for screen views.","type":"text"}],"type":"paragraph"},{"anchor":"Wiring-a-screen","level":2,"type":"heading","text":"Wiring a screen"},{"syntax":"swift","code":["let analytics = ScreenAnalyticsService(trackers: [FirebaseScreenTracker(), PrintScreenAnalyticsTracker()])","","func onAppear(source: ScreenOpenSource<AppScreen>) {","    analytics.trackScreenOpened(\"Articles\", source: source.analyticsKind)","    analytics.observeStateChanges(of: store, screen: \"Articles\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"trackScreenOpened(_:source:)"},{"text":" sends one ","type":"text"},{"type":"codeVoice","code":"screen_opened"},{"text":" event. ","type":"text"},{"type":"codeVoice","code":"observeStateChanges(of:screen:)"},{"text":" uses the same ","type":"text"},{"type":"codeVoice","code":"withObservationTracking"},{"text":" mechanism ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","isActive":true},{"text":" uses to mirror a store, and sends a ","type":"text"},{"type":"codeVoice","code":"screen_state_changed"},{"text":" event for every subsequent ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"text":" transition — call it once, right where you create or first observe the store. When a transition lands on ","type":"text"},{"type":"codeVoice","code":".error"},{"text":", the event also carries the error’s ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It also times how long the screen spends in ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":": the moment the state leaves ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":" for ","type":"text"},{"type":"codeVoice","code":".data"},{"text":", ","type":"text"},{"type":"codeVoice","code":".empty"},{"text":", or ","type":"text"},{"type":"codeVoice","code":".error"},{"text":", it sends a ","type":"text"},{"type":"codeVoice","code":"screen_load_duration"},{"text":" event (","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenLoadDuration(screen:outcome:milliseconds:)","isActive":true},{"text":") with that outcome and the elapsed time in ","type":"text"},{"type":"codeVoice","code":"duration_ms"},{"text":" — useful for a “how long do loads actually take, and how often do they end in an error” dashboard without hand-rolling a stopwatch around every ","type":"text"},{"type":"codeVoice","code":"load(_:)"},{"text":" call.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"screen_state_changed"},{"text":" event landing on ","type":"text"},{"type":"codeVoice","code":".error"},{"text":" tells you a screen failed to load; it doesn’t tell you whether the user gave up or hit Retry. Call ","type":"text"},{"type":"codeVoice","code":"trackRetryTapped(_:)"},{"text":" (","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenRetryTapped(screen:)","isActive":true},{"text":") from the same ","type":"text"},{"type":"codeVoice","code":"onRetry"},{"text":" closure you pass to the Error placeholder, so that’s a distinct, countable event instead of indistinguishable from the screen’s initial ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ScreenStateView(store.state, onRetry: {","    analytics.trackRetryTapped(\"Articles\")","    Task { await store.load { try await api.fetchArticles() } }","}) { articles in","    ArticleList(articles)","}"],"type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","isActive":true},{"text":" doesn’t move ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" off ","type":"text"},{"type":"codeVoice","code":".data"},{"text":" on either a success or a failure, so ","type":"text"},{"type":"codeVoice","code":"observeStateChanges(of:screen:)"},{"text":" has nothing to report for it — call ","type":"text"},{"type":"codeVoice","code":"trackNextPageLoaded(_:)"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"trackNextPageFailed(_:errorDescription:)"},{"text":" (","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageLoaded(screen:)","isActive":true},{"text":"\/","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageFailed(screen:errorDescription:)","isActive":true},{"text":") from the same place you call ","type":"text"},{"type":"codeVoice","code":"loadNextPage(_:)"},{"text":", mirroring how ","type":"text"},{"type":"codeVoice","code":"trackRetryTapped(_:)"},{"text":" is called from ","type":"text"},{"type":"codeVoice","code":"onRetry"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func loadMore() async {","    await store.loadNextPage { try await api.fetchArticles(page: nextPage) }","    if let error = store.loadNextPageError {","        analytics.trackNextPageFailed(\"Articles\", errorDescription: error.localizedDescription)","    } else {","        analytics.trackNextPageLoaded(\"Articles\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Both ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenOpenSource","isActive":true},{"text":" expose an ","type":"text"},{"type":"codeVoice","code":"analyticsKind"},{"text":" helper — a short, stable, payload-free name for the current case (","type":"text"},{"type":"codeVoice","code":"\"loading\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"error\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"push\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"deep_link\""},{"text":", …) — so you can build custom ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","isActive":true},{"text":"s yourself for anything the built-in factories don’t cover.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/loadNextPage(_:)":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Fetches another page with "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" and appends it to the"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"type":"codeVoice","code":".data"},{"type":"text","text":" collection instead of replacing "},{"type":"codeVoice","code":"state"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"pagination counterpart of "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refresh(_:)","type":"reference"},{"type":"text","text":" keeping data on screen"},{"type":"text","text":" "},{"type":"text","text":"while a background fetch runs. "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isLoadingNextPage","type":"reference"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the duration. On failure "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is left alone and the error is"},{"type":"text","text":" "},{"type":"text","text":"reported via "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError","type":"reference"},{"type":"text","text":" instead, so the pages already"},{"type":"text","text":" "},{"type":"text","text":"loaded aren’t discarded just because the next one failed. Guarded"},{"type":"text","text":" "},{"type":"text","text":"against the same overlapping-call race as "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":": if a"},{"type":"text","text":" "},{"type":"text","text":"second "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" (or any other "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"-family"},{"type":"text","text":" "},{"type":"text","text":"call) starts before this one’s "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" resolves, this call’s"},{"type":"text","text":" "},{"type":"text","text":"result is silently dropped instead of applied."}],"url":"\/documentation\/screenstates\/screenstatestore\/loadnextpage(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loadNextPage"},{"kind":"text","text":"("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12ScreenStates0A10StateStoreCAASmRzlE5Valuexmfp","kind":"typeIdentifier","text":"Value"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"title":"loadNextPage(_:)"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenAnalyticsEvent/screenNextPageLoaded(screen:)":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageLoaded(screen:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The default event for a successful "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"call — distinct from "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenStateChanged(screen:from:to:errorDescription:)","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"since appending a page doesn’t change "},{"type":"codeVoice","code":"state"},{"type":"text","text":"’s own"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/analyticsKind","type":"reference"},{"type":"text","text":" the way a "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" transition"},{"type":"text","text":" "},{"type":"text","text":"does. ScreenStates has no way to detect this on its own; call it"},{"type":"text","text":" "},{"type":"text","text":"from the same place "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" is called."}],"url":"\/documentation\/screenstates\/screenanalyticsevent\/screennextpageloaded(screen:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"screenNextPageLoaded"},{"kind":"text","text":"("},{"kind":"externalParam","text":"screen"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12ScreenStates0A14AnalyticsEventV","kind":"typeIdentifier","text":"ScreenAnalyticsEvent"}],"title":"screenNextPageLoaded(screen:)"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenOpenSource":{"navigatorTitle":[{"kind":"identifier","text":"ScreenOpenSource"}],"abstract":[{"type":"text","text":"How a screen came to be visible: freshly pushed, revealed by popping a"},{"type":"text","text":" "},{"type":"text","text":"later screen off a navigation stack, presented modally, or opened from"},{"type":"text","text":" "},{"type":"text","text":"outside the app entirely."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenOpenSource","type":"topic","title":"ScreenOpenSource","url":"\/documentation\/screenstates\/screenopensource","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenOpenSource"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenAnalyticsEvent/screenStateChanged(screen:from:to:errorDescription:)":{"kind":"symbol","url":"\/documenta