ation. On failure "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is left alone and the error is"},{"type":"text","text":" "},{"type":"text","text":"reported via "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError","type":"reference"},{"type":"text","text":" instead, so the pages already"},{"type":"text","text":" "},{"type":"text","text":"loaded aren’t discarded just because the next one failed. Guarded"},{"type":"text","text":" "},{"type":"text","text":"against the same overlapping-call race as "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":": if a"},{"type":"text","text":" "},{"type":"text","text":"second "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":" (or any other "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":"-family"},{"type":"text","text":" "},{"type":"text","text":"call) starts before this one’s "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" resolves, this call’s"},{"type":"text","text":" "},{"type":"text","text":"result is silently dropped instead of applied."}],"title":"loadNextPage(_:)","role":"symbol","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenAnalyticsEvent":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","title":"ScreenAnalyticsEvent","role":"symbol","url":"\/documentation\/screenstates\/screenanalyticsevent","kind":"symbol","navigatorTitle":[{"text":"ScreenAnalyticsEvent","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenAnalyticsEvent","kind":"identifier"}],"type":"topic","abstract":[{"type"