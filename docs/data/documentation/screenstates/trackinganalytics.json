text":" is called."}],"url":"\/documentation\/screenstates\/screenanalyticsevent\/screennextpageloaded(screen:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"screenNextPageLoaded"},{"kind":"text","text":"("},{"kind":"externalParam","text":"screen"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12ScreenStates0A14AnalyticsEventV","kind":"typeIdentifier","text":"ScreenAnalyticsEvent"}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/AnalyticsValue":{"abstract":[{"text":"A value in a ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","isActive":true,"type":"reference"},{"text":"’s parameters, restricted to the","type":"text"},{"text":" ","type":"text"},{"text":"primitive types every analytics SDK accepts, so a ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"can convert it to its own format (a Firebase ","type":"text"},{"code":"[String: Any]","type":"codeVoice"},{"text":", a Mixpanel","type":"text"},{"text":" ","type":"text"},{"code":"[String: MixpanelType]","type":"codeVoice"},{"text":", a plain JSON payload, …) without guesswork.","type":"text"}],"role":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","type":"topic","title":"AnalyticsValue","url":"\/documentation\/screenstates\/analyticsvalue","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnalyticsValue"}],"navigatorTitle":[{"text":"AnalyticsValue","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/isLoadingNextPage":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isLoadingNextPage","title":"isLoadingNextPage","kind":"symbol","type":"topic","abstract":[{"type":"codeVoice","code":"true"},{"type":"text","text":" while "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","type":"reference"},{"type":"text","text":" is fetching another page in the"},{"type":"text","text":" "},{"type":"text","text":"background, with the existing pages still shown in "},{"type":"codeVoice","code":"state"},{"type":"text","text":"."}],"url":"\/documentation\/screenstates\/screenstatestore\/isloadingnextpage","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isLoadingNextPage","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState/analyticsKind":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/analyticsKind","title":"analyticsKind","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A short, stable, analytics-friendly name for the case, ignoring any"},{"type":"text","text":" "},{"type":"text","text":"payload — "},{"code":"\"empty\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"loading\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"data\"","type":"codeVoice"},{"type":"text","text":", or "},{"code":"\"error\"","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/screenstates\/screenstate\/analyticskind","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"analyticsKind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/refresh(_:)":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refresh(_:)","title":"refresh(_:)","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Like "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/load(_:)","type":"reference"},{"type":"text","text":", but keeps any data already in "},{"type":"codeVoice","code":"state"},{"type":"text","text":" on screen"},{"type":"text","text":" "},{"type":"text","text":"while "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" runs instead of switching to "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"pattern behind pull-to-refresh, where the list shouldn’t disappear"},{"type":"text","text":" "},{"type":"text","text":"while it’s being refetched. "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isRefreshing","type":"reference"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"duration. On success "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is replaced as usual; on failure "},{"type":"codeVoice","code":"state"},{"type":"text","text":" "},{"type":"text","text":"is left alone and the error is reported via "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshError","type":"reference"},{"type":"text","text":" instead."}],"url":"\/documentation\/screenstates\/screenstatestore\/refresh(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refresh","kind":"identifier"},{"text":"(","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"