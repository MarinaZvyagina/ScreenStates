{"metadata":{"modules":[{"name":"ScreenStates"}],"role":"article","title":"Tracking Screen Analytics","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/TrackingAnalytics"},"abstract":[{"type":"text","text":"Send screen-opened and state-transition events to any analytics backend with "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","isActive":true},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/trackinganalytics"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"]},{"anchor":"Analytics","generated":true,"title":"Analytics","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every screen that models its state with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference"},{"text":" already knows exactly when it was opened and when it moves between Empty, Loading, Data, and Error. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","type":"reference"},{"text":" turns those moments into ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","type":"reference"},{"text":"s and fans them out to as many ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","type":"reference"},{"text":"s as you register — one per analytics backend (Firebase, Mixpanel, Amplitude, your own logging endpoint, a debug console print, …).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"ScreenStates ships no backend-specific tracker implementations, so the core module stays dependency-free — but it does include ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","type":"reference"},{"text":" (logs every event to the console) and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker","type":"reference"},{"text":" (silently discards everything), so you don’t have to hand-roll a console logger just to confirm events fire at the right moments. For a real backend, write one small adapter, converting the event’s backend-agnostic ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","type":"reference"},{"text":" parameters into that SDK’s own format:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct FirebaseScreenTracker: ScreenAnalyticsTracker {","    func track(_ event: ScreenAnalyticsEvent) {","        Analytics.logEvent(event.name, parameters: event.parameters.mapValues { value in","            switch value {","            case .string(let string): string","            case .int(let int): int","            case .double(let double): double","            case .bool(let bool): bool","            }","        })","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"An adapter is also free to remap ","type":"text"},{"code":"event.name","type":"codeVoice"},{"text":" to whatever vocabulary its backend expects — Firebase, for example, reserves a specific constant for screen views.","type":"text"}]},{"level":2,"type":"heading","anchor":"Wiring-a-screen","text":"Wiring a screen"},{"type":"codeListing","syntax":"swift","code":["let analytics = ScreenAnalyticsService(trackers: [FirebaseScreenTracker(), PrintScreenAnalyticsTracker()])","","func onAppear(source: ScreenOpenSource<AppScreen>) {","    analytics.trackScreenOpened(\"Articles\", source: source.analyticsKind)","    analytics.observeStateChanges(of: store, screen: \"Articles\")","}"]},{"type":"paragraph","inlineContent":[{"code":"trackScreenOpened(_:source:)","type":"codeVoice"},{"text":" sends one ","type":"text"},{"code":"screen_opened","type":"codeVoice"},{"text":" event. ","type":"text"},{"code":"observeStateChanges(of:screen:)","type":"codeVoice"},{"text":" uses the same ","type":"text"},{"code":"withObservationTracking","type":"codeVoice"},{"text":" mechanism ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","type":"reference"},{"text":" uses to mirror a store, and sends a ","type":"text"},{"code":"screen_state_changed","type":"codeVoice"},{"text":" event for every subsequent ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference"},{"text":" transition — call it once, right where you create or first observe the store. When a transition lands on ","type":"text"},{"code":".error","type":"codeVoice"},{"text":", the event also carries the error’s ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It also times how long the screen spends in ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":": the moment the state leaves ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".data","type":"codeVoice"},{"text":", ","type":"text"},{"code":".empty","type":"codeVoice"},{"type":"text","text":", or "},{"type":"codeVoice","code":".error"},{"type":"text","text":", it sends a "},{"type":"codeVoice","code":"screen_load_duration"},{"type":"text","text":" event ("},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenLoadDuration(screen:outcome:milliseconds:)","type":"reference","isActive":true},{"type":"text","text":") with that outcome and the elapsed time in "},{"type":"codeVoice","code":"duration_ms"},{"type":"text","text":" — useful for a “how long do loads actually take, and how often do they end in an error” dashboard without hand-rolling a stopwatch around every "},{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":" call."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"screen_state_changed"},{"type":"text","text":" event landing on "},{"type":"codeVoice","code":".error"},{"type":"text","text":" tells you a screen failed to load; it doesn’t tell you whether the user gave up or hit Retry. Call "},{"type":"codeVoice","code":"trackRetryTapped(_:)"},{"type":"text","text":" ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenRetryTapped(screen:)"},{"type":"text","text":") from the same "},{"type":"codeVoice","code":"onRetry"},{"type":"text","text":" closure you pass to the Error placeholder, so that’s a distinct, countable event instead of indistinguishable from the screen’s initial "},{"type":"codeVoice","code":".loading"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["ScreenStateView(store.state, onRetry: {","    analytics.trackRetryTapped(\"Articles\")","    Task { await store.load { try await api.fetchArticles() } }","}) { articles in","    ArticleList(articles)","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)","isActive":true,"type":"reference"},{"type":"text","text":" doesn’t move "},{"type":"codeVoice","code":"state"},{"type":"text","text":" off "},{"type":"codeVoice","code":".data"},{"type":"text","text":" on either a success or a failure, so "},{"type":"codeVoice","code":"observeStateChanges(of:screen:)"},{"type":"text","text":" has nothing to report for it — call "},{"type":"codeVoice","code":"trackNextPageLoaded(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"trackNextPageFailed(_:errorDescription:)"},{"type":"text","text":" ("},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageLoaded(screen:)","isActive":true,"type":"reference"},{"type":"text","text":"\/"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageFailed(screen:errorDescription:)","isActive":true,"type":"reference"},{"type":"text","text":") from the same place you call "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":", mirroring how "},{"type":"codeVoice","code":"trackRetryTapped(_:)"},{"type":"text","text":" is called from "},{"type":"codeVoice","code":"onRetry"},{"type":"text","text":":"}]},{"type":"codeListing","code":["func loadMore() async {","    await store.loadNextPage { try await api.fetchArticles(page: nextPage) }","    if let error = store.loadNextPageError {","        analytics.trackNextPageFailed(\"Articles\", errorDescription: error.localizedDescription)","    } else {","        analytics.trackNextPageLoaded(\"Articles\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenOpenSource","type":"reference","isActive":true},{"type":"text","text":" expose an "},{"type":"codeVoice","code":"analyticsKind"},{"type":"text","text":" helper — a short, stable, payload-free name for the current case ("},{"type":"codeVoice","code":"\"loading\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"error\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"push\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"deep_link\""},{"type":"text","text":", …) — so you can build custom "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","type":"reference","isActive":true},{"type":"text","text":"s yourself for anything the built-in factories don’t cover."}]}],"kind":"content"}],"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenAnalyticsEvent/screenRetryTapped(screen:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"screenRetryTapped"},{"kind":"text","text":"("},{"kind":"externalParam","text":"screen"},{"kind":"text","text":": "},{"p