,{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:12ScreenStates0A10StateStoreCAASmRzlE5Valuexmfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"abstract":[{"type":"text","text":"Fetches another page with "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" and appends it to the"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"type":"codeVoice","code":".data"},{"type":"text","text":" collection instead of replacing "},{"type":"codeVoice","code":"state"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"pagination counterpart of "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refresh(_:)","type":"reference","isActive":true},{"type":"text","text":" keeping data on screen"},{"type":"text","text":" "},{"type":"text","text":"while a background fetch runs. "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isLoadingNextPage","type":"reference","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the duration. On failure "},{"type":"codeVoice","code":"state"},{"type":"text","text":" is left alone and the error is"},{"type":"text","text":" "},{"type":"text","text":"reported via "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError","type":"reference","isActive":true},{"type":"text","text":" instead, so the pages already"},{"type":"text","text":" "},{"type":"text","text":"loaded aren’t discarded just because the next one failed. Guarded"},{"type":"text","text":" "},{"type":"text","text":"against the same overlapping-call race as "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":": if a"},{"type":"text","text