{"seeAlsoSections":[{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"],"anchor":"Analytics","generated":true,"title":"Analytics"}],"variants":[{"paths":["\/documentation\/screenstates\/trackinganalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/TrackingAnalytics"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every screen that models its state with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" already knows exactly when it was opened and when it moves between Empty, Loading, Data, and Error. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService"},{"type":"text","text":" turns those moments into "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent"},{"type":"text","text":"s and fans them out to as many "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsTracker"},{"type":"text","text":"s as you register — one per analytics backend (Firebase, Mixpanel, Amplitude, your own logging endpoint, a debug console print, …)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"ScreenStates ships no backend-specific tracker implementations, so the core module stays dependency-free — but it does include "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/PrintScreenAnalyticsTracker"},{"type":"text","text":" (logs every event to the console) and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/NoOpScreenAnalyticsTracker"},{"type":"text","text":" (silently discards everything), so you don’t have to hand-roll a console logger just to confirm events fire at the right moments. For a real backend, write one small adapter, converting the event’s backend-agnostic "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/AnalyticsValue"},{"type":"text","text":" parameters into that SDK’s own format:"}]},{"type":"codeListing","syntax":"swift","code":["struct FirebaseScreenTracker: ScreenAnalyticsTracker {","    func track(_ event: ScreenAnalyticsEvent) {","        Analytics.logEvent(event.name, parameters: event.parameters.mapValues { value in","            switch value {","            case .string(let string): string","            case .int(let int): int","            case .double(let double): double","            case .bool(let bool): bool","            }","        })","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An adapter is also free to remap "},{"type":"codeVoice","code":"event.name"},{"type":"text","text":" to whatever vocabulary its backend expects — Firebase, for example, reserves a specific constant for screen views."}]},{"anchor":"Wiring-a-screen","type":"heading","level":2,"text":"Wiring a screen"},{"type":"codeListing","syntax":"swift","code":["let analytics = ScreenAnalyticsService(trackers: [FirebaseScreenTracker(), PrintScreenAnalyticsTracker()])","","func onAppear(source: ScreenOpenSource<AppScreen>) {","    analytics.trackScreenOpened(\"Articles\", source: source.analyticsKind)","    analytics.observeStateChanges(of: store, screen: \"Articles\")","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackScreenOpened(_:source:)"},{"type":"text","text":" sends one "},{"type":"codeVoice","code":"screen_opened"},{"type":"text","text":" event. "},{"type":"codeVoice","code":"observeStateChanges(of:screen:)"},{"type":"text","text":" uses the same "},{"type":"codeVoice","code":"withObservationTracking"},{"type":"text","text":" mechanism "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView"},{"type":"text","text":" uses to mirror a store, and sends a "},{"type":"codeVoice","code":"screen_state_changed"},{"type":"text","text":" event for every subsequent "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":" transition — call it once, right where you create or first observe the store. When a transition lands on "},{"type":"codeVoice","code":".error"},{"type":"text","text":", the event also carries the error’s "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It also times how long the screen spends in "},{"type":"codeVoice","code":".loading"},{"type":"text","text":": the moment the state leaves "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" for "},{"type":"codeVoice","code":".data"},{"type":"text","text":", "},{"type":"codeVoice","code":".empty"},{"type":"text","text":", or "},{"type":"codeVoice","code":".error"},{"type":"text","text":", it sends a "},{"type":"codeVoice","code":"screen_load_duration"},{"type":"text","text":" event ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenLoadDuration(screen:outcome:milliseconds:)"},{"type":"text","text":") with that outcome and the elapsed time in "},{"type":"codeVoice","code":"duration_ms"},{"type":"text","text":" — useful for a “how long do loads actually take, and how often do they end in an error” dashboard without hand-rolling a stopwatch around every "},{"type":"codeVoice","code":"load(_:)"},{"type":"text","text":" call."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"screen_state_changed"},{"type":"text","text":" event landing on "},{"type":"codeVoice","code":".error"},{"type":"text","text":" tells you a screen failed to load; it doesn’t tell you whether the user gave up or hit Retry. Call "},{"type":"codeVoice","code":"trackRetryTapped(_:)"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenRetryTapped(screen:)"},{"type":"text","text":") from the same "},{"type":"codeVoice","code":"onRetry"},{"type":"text","text":" closure you pass to the Error placeholder, so that’s a distinct, countable event instead of indistinguishable from the screen’s initial "},{"type":"codeVoice","code":".loading"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["ScreenStateView(store.state, onRetry: {","    analytics.trackRetryTapped(\"Articles\")","    Task { await store.load { try await api.fetchArticles() } }","}) { articles in","    ArticleList(articles)","}"]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)"},{"type":"text","text":" doesn’t move "},{"type":"codeVoice","code":"state"},{"type":"text","text":" off "},{"type":"codeVoice","code":".data"},{"type":"text","text":" on either a success or a failure, so "},{"type":"codeVoice","code":"observeStateChanges(of:screen:)"},{"type":"text","text":" has nothing to report for it — call "},{"type":"codeVoice","code":"trackNextPageLoaded(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"trackNextPageFailed(_:errorDescription:)"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageLoaded(screen:)"},{"type":"text","text":"\/"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent\/screenNextPageFailed(screen:errorDescription:)"},{"type":"text","text":") from the same place you call "},{"type":"codeVoice","code":"loadNextPage(_:)"},{"type":"text","text":", mirroring how "},{"type":"codeVoice","code":"trackRetryTapped(_:)"},{"type":"text","text":" is called from "},{"type":"codeVoice","code":"onRetry"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["func loadMore() async {","    await store.loadNextPage { try await api.fetchArticles(page: nextPage) }","    if let error = store.loadNextPageError {","        analytics.trackNextPageFailed(\"Articles\", errorDescription: error.localizedDescription)","    } else {","        analytics.trackNextPageLoaded(\"Articles\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenOpenSource"},{"type":"text","text":" expose an "},{"type":"codeVoice","code":"analyticsKind"},{"type":"text","text":" helper — a short, stable, payload-free name for the current case ("},{"type":"codeVoice","code":"\"loading\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"error\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"push\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"deep_link\""},{"type":"text","text":", …) — so you can build custom "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsEvent"},{"type":"text","text":"s yourself for anything the built-in factories don’t cover."}]}],"kind":"content"}],"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"ScreenStates"}],"title":"Tracking Screen Analytics","role":"article"},"abstract":[{"type":"text","text":"Send screen-opened and state-transition events to any analytics backend with "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenAnalyticsService","isActive":true},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/loadNextPageError":{"url":"\/documentation\/screenstates\/screenstatestore\/loadnextpageerror","title":"loadNextPageError","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loadNextPageError","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPageError","abstract":[{"text":"The error from the most recently failed ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadNextPage(_:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"mirroring ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refreshError"},{"text":". ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" is left untouched by a failed","type":"text"},{"text":" ","type":"text"},{"text":"page fetch — the pages already loaded stay on screen — so this is","type":"text"},{"text":" ","type":"text"},{"text":"the only way to learn a page fetch failed. Cleared at the start of","type":"text"},{"text":" ","type":"text"},{"text":"the next ","type":"text"},{"type":"codeVoice","code":"loadNextPage(_:)"},{"text":" call.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"url":"\/documentation\/screenstates\/screenstate","kind":"symbol","type":"topic","title":"ScreenState","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenState"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","navigatorTitle":[{"kind":"identifier","text":"ScreenState"}],"abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenOpenSource":{"url":"\/documentation\/screenstates\/screenopensource","title":"ScreenOpenSource","