operation"},{"type":"text","text":" resolves, this call’s"},{"type":"text","text":" "},{"type":"text","text":"result is silently dropped instead of applied."}],"type":"topic","url":"\/documentation\/screenstates\/screenstatestore\/loadnextpage(_:)","title":"loadNextPage(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"loadNextPage"},{"kind":"text","text":"("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12ScreenStates0A10StateStoreCAASmRzlE5Valuexmfp","kind":"typeIdentifier","text":"Value"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/refresh(_:)":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/refresh(_:)","type":"topic","abstract":[{"text":"Like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/load(_:)","type":"reference"},{"text":", but keeps any data already in ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" on screen","type":"text"},{"text":" ","type":"text"},{"text":"while ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" runs instead of switching to ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" — the","type":"text"},{"text":" ","type":"text"},{"text":"pattern behind pull-to-refresh, where the list shouldn’t disappear","type":"text"},{"text":" ","type":"text"},{"text":"while it’s being refetched. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/isRefreshing","type":"reference"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for the","ty