he view hierarchy."}],"url":"\/documentation\/screenstates\/screenstatesthemetrait","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStatesThemeTrait"}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateDefaultLoadingView":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateDefaultLoadingView"}],"navigatorTitle":[{"kind":"identifier","text":"ScreenStateDefaultLoadingView"}],"title":"ScreenStateDefaultLoadingView","url":"\/documentation\/screenstates\/screenstatedefaultloadingview","kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateDefaultLoadingView","role":"symbol","abstract":[{"text":"Default placeholder shown while a screen’s data is loading.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateShimmerLoadingView":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateShimmerLoadingView","kind":"identifier"}],"navigatorTitle":[{"text":"ScreenStateShimmerLoadingView","kind":"identifier"}],"title":"ScreenStateShimmerLoadingView","url":"\/documentation\/screenstates\/screenstateshimmerloadingview","kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateShimmerLoadingView","role":"symbol","abstract":[{"type":"text","text":"An alternative Loading placeholder: a pulsing skeleton of a circular"},{"type":"text","text":" "},{"type":"text","text":"avatar plus two text-line placeholders, instead of a spinner. Opt-in —"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateDefaultLoadingView"},{"type":"text","text":" is still what every default-wired"},{"type":"text","text":" "},{"type":"codeVoice","code":"Scree