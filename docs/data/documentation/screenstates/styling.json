\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateDefaultLoadingUIView"},{"type":"text","text":" — the spinner — are what every default-wired "},{"type":"codeVoice","code":"ScreenStateView"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"ScreenStateContainerView"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"ScreenStateViewController"},{"type":"text","text":" shows. Two opt-in alternatives cover the other common shapes a loading state takes:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateShimmerLoadingView","isActive":true},{"type":"text","text":"\/"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateShimmerLoadingUIView","isActive":true},{"type":"text","text":": a pulsing skeleton of a circular avatar plus two text-line placeholders, for a generic “something’s coming” look that doesn’t need to know the real content’s shape."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateRedactedLoadingView","isActive":true},{"type":"text","text":": renders your real content view through SwiftUI’s "},{"type":"codeVoice","code":".redacted(reason: .placeholder)"},{"type":"text","text":", so the placeholder mirrors the exact shape of the content it’s standing in for. SwiftUI-only — "},{"type":"codeVoice","code":"redacted(reason:)"},{"type":"text","text":" has no UIKit equivalent."}]}]}]},{"type":"codeListing","code":["ScreenStateShimmerLoadingView()","","ScreenStateRedactedLoadingView {","    ArticleRow(article: .placeholder)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both respect Reduce Motion and Increase Contrast the same way the default spinner does; see "},{"type":"reference","isActiv