er takes a "},{"type":"codeVoice","code":"style:"},{"type":"text","text":" parameter, defaulting to "},{"type":"codeVoice","code":".standard"},{"type":"text","text":" — the full-screen treatment: a full-size icon, and, for the Loading spinner, filling all available space."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":".compact"},{"type":"text","text":" to embed the same placeholder in a card or section instead of a whole screen: a smaller icon, smaller text, and — for the Loading spinner — no more forcing itself to fill the available space:"}]},{"code":["ScreenStateDefaultEmptyView(style: .compact)","ScreenStateDefaultLoadingUIView(style: .compact)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".compact"},{"type":"text","text":" always keeps a vertical icon-above-text layout, regardless of the device’s orientation — a card’s size is dictated by the card, not the device, unlike the automatic landscape-iPhone icon-beside-text switch "},{"type":"codeVoice","code":".standard"},{"type":"text","text":" makes on its own."}]},{"anchor":"Alternative-Loading-placeholders","type":"heading","level":2,"text":"Alternative Loading placeholders"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateDefaultLoadingView"},{"type":"text","text":"\/"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateDefaultLoadingUIView","isActive":true,"type":"reference"},{"text":" — the spinner — are what every default-wired ","type":"text"},{"type":"codeVoice","code":"ScreenStateView"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"ScreenStateContainerView"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"ScreenStateViewController"},{"text":" shows. Two opt-in alternatives cover the other common shapes a loading state takes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateShimmerLoadingView"},{"type":"text","text":"\/"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateShimmerLoadingUIView"},{"type":"text","text":": a pulsing skeleton of a circular avatar plus two text-line placeholders, for a generic “something’s coming” look that doesn’t need to know the real content’s shape."}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateRedactedLoadingView"},{"type":"text","text":": renders your real content view through SwiftUI’s "},{"code":".redacted(reason: .placeholder)","type":"codeVoice"},{"type":"text","text":", so the placeholder mirrors the exact shape of the content it’s standing in for. SwiftUI-only — "},{"code":"redacted(reason:)","type":"codeVoice"},{"type":"text","text":" has no UIKit equivalent."}],"type":"paragraph"}]}]},{"syntax":"swift","code":["ScreenStateShimmerLoadingView()","","ScreenStateRedactedLoadingView {","    ArticleRow(article: .placeholder)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both respect Reduce Motion and Increase Contrast the same way the default spinner does; see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Accessibility"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Theming","text":"Theming","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStatesTheme","isActive":true,"type":"reference"},{"type":"text","text":" lets a SwiftUI app theme every default placeholder at once — "},{"code":"tint","type":"codeVoice"},{