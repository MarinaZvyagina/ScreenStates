{"abstract":[{"text":"Common multi-screen patterns built on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes"},"variants":[{"paths":["\/documentation\/screenstates\/recipes"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"ScreenStates"}],"title":"Recipes"},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its "},{"type":"emphasis","inlineContent":[{"text":"own","type":"text"}]},{"type":"text","text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that."}]},{"text":"List + Detail","type":"heading","anchor":"List-+-Detail","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a "},{"type":"codeVoice","code":"[Article]"},{"type":"text","text":" summary for the list, a full "},{"type":"codeVoice","code":"Article"},{"type":"text","text":" for the detail — rather than trying to stretch one store to cover both:"}]},{"syntax":"swift","type":"codeListing","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"navigationDestination(for:)"},{"type":"text","text":" creates a fresh "},{"type":"codeVoice","code":"ArticleDetailScreen"},{"type":"text","text":" — and so a fresh store, starting at the default "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"type":"codeVoice","code":".task(id: articleID)"},{"type":"text","text":" (rather than a plain "},{"type":"codeVoice","code":".task"},{"type":"text","text":") is what makes this reusable in the next recipe below, where the same screen’s "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" can change "},{"type":"emphasis","inlineContent":[{"text":"without","type":"text"}]},{"type":"text","text":" the view itself being recreated."}]},{"text":"One Store per Tab","type":"heading","anchor":"One-Store-per-Tab","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give each tab’s screen its own "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" store. "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" preserves each tab’s view identity across switches, so the store — and the "},{"type":"codeVoice","code":".task"},{"type":"text","text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:"}]},{"syntax":"swift","type":"codeListing","code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Switching away from and back to a tab shows whatever "},{"type":"codeVoice","code":"store.state"},{"type":"text","text":" already holds — no flash back to "},{"type":"codeVoice","code":".loading"},{"type":"text","text":". If the data can go stale while another tab is active, wire up "},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":" (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI"},{"type":"text","text":") instead of relying on the initial "},{"type":"codeVoice","code":".task"},{"type":"text","text":" alone."}]},{"text":"Master-Detail with NavigationSplitView","type":"heading","anchor":"Master-Detail-with-NavigationSplitView","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" detail view instance’s "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" rather than creating a new one. This is exactly why the detail screen from "},{"type":"strong","inlineContent":[{"text":"List + Detail","type":"text"}]},{"type":"text","text":" used "},{"type":"codeVoice","code":".task(id: articleID)"},{"type":"text","text":": it cancels and restarts the load whenever "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" changes, which a plain "},{"type":"codeVoice","code":".task"},{"type":"text","text":" would miss."}]},{"syntax":"swift","type":"codeListing","code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — "},{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" only changes how they’re laid out, not how they’re driven."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates":{"abstract":[{"type":"text","text":"Give any screen a standard "},{"type":"codeVoice","code":"Empty"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Loading"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" state, usable from both UIKit and SwiftUI."}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","url":"\/documentation\/screenstates","type":"topic","role":"collection","kind":"symbol","title":"ScreenStates"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"abstract":[{"type":"text","text":"Drive a UIKit screen’s four states with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView"},{"type":"text","text":"."}],"kind":"article","url":"\/documentation\/screenstates\/gettingstartedwithuikit","title":"Getting Started with UIKit","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","role":"article","type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"abstract":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" holder of a screen’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"text":", driving both","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI and UIKit consumers from a single source of truth.","type":"text"}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstatestore","navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"title":"ScreenStateStore","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateStore"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstate","navigatorTitle":[{"text":"ScreenState","kind":"identifier"}],"title":"ScreenState","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenState","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/SwiftUIAndUIKitEquivalents":{"abstract":[{"type":"text","text":"A single table matching every SwiftUI-side type to its UIKit counterpart (and calling out the handful with no equivalent at all), for a reader who already knows one paradigm and wants the other’s version of the same thing at a glance."}],"kind":"article","url":"\/documentation\/screenstates\/swiftuianduikitequivalents","title":"SwiftUI & UIKit Equivalents","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents","role":"article","type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"abstract":[{"type":"text","text":"Renders the right content for a "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"type":"text","text":"Empty \/ Loading \/ Data \/ Error automatically."}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstateview","navigatorTitle":[{"text":"ScreenStateView","kind":"identifier"}],"title":"ScreenStateView","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateView","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" that swaps its content for the right placeholder based on a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":", mirroring "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"type":"text","text":" from the SwiftUI side."}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstatecontainerview","navigatorTitle":[{"text":"ScreenStateContainerView","kind":"identifier"}],"title":"ScreenStateContainerView","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateContainerView","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":".","type":"text"}],"kind":"article","url":"\/documentation\/screenstates\/gettingstartedwithswiftui","title":"Getting Started with SwiftUI","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","role":"article","type":"topic"}}}