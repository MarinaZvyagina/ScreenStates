{"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes"},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"title":"Related Documentation"},{"anchor":"Essentials","generated":true,"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"title":"Essentials"}],"metadata":{"modules":[{"name":"ScreenStates"}],"role":"article","roleHeading":"Article","title":"Recipes"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A single "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its "},{"inlineContent":[{"type":"text","text":"own"}],"type":"emphasis"},{"type":"text","text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that."}],"type":"paragraph"},{"anchor":"List-+-Detail","text":"List + Detail","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a "},{"type":"codeVoice","code":"[Article]"},{"type":"text","text":" summary for the list, a full "},{"type":"codeVoice","code":"Article"},{"text":" for the detail — rather than trying to stretch one store to cover both:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"navigationDestination(for:)","type":"codeVoice"},{"text":" creates a fresh ","type":"text"},{"type":"codeVoice","code":"ArticleDetailScreen"},{"text":" — and so a fresh store, starting at the default ","type":"text"},{"type":"codeVoice","code":".loading"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"code":".task(id: articleID)","type":"codeVoice"},{"text":" (rather than a plain ","type":"text"},{"code":".task","type":"codeVoice"},{"text":") is what makes this reusable in the next recipe below, where the same screen’s ","type":"text"},{"code":"articleID","type":"codeVoice"},{"text":" can change ","type":"text"},{"inlineContent":[{"type":"text","text":"without"}],"type":"emphasis"},{"text":" the view itself being recreated.","type":"text"}],"type":"paragraph"},{"anchor":"One-Store-per-Tab","text":"One Store per Tab","level":2,"type":"heading"},{"inlineContent":[{"text":"Give each tab’s screen its own ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" store. ","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" preserves each tab’s view identity across switches, so the store — and the ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Switching away from and back to a tab shows whatever ","type":"text"},{"code":"store.state","type":"codeVoice"},{"text":" already holds — no flash back to ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":". If the data can go stale while another tab is active, wire up ","type":"text"},{"code":"refreshCollection(_:)","type":"codeVoice"},{"text":" (see ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","type":"reference","isActive":true},{"text":") instead of relying on the initial ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" alone.","type":"text"}],"type":"paragraph"},{"anchor":"Master-Detail-with-NavigationSplitView","text":"Master-Detail with NavigationSplitView","level":2,"type":"heading"},{"inlineContent":[{"code":"NavigationSplitView","type":"codeVoice"},{"text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" detail view instance’s ","type":"text"},{"code":"articleID","type":"codeVoice"},{"text":" rather than creating a new one. This is exactly why the detail screen from ","type":"text"},{"inlineContent":[{"type":"text","text":"List + Detail"}],"type":"strong"},{"text":" used ","type":"text"},{"code":".task(id: articleID)","type":"codeVoice"},{"text":": it cancels and restarts the load whenever ","type":"text"},{"code":"articleID","type":"codeVoice"},{"text":" changes, which a plain ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" would miss.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — ","type":"text"},{"code":"NavigationSplitView","type":"codeVoice"},{"text":" only changes how they’re laid out, not how they’re driven.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","abstract":[{"text":"Common multi-screen patterns built on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference"},{"type":"text","text":"."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/screenstates\/recipes"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"title":"ScreenStateStore","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" holder of a screen’s "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference"},{"type":"text","text":", driving both"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI and UIKit consumers from a single source of truth."}],"url":"\/documentation\/screenstates\/screenstatestore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateStore"}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/SwiftUIAndUIKitEquivalents":{"url":"\/documentation\/screenstates\/swiftuianduikitequivalents","title":"SwiftUI & UIKit Equivalents","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents","abstract":[{"text":"A single table matching every SwiftUI-side type to its UIKit counterpart (and calling out the handful with no equivalent at all), for a reader who already knows one paradigm and wants the other’s version of the same thing at a glance.","type":"text"}],"kind":"article","type":"topic","role":"article"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateView"}],"kind":"symbol","abstract":[{"type":"text","text":"Renders the right content for a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"type":"text","text":"Empty \/ Loading \/ Data \/ Error automatically."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenStateView"}],"url":"\/documentation\/screenstates\/screenstateview","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"topic","title":"ScreenStateView"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","te