{"kind":"article","metadata":{"role":"article","modules":[{"name":"ScreenStates"}],"roleHeading":"Article","title":"Recipes"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Common multi-screen patterns built on ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"text":".","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"anchor":"Related-Documentation","title":"Related Documentation"},{"generated":true,"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"anchor":"Essentials","title":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes"},"variants":[{"paths":["\/documentation\/screenstates\/recipes"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its "},{"type":"emphasis","inlineContent":[{"text":"own","type":"text"}]},{"type":"text","text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that."}]},{"anchor":"List-+-Detail","level":2,"text":"List + Detail","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a "},{"code":"[Article]","type":"codeVoice"},{"type":"text","text":" summary for the list, a full "},{"code":"Article","type":"codeVoice"},{"type":"text","text":" for the detail — rather than trying to stretch one store to cover both:"}]},{"code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"navigationDestination(for:)","type":"codeVoice"},{"type":"text","text":" creates a fresh "},{"code":"ArticleDetailScreen","type":"codeVoice"},{"type":"text","text":" — and so a fresh store, starting at the default "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"code":".task(id: articleID)","type":"codeVoice"},{"type":"text","text":" (rather than a plain "},{"code":".task","type":"codeVoice"},{"type":"text","text":") is what makes this reusable in the next recipe below, where the same screen’s "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" can change "},{"type":"emphasis","inlineContent":[{"text":"without","type":"text"}]},{"type":"text","text":" the view itself being recreated."}]},{"anchor":"One-Store-per-Tab","level":2,"text":"One Store per Tab","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give each tab’s screen its own "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" store. "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" preserves each tab’s view identity across switches, so the store — and the "},{"code":".task","type":"codeVoice"},{"type":"text","text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:"}]},{"code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Switching away from and back to a tab shows whatever "},{"code":"store.state","type":"codeVoice"},{"type":"text","text":" already holds — no flash back to "},{"code":".loading","type":"codeVoice"},{"type":"text","text":". If the data can go stale while another tab is active, wire up "},{"code":"refreshCollection(_:)","type":"codeVoice"},{"type":"text","text":" (see "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","type":"reference","isActive":true},{"type":"text","text":") instead of relying on the initial "},{"code":".task","type":"codeVoice"},{"type":"text","text":" alone."}]},{"anchor":"Master-Detail-with-NavigationSplitView","level":2,"text":"Master-Detail with NavigationSplitView","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" detail view instance’s "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" rather than creating a new one. This is exactly why the detail screen from "},{"type":"strong","inlineContent":[{"text":"List + Detail","type":"text"}]},{"type":"text","text":" used "},{"code":".task(id: articleID)","type":"codeVoice"},{"type":"text","text":": it cancels and restarts the load whenever "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" changes, which a plain "},{"code":".task","type":"codeVoice"},{"type":"text","text":" would miss."}]},{"code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — "},{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" only changes how they’re laid out, not how they’re driven."}]}]}],"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/SwiftUIAndUIKitEquivalents":{"kind":"article","abstract":[{"type":"text","text":"A single table matching every SwiftUI-side type to its UIKit counterpart (and calling out the handful with no equivalent at all), for a reader who already knows one paradigm and wants the other’s version of the same thing at a glance."}],"role":"article","type":"topic","url":"\/documentation\/screenstates\/swiftuianduikitequivalents","title":"SwiftUI & UIKit Equivalents","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"title":"ScreenStateStore","abstract":[{"text":"An ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" holder of a screen’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference"},{"text":", driving both","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI and UIKit consumers from a single source of truth.","type":"text"}],"url":"\/documentation\/screenstates\/screenstatestore","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateStore"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates":{"kind":"symbol","url":"\/documentation\/screenstates","abstract":[{"type":"text","text":"Give any screen a standard "},{"type":"codeVoice","code":"Empty"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Loading"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" state, usable from both UIKit and SwiftUI.","type":"text"}],"title":"ScreenStates","role":"collection","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateView","kind":"identifier"}],"abstract":[{"text":"Renders the right content for a ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"text":", switching between","type":"text"},{"text":" ","type":"text"},{"text":"Empty \/ Loading \/ Data \/ Error automatically.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/screenstates\/screenstateview","title":"ScreenStateView","navigatorTitle":[{"kind":"identifier","text":"ScreenStateView"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","url":"\/documentation\/screenstates\/screenstatecontainerview","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateContainerView","kind":"identifier"}],"kind":"symbol","title":"ScreenStateContainerView","navigatorTitle":[{"text":"ScreenStateContainerView","kind":"identifier"}],"type":"topic","abstract":[{"text":"A ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" that swaps its content for the right placeholder based on a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"text":", mirroring ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference"},{"text":" from the SwiftUI side.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"kind":"article","abstract":[{"type":"text","text":"Drive a UIKit screen’s four states with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView"},{"type":"text","text":"."}],"role":"article","type":"topic","url":"\/documentation\/screenstates\/gettingstartedwithuikit","title":"Getting Started with UIKit","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","url":"\/documentation\/screenstates\/screenstate","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenState"}],"kind":"symbol","title":"ScreenState","navigatorTitle":[{"kind":"identifier","text":"ScreenState"}],"type":"topic","abstract":[{"text":"The four canonical states of a screen: nothing to show yet, in flight,","type":"text"},{"text":" ","type":"text"},{"text":"showing data, or failed.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Drive a SwiftUI screen’s four states with "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"type":"text","text":"."}],"role":"article","url":"\/documentation\/screenstates\/gettingstartedwithswiftui","type":"topic","title":"Getting Started with SwiftUI","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI"}}}