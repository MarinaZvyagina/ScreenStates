with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":".","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"ScreenState","kind":"identifier"}],"navigatorTitle":[{"text":"ScreenState","kind":"identifier"}],"type":"topic","role":"symbol","title":"ScreenState","abstract":[{"text":"The four canonical states of a screen: nothing to show yet, in flight,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"showing data, or failed."}],"url":"\/documentation\/screenstates\/screenstate","kind":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"url":"\/documentation\/screenstates\/screenstateview","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","title":"ScreenStateView","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateView","kind":"identifier"}],"abstract":[{"type":"text","text":"Renders the right content for a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"text":"Empty \/ Loading \/ Data \/ Error automatically.","type":"text"}],"navigatorTitle":[{"text":"ScreenStateView","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"url":"\/documentation\/screenstates\/screenstatecontainerview","title":"ScreenStateContainerView","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateContainerView"}],"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" that swaps its content for the right placeholder based on a"},{"type":"text","text":" "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":", mirroring "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"type":"text","text":" from the SwiftUI side."}],"navigatorTitle":[{"kind":"identifier","text":"ScreenStateContainerView"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/SwiftUIAndUIKitEquivalents":{"title":"SwiftUI & UIKit Equivalents","type":"topic","url":"\/documentation\/screenstates\/swiftuianduikitequivalents","kind":"article","role":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents","abstract":[{"type":"text","text":"A single table matching every SwiftUI-side type to its UIKit counterpart (and calling out the handful with no equivalent at all), for a reader who already knows one paradigm and wants the other’s version of the same thing at a glance."}]}}}