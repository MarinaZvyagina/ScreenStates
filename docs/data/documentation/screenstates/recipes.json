xt":" \/ "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" state, usable from both UIKit and SwiftUI."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"url":"\/documentation\/screenstates\/screenstateview","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateView"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","title":"ScreenStateView","navigatorTitle":[{"kind":"identifier","text":"ScreenStateView"}],"abstract":[{"text":"Renders the right content for a ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"type":"text","text":"Empty \/ Loading \/ Data \/ Error automatically."}],"kind":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"kind":"article","role":"article","type":"topic","abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","title":"Getting Started with SwiftUI","url":"\/documentation\/screenstates\/gettingstartedwithswiftui"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"title":"ScreenStateContainerView","kind":"symbol","abstract":[{"text":"A ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" that swaps its content for the right placeholder based on a","type":"