{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Common multi-screen patterns built on "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"type":"text","text":"."}],"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A single "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"type":"text","text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its "},{"type":"emphasis","inlineContent":[{"type":"text","text":"own"}]},{"type":"text","text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that."}],"type":"paragraph"},{"level":2,"anchor":"List-+-Detail","type":"heading","text":"List + Detail"},{"inlineContent":[{"type":"text","text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a "},{"type":"codeVoice","code":"[Article]"},{"type":"text","text":" summary for the list, a full "},{"type":"codeVoice","code":"Article"},{"type":"text","text":" for the detail — rather than trying to stretch one store to cover both:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"navigationDestination(for:)"},{"type":"text","text":" creates a fresh "},{"type":"codeVoice","code":"ArticleDetailScreen"},{"type":"text","text":" — and so a fresh store, starting at the default "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"type":"codeVoice","code":".task(id: articleID)"},{"type":"text","text":" (rather than a plain "},{"type":"codeVoice","code":".task"},{"type":"text","text":") is what makes this reusable in the next recipe below, where the same screen’s "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" can change "},{"type":"emphasis","inlineContent":[{"type":"text","text":"without"}]},{"type":"text","text":" the view itself being recreated."}],"type":"paragraph"},{"level":2,"type":"heading","text":"One Store per Tab","anchor":"One-Store-per-Tab"},{"inlineContent":[{"type":"text","text":"Give each tab’s screen its own "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" store. "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" preserves each tab’s view identity across switches, so the store — and the "},{"type":"codeVoice","code":".task"},{"type":"text","text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"]},{"inlineContent":[{"type":"text","text":"Switching away from and back to a tab shows whatever "},{"type":"codeVoice","code":"store.state"},{"type":"text","text":" already holds — no flash back to "},{"type":"codeVoice","code":".loading"},{"type":"text","text":". If the data can go stale while another tab is active, wire up "},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":" (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI"},{"type":"text","text":") instead of relying on the initial "},{"type":"codeVoice","code":".task"},{"type":"text","text":" alone."}],"type":"paragraph"},{"level":2,"anchor":"Master-Detail-with-NavigationSplitView","type":"heading","text":"Master-Detail with NavigationSplitView"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" detail view instance’s "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" rather than creating a new one. This is exactly why the detail screen from "},{"inlineContent":[{"type":"text","text":"List + Detail"}],"type":"strong"},{"type":"text","text":" used "},{"code":".task(id: articleID)","type":"codeVoice"},{"type":"text","text":": it cancels and restarts the load whenever "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" changes, which a plain "},{"code":".task","type":"codeVoice"},{"type":"text","text":" would miss."}]},{"syntax":"swift","type":"codeListing","code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — "},{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" only changes how they’re laid out, not how they’re driven."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"variants":[{"paths":["\/documentation\/screenstates\/recipes"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"title":"Related Documentation"},{"anchor":"Essentials","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"title":"Essentials","generated":true}],"metadata":{"roleHeading":"Article","modules":[{"name":"ScreenStates"}],"role":"article","title":"Recipes"},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/SwiftUIAndUIKitEquivalents":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents","abstract":[{"text":"A single table matching every SwiftUI-side type to its UIKit counterpart (and calling out the handful with no equivalent at all), for a reader who already knows one paradigm and wants the other’s version of the same thing at a glance.","type":"text"}],"role":"article","url":"\/documentation\/screenstates\/swiftuianduikitequivalents","kind":"article","type":"topic","title":"SwiftUI & UIKit Equivalents"},"doc://screenstates.ScreenStates/documentation/ScreenStates":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","abstract":[{"type":"text","text":"Give any screen a standard "},{"type":"codeVoice","code":"Empty"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Loading"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" state, usable from both UIKit and SwiftUI."}],"role":"collection","url":"\/documentation\/screenstates","kind":"symbol","type":"topic","title":"ScreenStates"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"navigatorTitle":[{"text":"ScreenStateView","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstateview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateView","kind":"identifier"}],"abstract":[{"type":"text","text":"Renders the right content for a "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"type":"text","text":"Empty \/ Loading \/ Data \/ Error automatically."}],"title":"ScreenStateView","role":"symbol","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" that swaps its content for the right placeholder based on a"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference"},{"type":"text","text":", mirroring "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference"},{"type":"text","text":" from the SwiftUI side."}],"role":"symbol","url":"\/documentation\/screenstates\/screenstatecontainerview","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenStateContainerView"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateContainerView"}],"type":"topic","title":"ScreenStateContainerView"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"kind":"article","url":"\/documentation\/screenstates\/gettingstartedwithswiftui","abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"type":"text","text":"."}],"title":"Getting Started with SwiftUI","role":"article","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstatestore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateStore"}],"abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" holder of a screen’s "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"type":"text","text":", driving both"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI and UIKit consumers from a single source of truth."}],"title":"ScreenStateStore","role":"symbol","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"navigatorTitle":[{"text":"ScreenState","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstate","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenState","kind":"identifier"}],"abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}],"title":"ScreenState","role":"symbol","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"abstract":[{"type":"text","text":"Drive a UIKit screen’s four states with "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","type":"reference"},{"type":"text","text":"."}],"title":"Getting Started with UIKit","role":"article","url":"\/documentation\/screenstates\/gettingstartedwithuikit","kind":"article","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit"}}}