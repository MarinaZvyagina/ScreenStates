{"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"title":"Related Documentation"},{"anchor":"Essentials","generated":true,"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"title":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes","interfaceLanguage":"swift"},"kind":"article","variants":[{"paths":["\/documentation\/screenstates\/recipes"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"ScreenStates"}],"roleHeading":"Article","role":"article","title":"Recipes"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A single ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its ","type":"text"},{"inlineContent":[{"type":"text","text":"own"}],"type":"emphasis"},{"text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that.","type":"text"}]},{"level":2,"text":"List + Detail","type":"heading","anchor":"List-+-Detail"},{"type":"paragraph","inlineContent":[{"text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a ","type":"text"},{"type":"codeVoice","code":"[Article]"},{"text":" summary for the list, a full ","type":"text"},{"type":"codeVoice","code":"Article"},{"text":" for the detail — rather than trying to stretch one store to cover both:","type":"text"}]},{"syntax":"swift","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"navigationDestination(for:)"},{"type":"text","text":" creates a fresh "},{"type":"codeVoice","code":"ArticleDetailScreen"},{"type":"text","text":" — and so a fresh store, starting at the default "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"type":"codeVoice","code":".task(id: articleID)"},{"text":" (rather than a plain ","type":"text"},{"type":"codeVoice","code":".task"},{"text":") is what makes this reusable in the next recipe below, where the same screen’s ","type":"text"},{"type":"codeVoice","code":"articleID"},{"text":" can change ","type":"text"},{"inlineContent":[{"type":"text","text":"without"}],"type":"emphasis"},{"text":" the view itself being recreated.","type":"text"}]},{"anchor":"One-Store-per-Tab","type":"heading","level":2,"text":"One Store per Tab"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give each tab’s screen its own "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" store. "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" preserves each tab’s view identity across switches, so the store — and the "},{"code":".task","type":"codeVoice"},{"type":"text","text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:"}]},{"code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Switching away from and back to a tab shows whatever "},{"code":"store.state","type":"codeVoice"},{"type":"text","text":" already holds — no flash back to "},{"code":".loading","type":"codeVoice"},{"type":"text","text":". If the data can go stale while another tab is active, wire up "},{"code":"refreshCollection(_:)","type":"codeVoice"},{"type":"text","text":" (see "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","isActive":true},{"type":"text","text":") instead of relying on the initial "},{"code":".task","type":"codeVoice"},{"type":"text","text":" alone."}]},{"anchor":"Master-Detail-with-NavigationSplitView","type":"heading","level":2,"text":"Master-Detail with NavigationSplitView"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the "},{"inlineContent":[{"text":"same","type":"text"}],"type":"emphasis"},{"type":"text","text":" detail view instance’s "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" rather than creating a new one. This is exactly why the detail screen from "},{"inlineContent":[{"text":"List + Detail","type":"text"}],"type":"strong"},{"type":"text","text":" used "},{"type":"codeVoice","code":".task(id: articleID)"},{"type":"text","text":": it cancels and restarts the load whenever "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" changes, which a plain "},{"type":"codeVoice","code":".task"},{"type":"text","text":" would miss."}]},{"type":"codeListing","syntax":"swift","code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — ","type":"text"},{"code":"NavigationSplitView","type":"codeVoice"},{"text":" only changes how they’re laid out, not how they’re driven.","type":"text"}]}]}],"sections":[],"abstract":[{"text":"Common multi-screen patterns built on ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"text":".","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateContainerView"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","abstract":[{"text":"A ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" that swaps its content for the right placeholder based on a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":", mirroring ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"text":" from the SwiftUI side.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/screenstates\/screenstatecontainerview","type":"topic","navigatorTitle":[{"text":"ScreenStateContainerView","kind":"identifier"}],"title":"ScreenStateContainerView"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateStore","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"An ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" holder of a screen’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference"},{"text":", driving both","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI and UIKit consumers from a single source of truth.","type":"text"}],"title":"ScreenStateStore","url":"\/documentation\/screenstates\/screenstatestore","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","role":"symbol","navigatorTitle":[{"text":"ScreenStateStore","kind":"identifier"}],"type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"article","url":"\/documentation\/screenstates\/gettingstartedwithswiftui","type":"topic","role":"article","title":"Getting Started with SwiftUI","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ScreenState"}],"kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","url":"\/documentation\/screenstates\/screenstate","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenState"}],"title":"ScreenState"},"doc://screenstates.ScreenStates/documentation/ScreenStates":{"role":"collection","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","kind":"symbol","abstract":[{"text":"Give any screen a standard ","type":"text"},{"type":"codeVoice","code":"Empty"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Loading"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" state, usable from both UIKit and SwiftUI.","type":"text"}],"type":"topic","title":"ScreenStates","url":"\/documentation\/screenstates"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"abstract":[{"type":"text","text":"Drive a UIKit screen’s four states with "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/screenstates\/gettingstartedwithuikit","role":"article","kind":"article","title":"Getting Started with UIKit","type":"topic","identifier":"doc:\/\/sc