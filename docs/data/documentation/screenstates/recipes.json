{"sections":[],"variants":[{"paths":["\/documentation\/screenstates\/recipes"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes"},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"ScreenStates"}],"title":"Recipes"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A single "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its "},{"type":"emphasis","inlineContent":[{"text":"own","type":"text"}]},{"type":"text","text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that."}],"type":"paragraph"},{"text":"List + Detail","level":2,"type":"heading","anchor":"List-+-Detail"},{"inlineContent":[{"type":"text","text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a "},{"code":"[Article]","type":"codeVoice"},{"type":"text","text":" summary for the list, a full "},{"code":"Article","type":"codeVoice"},{"type":"text","text":" for the detail — rather than trying to stretch one store to cover both:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"navigationDestination(for:)","type":"codeVoice"},{"type":"text","text":" creates a fresh "},{"code":"ArticleDetailScreen","type":"codeVoice"},{"type":"text","text":" — and so a fresh store, starting at the default "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"code":".task(id: articleID)","type":"codeVoice"},{"type":"text","text":" (rather than a plain "},{"code":".task","type":"codeVoice"},{"type":"text","text":") is what makes this reusable in the next recipe below, where the same screen’s "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" can change "},{"type":"emphasis","inlineContent":[{"text":"without","type":"text"}]},{"type":"text","text":" the view itself being recreated."}],"type":"paragraph"},{"text":"One Store per Tab","level":2,"type":"heading","anchor":"One-Store-per-Tab"},{"inlineContent":[{"type":"text","text":"Give each tab’s screen its own "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" store. "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" preserves each tab’s view identity across switches, so the store — and the "},{"code":".task","type":"codeVoice"},{"type":"text","text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:"}],"type":"paragraph"},{"syntax":"swift","code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Switching away from and back to a tab shows whatever "},{"code":"store.state","type":"codeVoice"},{"type":"text","text":" already holds — no flash back to "},{"code":".loading","type":"codeVoice"},{"type":"text","text":". If the data can go stale while another tab is active, wire up "},{"code":"refreshCollection(_:)","type":"codeVoice"},{"type":"text","text":" (see "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","type":"reference","isActive":true},{"type":"text","text":") instead of relying on the initial "},{"code":".task","type":"codeVoice"},{"type":"text","text":" alone."}],"type":"paragraph"},{"text":"Master-Detail with NavigationSplitView","level":2,"type":"heading","anchor":"Master-Detail-with-NavigationSplitView"},{"inlineContent":[{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" detail view instance’s "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" rather than creating a new one. This is exactly why the detail screen from "},{"type":"strong","inlineContent":[{"text":"List + Detail","type":"text"}]},{"type":"text","text":" used "},{"code":".task(id: articleID)","type":"codeVoice"},{"type":"text","text":": it cancels and restarts the load whenever "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" changes, which a plain "},{"code":".task","type":"codeVoice"},{"type":"text","text":" would miss."}],"type":"paragraph"},{"syntax":"swift","code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — "},{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" only changes how they’re laid out, not how they’re driven."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"abstract":[{"type":"text","text":"Common multi-screen patterns built on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":".","type":"text"}],"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"role":"symbol","navigatorTitle":[{"text":"ScreenStateView","kind":"identifier"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateView"}],"title":"ScreenStateView","url":"\/documentation\/screenstates\/screenstateview","abstract":[{"type":"text","text":"Renders the right content for a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStat