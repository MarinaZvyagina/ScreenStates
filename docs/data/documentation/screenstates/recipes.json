{"metadata":{"title":"Recipes","role":"article","modules":[{"name":"ScreenStates"}],"roleHeading":"Article"},"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"kind":"article","abstract":[{"text":"Common multi-screen patterns built on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/recipes"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A single "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its "},{"inlineContent":[{"type":"text","text":"own"}],"type":"emphasis"},{"type":"text","text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that."}],"type":"paragraph"},{"text":"List + Detail","anchor":"List-+-Detail","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a "},{"code":"[Article]","type":"codeVoice"},{"type":"text","text":" summary for the list, a full "},{"code":"Article","type":"codeVoice"},{"type":"text","text":" for the detail — rather than trying to stretch one store to cover both:"}],"type":"paragraph"},{"code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"navigationDestination(for:)","type":"codeVoice"},{"type":"text","text":" creates a fresh "},{"code":"ArticleDetailScreen","type":"codeVoice"},{"type":"text","text":" — and so a fresh store, starting at the default "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"code":".task(id: articleID)","type":"codeVoice"},{"type":"text","text":" (rather than a plain "},{"code":".task","type":"codeVoice"},{"type":"text","text":") is what makes this reusable in the next recipe below, where the same screen’s "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" can change "},{"inlineContent":[{"type":"text","text":"without"}],"type":"emphasis"},{"type":"text","text":" the view itself being recreated."}],"type":"paragraph"},{"text":"One Store per Tab","anchor":"One-Store-per-Tab","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Give each tab’s screen its own "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" store. "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" preserves each tab’s view identity across switches, so the store — and the "},{"code":".task","type":"codeVoice"},{"type":"text","text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:"}],"type":"paragraph"},{"code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Switching away from and back to a tab shows whatever "},{"code":"store.state","type":"codeVoice"},{"type":"text","text":" already holds — no flash back to "},{"code":".loading","type":"codeVoice"},{"type":"text","text":". If the data can go stale while another tab is active, wire up "},{"code":"refreshCollection(_:)","type":"codeVoice"},{"type":"text","text":" (see "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","type":"reference","isActive":true},{"type":"text","text":") instead of relying on the initial "},{"code":".task","type":"codeVoice"},{"type":"text","text":" alone."}],"type":"paragraph"},{"text":"Master-Detail with NavigationSplitView","anchor":"Master-Detail-with-NavigationSplitView","level":2,"type":"heading"},{"inlineContent":[{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the "},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"type":"text","text":" detail view instance’s "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" rather than creating a new one. This is exactly why the detail screen from "},{"inlineContent":[{"type":"text","text":"List + Detail"}],"type":"strong"},{"type":"text","text":" used "},{"code":".task(id: articleID)","type":"codeVoice"},{"type":"text","text":": it cancels and restarts the load whenever "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" changes, which a plain "},{"code":".task","type":"codeVoice"},{"type":"text","text":" would miss."}],"type":"paragraph"},{"code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — "},{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" only changes how they’re laid out, not how they’re driven."}],"type":"paragraph"}]}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"anchor":"Related-Documentation"},{"title":"Essentials","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"anchor":"Essentials","generated":true}],"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateStore"}],"role":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","title":"ScreenStateStore","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" holder of a screen’s "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"type":"text","text":", driving both"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI and UIKit consumers from a single source of truth."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"url":"\/documentation\/screenstates\/screenstatestore","type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateContainerView"}],"role":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","title":"ScreenStateContainerView","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" that swaps its content for the right placeholder based on a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"type":"text","text":", mirroring "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true},{"type":"text","text":" from the SwiftUI side."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenStateContainerView"}],"url":"\/documentation\/screenstates\/screenstatecontainerview","type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"abstract":[{"text":"Drive a UIKit screen’s four states with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView"},{"text":".","type":"text"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","kind":"article","role":"article","type":"topic","url":"\/documentation\/screenstates\/gettingstartedwithuikit","title":"Getting Started with UIKit"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"url":"\/documentation\/screenstates\/screenstateview","kind":"symbol","type":"topic","title":"ScreenStateView","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateView"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","navigatorTitle":[{"kind":"identifier","text":"ScreenStateView"}],"abstract":[{"type":"text","text":"Renders the right content for a "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"type":"text","text":"Empty \/ Loading \/ Data \/ Error automatically."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates":{"kind":"symbol","title":"ScreenStates","type":"topic","url":"\/documentation\/screenstates","role":"collection","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","abstract":[{"type":"text","text":"Give any screen a standard "},{"type":"codeVoice","code":"Empty"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Loading"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" state, usable from both UIKit and SwiftUI."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/SwiftUIAndUIKitEquivalents":{"url":"\/documentation\/screenstates\/swiftuianduikitequivalents","title":"SwiftUI & UIKit Equivalents","type":"topic","kind":"article","role":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents","abstract":[{"text":"A single table matching every SwiftUI-side type to its UIKit counterpart (and calling out the handful with no equivalent at all), for a reader who already knows one paradigm and wants the other’s version of the same thing at a glance.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"url":"\/documentation\/screenstates\/gettingstartedwithswiftui","title":"Getting Started with SwiftUI","type":"topic","kind":"article","role":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":".","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"url":"\/documentation\/screenstates\/screenstate","kind":"symbol","type":"topic","title":"ScreenState","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenState"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","navigatorTitle":[{"kind":"identifier","text":"ScreenState"}],"abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}]}}}