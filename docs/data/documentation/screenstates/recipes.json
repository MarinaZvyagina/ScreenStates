{"sections":[],"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"A single ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its ","type":"text"},{"inlineContent":[{"type":"text","text":"own"}],"type":"emphasis"},{"text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that.","type":"text"}],"type":"paragraph"},{"text":"List + Detail","anchor":"List-+-Detail","type":"heading","level":2},{"inlineContent":[{"text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a ","type":"text"},{"code":"[Article]","type":"codeVoice"},{"text":" summary for the list, a full ","type":"text"},{"code":"Article","type":"codeVoice"},{"text":" for the detail — rather than trying to stretch one store to cover both:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"navigationDestination(for:)","type":"codeVoice"},{"text":" creates a fresh ","type":"text"},{"code":"ArticleDetailScreen","type":"codeVoice"},{"text":" — and so a fresh store, starting at the default ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" — every time a row is tapped, so there’s no manual reset to write. ","type":"text"},{"code":".task(id: articleID)","type":"codeVoice"},{"text":" (rather than a plain ","type":"text"},{"code":".task","type":"codeVoice"},{"text":") is what makes this reusable in the next recipe below, where the same screen’s ","type":"text"},{"code":"articleID","type":"codeVoice"},{"text":" can change ","type":"text"},{"inlineContent":[{"type":"text","text":"without"}],"type":"emphasis"},{"text":" the view itself being recreated.","type":"text"}],"type":"paragraph"},{"text":"One Store per Tab","anchor":"One-Store-per-Tab","type":"heading","level":2},{"inlineContent":[{"text":"Give each tab’s screen its own ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" store. ","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" preserves each tab’s view identity across switches, so the store — and the ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Switching away from and back to a tab shows whatever ","type":"text"},{"code":"store.state","type":"codeVoice"},{"text":" already holds — no flash back to ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":". If the data can go stale while another tab is active, wire up ","type":"text"},{"code":"refreshCollection(_:)","type":"codeVoice"},{"text":" (see ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","isActive":true,"type":"reference"},{"text":") instead of relying on the initial ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" alone.","type":"text"}],"type":"paragraph"},{"text":"Master-Detail with NavigationSplitView","anchor":"Master-Detail-with-NavigationSplitView","type":"heading","level":2},{"inlineContent":[{"code":"NavigationSplitView","type":"codeVoice"},{"text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" detail view instance’s ","type":"text"},{"code":"articleID","type":"codeVoice"},{"text":" rather than creating a new one. This is exactly why the detail screen from ","type":"text"},{"inlineContent":[{"type":"text","text":"List + Detail"}],"type":"strong"},{"text":" used ","type":"text"},{"code":".task(id: articleID)","type":"codeVoice"},{"text":": it cancels and restarts the load whenever ","type":"text"},{"code":"articleID","type":"codeVoice"},{"text":" changes, which a plain ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" would miss.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — ","type":"text"},{"code":"NavigationSplitView","type":"codeVoice"},{"text":" only changes how they’re laid out, not how they’re driven.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Common multi-screen patterns built on ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"text":".","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"variants":[{"paths":["\/documentation\/screenstates\/recipes"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","title":"Recipes","modules":[{"name":"ScreenStates"}],"roleHeading":"Article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes"},"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"navigatorTitle":[{"text":"ScreenStateStore","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","url":"\/documentation\/screenstates\/screenstatestore","kind":"symbol","title":"ScreenStateStore","abstract":[{"text":"An ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" holder of a screen’s ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":", driving both","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI and UIKit consumers from a single source of truth.","type":"text"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateStore","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/SwiftUIAndUIKitEquivalents":{"role":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents","url":"\/documentation\/screenstates\/swiftuianduikitequivalents","kind":"article","title":"SwiftUI & UIKit Equivalents","abstract":[{"text":"A single table matching every SwiftUI-side type to its UIKit counterpart (and calling out the handful with no equivalent at all), for a reader who already knows one paradigm and wants the other’s version of the same thing at a glance.","type":"text"}],"type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates":{"kind":"symbol","role":"collection","abstract":[{"text":"Give any screen a standard ","type":"text"},{"type":"codeVoice","code":"Empty"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Loading"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" state, usable from both UIKit and SwiftUI.","type":"text"}],"title":"ScreenStates","type":"topic","url":"\/documentation\/screenstates","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"navigatorTitle":[{"text":"ScreenStateContainerView","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","url":"\/documentation\/screenstates\/screenstatecontainerview","kind":"symbol","title":"ScreenStateContainerView","abstract":[{"text":"A ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" that swaps its content for the right placeholder based on a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":", mirroring ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"text":" from the SwiftUI side.","type":"text"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateContainerView","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"role":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","url":"\/documentation\/screenstates\/gettingstartedwithswiftui","kind":"article","title":"Getting Started with SwiftUI","abstract":[{"type":"text","text":"Drive a SwiftUI screen’s four states with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":".","type":"text"}],"type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"role":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","url":"\/documentation\/screenstates\/gettingstartedwithuikit","kind":"article","title":"Getting Started with UIKit","abstract":[{"text":"Drive a UIKit screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainer