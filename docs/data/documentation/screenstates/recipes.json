{"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"abstract":[{"type":"text","text":"Common multi-screen patterns built on "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"type":"text","text":"."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"A single ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its ","type":"text"},{"inlineContent":[{"type":"text","text":"own"}],"type":"emphasis"},{"text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that.","type":"text"}],"type":"paragraph"},{"level":2,"text":"List + Detail","anchor":"List-+-Detail","type":"heading"},{"inlineContent":[{"text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a ","type":"text"},{"type":"codeVoice","code":"[Article]"},{"text":" summary for the list, a full ","type":"text"},{"type":"codeVoice","code":"Article"},{"type":"text","text":" for the detail — rather than trying to stretch one store to cover both:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"navigationDestination(for:)"},{"type":"text","text":" creates a fresh "},{"type":"codeVoice","code":"ArticleDetailScreen"},{"type":"text","text":" — and so a fresh store, starting at the default "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"type":"codeVoice","code":".task(id: articleID)"},{"type":"text","text":" (rather than a plain "},{"type":"codeVoice","code":".task"},{"type":"text","text":") is what makes this reusable in the next recipe below, where the same screen’s "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" can change "},{"inlineContent":[{"text":"without","type":"text"}],"type":"emphasis"},{"type":"text","text":" the view itself being recreated."}],"type":"paragraph"},{"anchor":"One-Store-per-Tab","type":"heading","level":2,"text":"One Store per Tab"},{"inlineContent":[{"type":"text","text":"Give each tab’s screen its own "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" store. "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" preserves each tab’s view identity across switches, so the store — and the "},{"code":".task","type":"codeVoice"},{"type":"text","text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"]},{"inlineContent":[{"text":"Switching away from and back to a tab shows whatever ","type":"text"},{"type":"codeVoice","code":"store.state"},{"text":" already holds — no flash back to ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":". If the data can go stale while another tab is active, wire up ","type":"text"},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":" (see "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","isActive":true},{"type":"text","text":") instead of relying on the initial "},{"type":"codeVoice","code":".task"},{"type":"text","text":" alone."}],"type":"paragraph"},{"level":2,"text":"Master-Detail with NavigationSplitView","anchor":"Master-Detail-with-NavigationSplitView","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationSplitView"},{"text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"text":" detail view instance’s ","type":"text"},{"type":"codeVoice","code":"articleID"},{"text":" rather than creating a new one. This is exactly why the detail screen from ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"List + Detail"}]},{"text":" used ","type":"text"},{"type":"codeVoice","code":".task(id: articleID)"},{"text":": it cancels and restarts the load whenever ","type":"text"},{"type":"codeVoice","code":"articleID"},{"text":" changes, which a plain ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" would miss.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — ","type":"text"},{"type":"codeVoice","code":"NavigationSplitView"},{"text":" only changes how they’re laid out, not how they’re driven.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/screenstates\/recipes"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes","interfaceLanguage":"swift"},"sections":[],"kind":"article","metadata":{"role":"article","title":"Recipes","modules":[{"name":"ScreenStates"}],"roleHeading":"Article"},"seeAlsoSections":[{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates":{"kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","type":"topic","title":"ScreenStates","role":"collection","abstract":[{"type":"text","text":"Give any screen a standard "},{"type":"codeVoice","code":"Empty"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Loading"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" state, usable from both UIKit and SwiftUI."}],"url":"\/documentation\/screenstates"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"url":"\/documentation\/screenstates\/screenstateview","kind":"symbol","navigatorTitle":[{"text":"ScreenStateView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateView","kind":"identifier"}],"title":"ScreenStateView","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","role":"symbol","abstract":[{"type":"text","text":"Renders the right content for a "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":", switching between"},{"type":"text","text":" "},{"type":"text","text":"Empty \/ Loading \/ Data \/ Error automatically."}],"type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"kind":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","role":"article","url":"\/documentation\/screenstates\/gettingstartedwithswiftui","type":"topic","title":"Getting Started with SwiftUI","abstract":[{"type":"text","text":"Drive a SwiftUI screen’s four states with "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true},{"type":"text","text":"."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/SwiftUIAndUIKitEquivalents":{"kind":"article","abstract":[{"type":"text","text":"A single table matching every SwiftUI-side type to its UIKit counterpart (and calling out the handful with no equivalent at all), for a reader who already knows one paradigm and wants the other’s version of the same thing at a glance."}],"type":"topic","title":"SwiftUI & UIKit Equivalents","role":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents","url":"\/documentation\/screenstates\/swiftuianduikitequivalents"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateStore"}],"abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" holder of a screen’s "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":", driving both"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI and UIKit consumers from a single source of truth."}],"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"url":"\/documentation\/screenstates\/screenstatestore","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","title":"ScreenStateStore","kind":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"kind":"symbol","url":"\/documentation\/screenstates\/screenstate","navigatorTitle":[{"text":"ScreenState","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenState","kind":"identifier"}],"title":"ScreenState","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","role":"symbol","abstract":[{"type":"text","text":"The four canonical states of a screen: nothing to show yet, in flight,"},{"type":"text","text":" "},{"type":"text","text":"showing data, or failed."}],"type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"abstract":[{"text":"A ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" that swaps its content for the right placeholder based on a","type":"text"},{"text":" ","type":"text"},{"identifier":"do