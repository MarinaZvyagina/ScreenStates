{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes"},"sections":[],"metadata":{"title":"Recipes","role":"article","modules":[{"name":"ScreenStates"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"abstract":[{"type":"text","text":"Common multi-screen patterns built on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"type":"text","text":"."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its "},{"type":"emphasis","inlineContent":[{"text":"own","type":"text"}]},{"type":"text","text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that."}]},{"level":2,"type":"heading","text":"List + Detail","anchor":"List-+-Detail"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a "},{"type":"codeVoice","code":"[Article]"},{"type":"text","text":" summary for the list, a full "},{"type":"codeVoice","code":"Article"},{"type":"text","text":" for the detail — rather than trying to stretch one store to cover both:"}]},{"code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"navigationDestination(for:)"},{"type":"text","text":" creates a fresh "},{"type":"codeVoice","code":"ArticleDetailScreen"},{"type":"text","text":" — and so a fresh store, starting at the default "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"type":"codeVoice","code":".task(id: articleID)"},{"type":"text","text":" (rather than a plain "},{"type":"codeVoice","code":".task"},{"type":"text","text":") is what makes this reusable in the next recipe below, where the same screen’s "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" can change "},{"type":"emphasis","inlineContent":[{"text":"without","type":"text"}]},{"type":"text","text":" the view itself being recreated."}]},{"level":2,"type":"heading","text":"One Store per Tab","anchor":"One-Store-per-Tab"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give each tab’s screen its own "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" store. "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" preserves each tab’s view identity across switches, so the store — and the "},{"type":"codeVoice","code":".task"},{"type":"text","text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:"}]},{"code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Switching away from and back to a tab shows whatever "},{"type":"codeVoice","code":"store.state"},{"type":"text","text":" already holds — no flash back to "},{"type":"codeVoice","code":".loading"},{"type":"text","text":". If the data can go stale while another tab is active, wire up "},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":" (see "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","type":"reference","isActive":true},{"type":"text","text":") instead of relying on the initial "},{"type":"codeVoice","code":".task"},{"type":"text","text":" alone."}]},{"level":2,"type":"heading","text":"Master-Detail with NavigationSplitView","anchor":"Master-Detail-with-NavigationSplitView"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" detail view instance’s "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" rather than creating a new one. This is exactly why the detail screen from "},{"type":"strong","inlineContent":[{"text":"List + Detail","type":"text"}]},{"type":"text","text":" used "},{"type":"codeVoice","code":".task(id: articleID)"},{"type":"text","text":": it cancels and restarts the load whenever "},{"type":"codeVoice","code":"articleID"},{"type":"text","text":" changes, which a plain "},{"type":"codeVoice","code":".task"},{"type":"text","text":" would miss."}]},{"code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — "},{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" only changes how they’re laid out, not how they’re driven."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/screenstates\/recipes"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","url":"\/documentation\/screenstates\/screenstateview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateView"}],"abstract":[{"text":"Renders the right content for a ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":", switching between","type":"text"},{"text":" ","type":"text"},{"text":"Empty \/ Loading \/ Data \/ Error automatically.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ScreenStateView"}],"title":"ScreenStateView","role":"symbol","type":"topic"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","kind":"article","abstract":[{"text":"Drive a UIKit screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","isActive":true,"type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/screenstates\/gettingstartedwithuikit","title":"Getting Started with UIKit","type":"topic","role":"article"},"doc://screenstates.ScreenStates/documentation/ScreenStates/SwiftUIAndUIKitEquivalents":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents","role":"article","kind":"article","abstract":[{"text":"A single table matching every SwiftUI-side type to its UIKit counterpart (and calling out the handful with no equivalent at all), for a reader who already knows one paradigm and wants the other’s version of the same thing at a glance.","type":"text"}],"type":"topic","title":"SwiftUI & UIKit Equivalents","url":"\/documentation\/screenstates\/swiftuianduikitequivalents"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","role":"symbol","kind":"symbol","abstract":[{"text":"The four canonical states of a screen: nothing to show yet, in flight,","type":"text"},{"text":" ","type":"text"},{"text":"showing data, or failed.","type":"text"}],"navigatorTitle":[{"text":"ScreenState","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenState","kind":"identifier"}],"type":"topic","title":"ScreenState","url":"\/documentation\/screenstates\/screenstate"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","role":"symbol","kind":"symbol","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"UIView"},{"text":" that swaps its content for the right placeholder based on a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"text":", mirroring ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":" from the SwiftUI side.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ScreenStateContainerView"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateContainerView"}],"type":"topic","title":"ScreenStateContainerView","url":"\/documentation\/screenstates\/screenstatecontainerview"},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithSwiftUI":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","kind":"article","abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/screenstates\/gettingstartedwithswiftui","title":"Getting Started with SwiftUI","type":"topic","role":"article"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","role":"symbol","kind":"symbol","abstract":[{"text":"An ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" holder of a screen’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference"},{"text":", driving both","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI and UIKit consumers from a single source of truth.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateStore"}],"type":"topic","title":"ScreenStateStore","url":"\/documentation\/screenstates\/screenstatestore"},"doc://screenstates.ScreenStates/documentation/ScreenStates":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","kind":"symbol","title":"ScreenStates","type":"topic","abstract":[{"text":"Give any screen a standard ","type":"text"},{"type":"codeVoice","code":"Empty"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Loading"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" state, usable from both UIKit and SwiftUI.","type":"text"}],"role":"collection","url":"\/documentation\/screenstates"}}}