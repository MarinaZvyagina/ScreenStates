{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/recipes"]}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"],"anchor":"Related-Documentation"},{"title":"Essentials","generated":true,"identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"anchor":"Essentials"}],"metadata":{"modules":[{"name":"ScreenStates"}],"roleHeading":"Article","role":"article","title":"Recipes"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes"},"abstract":[{"type":"text","text":"Common multi-screen patterns built on "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"type":"text","text":" models one screen. Real apps have several screens at once — a list next to a detail, one per tab, a sidebar next to its content — each of which typically wants its "},{"type":"emphasis","inlineContent":[{"type":"text","text":"own"}]},{"type":"text","text":" store, scoped to exactly what that screen shows. This article walks through three common shapes for that."}]},{"type":"heading","text":"List + Detail","level":2,"anchor":"List-+-Detail"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give the list screen and the detail screen their own store, each scoped to what that screen actually needs — a "},{"code":"[Article]","type":"codeVoice"},{"type":"text","text":" summary for the list, a full "},{"code":"Article","type":"codeVoice"},{"type":"text","text":" for the detail — rather than trying to stretch one store to cover both:"}]},{"type":"codeListing","code":["struct ArticlesListScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { article in","                    NavigationLink(article.title, value: article.id)","                }","            }","            .navigationDestination(for: Article.ID.self) { id in","                ArticleDetailScreen(articleID: id)","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}","","struct ArticleDetailScreen: View {","    let articleID: Article.ID","    @State private var store = ScreenStateStore<Article>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { article in","            ArticleDetailView(article: article)","        }","        .task(id: articleID) { await reload() }","    }","","    private func reload() async {","        await store.load { try await api.fetchArticle(id: articleID) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"navigationDestination(for:)","type":"codeVoice"},{"type":"text","text":" creates a fresh "},{"code":"ArticleDetailScreen","type":"codeVoice"},{"type":"text","text":" — and so a fresh store, starting at the default "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" — every time a row is tapped, so there’s no manual reset to write. "},{"code":".task(id: articleID)","type":"codeVoice"},{"type":"text","text":" (rather than a plain "},{"code":".task","type":"codeVoice"},{"type":"text","text":") is what makes this reusable in the next recipe below, where the same screen’s "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" can change "},{"type":"emphasis","inlineContent":[{"type":"text","text":"without"}]},{"type":"text","text":" the view itself being recreated."}]},{"type":"heading","text":"One Store per Tab","level":2,"anchor":"One-Store-per-Tab"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give each tab’s screen its own "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" store. "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" preserves each tab’s view identity across switches, so the store — and the "},{"code":".task","type":"codeVoice"},{"type":"text","text":" that loads it — is created once and lives for as long as the tab does, not recreated every time the user switches back to it:"}]},{"type":"codeListing","code":["struct RootTabView: View {","    var body: some View {","        TabView {","            ArticlesTab()","                .tabItem { Label(\"Articles\", systemImage: \"newspaper\") }","            ProfileTab()","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}","","struct ArticlesTab: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        NavigationStack {","            ScreenStateView(store.state, onRetry: reload) { articles in","                List(articles) { Text($0.title) }","            }","            .task { await reload() }","        }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Switching away from and back to a tab shows whatever "},{"code":"store.state","type":"codeVoice"},{"type":"text","text":" already holds — no flash back to "},{"code":".loading","type":"codeVoice"},{"type":"text","text":". If the data can go stale while another tab is active, wire up "},{"code":"refreshCollection(_:)","type":"codeVoice"},{"type":"text","text":" (see "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","isActive":true},{"type":"text","text":") instead of relying on the initial "},{"code":".task","type":"codeVoice"},{"type":"text","text":" alone."}]},{"type":"heading","text":"Master-Detail with NavigationSplitView","level":2,"anchor":"Master-Detail-with-NavigationSplitView"},{"type":"paragraph","inlineContent":[{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" shows the sidebar and detail columns side by side, so — unlike the pushed detail screen above — selecting a different row updates the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" detail view instance’s "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" rather than creating a new one. This is exactly why the detail screen from "},{"type":"strong","inlineContent":[{"type":"text","text":"List + Detail"}]},{"type":"text","text":" used "},{"code":".task(id: articleID)","type":"codeVoice"},{"type":"text","text":": it cancels and restarts the load whenever "},{"code":"articleID","type":"codeVoice"},{"type":"text","text":" changes, which a plain "},{"code":".task","type":"codeVoice"},{"type":"text","text":" would miss."}]},{"type":"codeListing","code":["struct ArticlesSplitView: View {","    @State private var listStore = ScreenStateStore<[Article]>()","    @State private var selection: Article.ID?","","    var body: some View {","        NavigationSplitView {","            ScreenStateView(listStore.state) { articles in","                List(articles, selection: $selection) { article in","                    Text(article.title).tag(article.id)","                }","            }","            .task { await listStore.loadCollection { try await api.fetchArticles() } }","        } detail: {","            if let selection {","                ArticleDetailScreen(articleID: selection) \/\/ reused as-is from List + Detail","            } else {","                ContentUnavailableView(\"Select an Article\", systemImage: \"newspaper\")","            }","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sidebar list and the detail content are still two independent stores, each following the same “one store, scoped to one screen” shape as the other two recipes — "},{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" only changes how they’re laid out, not how they’re driven."}]}]}],"hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates":{"url":"\/documentation\/screenstates","abstract":[{"text":"Give any screen a standard ","type":"text"},{"code":"Empty","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Loading","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Data"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" state, usable from both UIKit and SwiftUI."}],"title":"ScreenStates","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"},"doc://screenstates.ScreenStates/documentation/ScreenStates/G