{"metadata":{"roleHeading":"Article","modules":[{"name":"ScreenStates"}],"role":"article","title":"Getting Started with UIKit"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView"},{"type":"text","text":" is the UIKit counterpart to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"type":"text","text":": a "},{"code":"UIView","type":"codeVoice"},{"type":"text","text":" that swaps its content for the right placeholder based on a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":". Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView\/bind(to:)"},{"type":"text","text":" to keep it in sync with a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":"."}]},{"type":"codeListing","code":["import UIKit","import ScreenStates","","final class ArticlesViewController: UIViewController {","    private let store = ScreenStateStore<[Article]>()","    private lazy var container = ScreenStateContainerView<[Article]>(onRetry: { [weak self] in","        Task { await self?.reload() }","    }) { articles in","        let list = ArticleListView(articles: articles) \/\/ any UIView you build from `articles`","        return list","    }","","    override func viewDidLoad() {","        super.viewDidLoad()","        container.translatesAutoresizingMaskIntoConstraints = false","        view.addSubview(container)","        NSLayoutConstraint.activate([","            container.topAnchor.constraint(equalTo: view.topAnchor),","            container.bottomAnchor.constraint(equalTo: view.bottomAnchor),","            container.leadingAnchor.constraint(equalTo: view.leadingAnchor),","            container.trailingAnchor.constraint(equalTo: view.trailingAnchor)","        ])","        container.bind(to: store) \/\/ keeps container.state in sync with store.state","","        Task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"bind(to:)","type":"codeVoice"},{"type":"text","text":" uses "},{"code":"withObservationTracking","type":"codeVoice"},{"type":"text","text":" under the hood — the same Observation framework mechanism SwiftUI itself relies on — so the container re-renders automatically whenever "},{"code":"store.state","type":"codeVoice"},{"type":"text","text":" changes, with no Combine or "},{"code":"NotificationCenter","type":"codeVoice"},{"type":"text","text":" involved. Calling "},{"code":"bind(to:)","type":"codeVoice"},{"type":"text","text":" again with a different store (e.g. reusing a container across cells) immediately reflects the new store and stops reacting to the previous one."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A SwiftUI view can just read "},{"code":"store.isRefreshing","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"store.refreshError","type":"codeVoice"},{"type":"text","text":" directly — any property access inside its "},{"code":"body","type":"codeVoice"},{"type":"text","text":" is tracked automatically. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView"},{"type":"text","text":" has no "},{"code":"body","type":"codeVoice"},{"type":"text","text":" to do that in, so it reports both through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerViewDelegate"},{"type":"text","text":" instead:"}]},{"type":"codeListing","code":["container.delegate = self \/\/ conform to ScreenStateContainerViewDelegate","","func screenStateContainerViewDidUpdateIsRefreshing(_ isRefreshing: Bool) {","    refreshSpinner.isHidden = !isRefreshing","}","","func screenStateContainerViewDidUpdateRefreshError(_ error: Error?) {","    guard let error else { return }","    showToast(error.localizedDescription)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both methods have empty default implementations, so a conformer only needs whichever one it actually cares about. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController"},{"type":"text","text":" already conforms for you — override its "},{"code":"isRefreshingDidChange(_:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refreshErrorDidChange(_:)","type":"codeVoice"},{"type":"text","text":" (both "},{"code":"open","type":"codeVoice"},{"type":"text","text":", empty by default) instead of setting a delegate yourself."}]},{"anchor":"Pull-to-refresh","type":"heading","level":2,"text":"Pull-to-refresh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"code":"pullToRefresh","type":"codeVoice"},{"type":"text","text":" to wire up a "},{"code":"UIRefreshControl","type":"codeVoice"},{"type":"text","text":" automatically — it only takes effect when the "},{"code":".data","type":"codeVoice"},{"type":"text","text":" content view is a "},{"code":"UIScrollView","type":"codeVoice"},{"type":"text","text":" (or subclass, e.g. "},{"code":"UITableView","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"UICollectionView","type":"codeVoice"},{"type":"text","text":"), since pull-to-refresh has nothing to attach to otherwise:"}]},{"type":"codeListing","code":["private lazy var container = ScreenStateContainerView<[Article]>(","    onRetry: { [weak self] in Task { await self?.reload() } },","    pullToRefresh: { [weak self] in","        await self?.store.refreshCollection { try await api.fetchArticles() }","    }",") { articles in","    ArticlesTableView(articles: articles) \/\/ a UITableView subclass","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The refresh control’s spinning state stays in sync with "},{"code":"store.isRefreshing","type":"codeVoice"},{"type":"text","text":" regardless of what triggered a refresh — the pull gesture itself, or something else (e.g. a toolbar button) calling "},{"code":"refresh(_:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refreshCollection(_:)","type":"codeVoice"},{"type":"text","text":" directly — so it can’t get stuck showing or hiding incorrectly. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController"},{"type":"text","text":"’s built-in-placeholders initializer takes the same parameter."}]},{"type":"paragraph","inlineContent":[{"code":"UIRefreshControl","type":"codeVoice"},{"type":"text","text":" is unavailable on tvOS, so "},{"code":"pullToRefresh","type":"codeVoice"},{"type":"text","text":" is accepted there too (for a uniform API across platforms) but never takes effect."}]},{"anchor":"Skipping-the-boilerplate-with-ScreenStateViewController","type":"heading","level":2,"text":"Skipping the boilerplate with ScreenStateViewController"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every screen above repeats the same "},{"code":"viewDidLoad()","type":"codeVoice"},{"type":"text","text":" boilerplate: pin the container to the view’s edges, then bind it to the store. Subclass "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController"},{"type":"text","text":" instead