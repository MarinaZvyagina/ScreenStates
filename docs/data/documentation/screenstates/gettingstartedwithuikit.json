{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","isActive":true},{"type":"text","text":" is the UIKit counterpart to "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true},{"type":"text","text":": a "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" that swaps its content for the right placeholder based on a "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"type":"text","text":". Call "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView\/bind(to:)","isActive":true},{"type":"text","text":" to keep it in sync with a "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["import UIKit","import ScreenStates","","final class ArticlesViewController: UIViewController {","    private let store = ScreenStateStore<[Article]>()","    private lazy var container = ScreenStateContainerView<[Article]>(onRetry: { [weak self] in","        Task { await self?.reload() }","    }) { articles in","        let list = ArticleListView(articles: articles) \/\/ any UIView you build from `articles`","        return list","    }","","    override func viewDidLoad() {","        super.viewDidLoad()","        container.translatesAutoresizingMaskIntoConstraints = false","        view.addSubview(container)","        NSLayoutConstraint.activate([","            container.topAnchor.constraint(equalTo: view.topAnchor),","            container.bottomAnchor.constraint(equalTo: view.bottomAnchor),","            container.leadingAnchor.constraint(equalTo: view.leadingAnchor),","            container.trailingAnchor.constraint(equalTo: view.trailingAnchor)","        ])","        container.bind(to: store) \/\/ keeps container.state in sync with store.state","","        Task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"bind(to:)"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"withObservationTracking"},{"type":"text","text":" under the hood — the same Observation framework mechanism SwiftUI itself relies on — so the container re-renders automatically whenever "},{"type":"codeVoice","code":"store.state"},{"type":"text","text":" changes, with no Combine or "},{"code":"NotificationCenter","type":"codeVoice"},{"type":"text","text":" involved. Calling "},{"code":"bind(to:)","type":"codeVoice"},{"text":" again with a different store (e.g. reusing a container across cells) immediately reflects the new store and stops reacting to the previous one.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A SwiftUI view can just read "},{"type":"codeVoice","code":"store.isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"store.refreshError"},{"type":"text","text":" directly — any property access inside its "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is tracked automatically. "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","isActive":true},{"type":"text","text":" has no "},{"type":"codeVoice","code":"body"},{"type":"text","text":" to do that in, so it reports both through "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerViewDelegate","isActive":true},{"type":"text","text":" instead:"}]},{"type":"codeListing","code":["container.delegate = self \/\/ conform to ScreenStateContainerViewDelegate","","func screenStateContainerViewDidUpdateIsRefreshing(_ isRefreshing: Bool) {","    refreshSpinner.isHidden = !isRefreshing","}","","func screenStateContainerViewDidUpdateRefreshError(_ error: Error?) {","    guard let error else { return }","    showToast(error.localizedDescription)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both methods have empty default implementations, so a conformer only needs whichever one it actually cares about. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController"},{"type":"text","text":" already conforms for you — override its "},{"code":"isRefreshingDidChange(_:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refreshErrorDidChange(_:)","type":"codeVoice"},{"type":"text","text":" (both "},{"code":"open","type":"codeVoice"},{"type":"text","text":", empty by default) instead of setting a delegate yourself."}]},{"type":"heading","level":2,"text":"Skipping the boilerplate with ScreenStateViewController","anchor":"Skipping-the-boilerplate-with-ScreenStateViewController"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every screen above repeats the same "},{"type":"codeVoice","code":"viewDidLoad()"},{"type":"text","text":" boilerplate: pin the container to the view’s edges, then bind it to the store. Subclass "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController"},{"type":"text","text":" instead and it’s handled for you:"}]},{"type":"codeListing","code":["final class ArticlesViewController: ScreenStateViewController<[Article]> {","    private let articleStore: ScreenStateStore<[Article]>","","    init() {","        let store = ScreenStateStore<[Article]>()","        articleStore = store","        super.init(store: store, onRetry: { Task { await store.loadCollection { try await api.fetchArticles() } } }) { articles in","            ArticleListView(articles: articles)","        }","    }","","    override func viewDidLoad() {","        super.viewDidLoad()","        Task { await articleStore.loadCollection { try await api.fetchArticles() } }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"store","type":"codeVoice"},{"type":"text","text":" is exposed as a public property; the fully-customized-placeholders initializer is available too, mirroring "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","isActive":true},{"type":"text","text":"’s own two initializers."}]},{"level":2,"text":"Customizing the placeholders","type":"heading","anchor":"Customizing-the-placeholders"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"emptyView"},{"type":"text","text":", "},{"type":"codeVoice","code":"loadingView"},{"type":"text","text":", and an "},{"type":"codeVoice","code":"errorView"},{"type":"text","text":" builder to fully replace the defaults:"}]},{"type":"codeListing","syntax":"swift","code":["ScreenStateContainerView<[Article]>(","    emptyView: MyEmptyView(),","    loadingView: MyLoadingView(),","    errorView: { error in MyErrorView(error: error) },","    content: { articles in ArticleListView(articles: articles) }",")"]},{"inlineContent":[{"type":"text","text":"A fully custom placeholder like "},{"type":"codeVoice","code":"MyErrorView"},{"type":"text","text":" can still announce transitions to VoiceOver with the same wording the default placeholders use, via "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","c