nce","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController","isActive":true},{"type":"text","text":"’s built-in-placeholders initializer takes the same parameter."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"UIRefreshControl"},{"type":"text","text":" is unavailable on tvOS, so "},{"type":"codeVoice","code":"pullToRefresh"},{"type":"text","text":" is accepted there too (for a uniform API across platforms) but never takes effect."}],"type":"paragraph"},{"text":"Skipping the boilerplate with ScreenStateViewController","type":"heading","anchor":"Skipping-the-boilerplate-with-ScreenStateViewController","level":2},{"inlineContent":[{"type":"text","text":"Every screen above repeats the same "},{"type":"codeVoice","code":"viewDidLoad()"},{"type":"text","text":" boilerplate: pin the container to the view’s edges, then bind it to the store. Subclass "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController","isActive":true},{"type":"text","text":" instead and it’s handled for you:"}],"type":"paragraph"},{"type":"codeListing","code":["final class ArticlesViewController: ScreenStateViewController<[Article]> {","    private let articleStore: ScreenStateStore<[Article]>","","    init() {","        let store = ScreenStateStore<[Article]>()","        articleStore = store","        super.init(store: store, onRetry: { Task { await store.loadCollection { try await api.fetchArticles() } } }) { articles in","            ArticleListView(articles: articles)","        }","    }","","    override func viewDidLoad() {","        super.viewDidLoad()","        Task { await articleStore.loadCollection { try await api.fetchArticles() } }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"store"},{"type":"text","text":" is exposed as a public property; the fully-customized-placeholders initializer is available too, mirroring "},{"