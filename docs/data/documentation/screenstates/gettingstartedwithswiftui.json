hing-without-losing-data"},{"type":"paragraph","inlineContent":[{"code":"loadCollection(_:)","type":"codeVoice"},{"type":"text","text":" always shows "},{"code":".loading","type":"codeVoice"},{"text":" first, which is right for the initial fetch but wrong for pull-to-refresh — the list shouldn’t disappear behind a spinner while it’s being refetched. Use ","type":"text"},{"type":"codeVoice","code":"refreshCollection(_:)"},{"text":" instead: it keeps the current ","type":"text"},{"type":"codeVoice","code":".data"},{"text":" on screen while the operation runs, and leaves it there if the operation fails instead of switching to ","type":"text"},{"type":"codeVoice","code":".error"},{"text":":","type":"text"}]},{"code":["List(articles) { article in","    Text(article.title)","}",".refreshable {","    await store.refreshCollection { try await api.fetchArticles() }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"store.isRefreshing","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for the duration; a failure is reported via ","type":"text"},{"code":"store.refreshError","type":"codeVoice"},{"text":" rather than by discarding ","type":"text"},{"code":"state","type":"codeVoice"},{"text":", so the list stays visible and you can surface the error separately (a toast, for example).","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Retrying-on-failure","type":"heading","text":"Retrying on failure"},{"inlineContent":[{"type":"text","text":"For a flaky call worth retrying automatically before showing an error, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadWithRetry(maxAttempts:backoff:_:)"},{"type":"text","text":" instead of "},{"code":"loadCollection(_:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["await store.loadWithRetry(maxAttempts: 3) {","    try await api.fetchArticles()",