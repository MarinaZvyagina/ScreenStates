{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"anchor":"Related-Documentation"},{"title":"Essentials","identifiers":["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes","doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/SwiftUIAndUIKitEquivalents"],"generated":true,"anchor":"Essentials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/gettingstartedwithswiftui"]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Drive a SwiftUI screen’s four states with "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"type":"text","text":"."}],"kind":"article","identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","title":"Getting Started with SwiftUI","role":"article","modules":[{"name":"ScreenStates"}]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"text":" is an ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" class that owns a screen’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"text":" and knows how to run an async load. ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true},{"text":" switches on that state, rendering your content only for the ","type":"text"},{"type":"codeVoice","code":".data"},{"text":" case and a placeholder otherwise.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import ScreenStates","","struct ArticlesScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"store.loadCollection(_:)"},{"text":" sets ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":", runs the closure, and maps the outcome to ","type":"text"},{"type":"codeVoice","code":".data"},{"text":", ","type":"text"},{"type":"codeVoice","code":".empty"},{"text":" (when the result is an empty collection), or ","type":"text"},{"type":"codeVoice","code":".error"},{"text":". ","type":"text"},{"type":"codeVoice","code":"ScreenStateView"},{"text":" shows the default Loading spinner, Empty placeholder, or Error view — with a working Retry button wired to ","type":"text"},{"type":"codeVoice","code":"onRetry"},{"text":" — automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you’d rather not wrap the whole call site in an initializer, ","type":"text"},{"type":"codeVoice","code":".screenState(_:onRetry:secondaryAction:content:)"},{"text":" is the same thing as a view modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["EmptyView()","    .screenState(store.state, onRetry: reload) { articles in","        List(articles) { article in Text(article.title) }","    }"],"type":"codeListing"},{"level":2,"type":"heading","text":"Customizing the placeholders","anchor":"Customizing-the-placeholders"},{"inlineContent":[{"text":"Pass ","type":"text"},{"type":"codeVoice","code":"empty"},{"text":", ","type":"text"},{"type":"codeVoice","code":"loading"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"error"},{"text":" view builders to fully replace the defaults:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ScreenStateView(store.state) { articles in","    ArticleList(articles)","} empty: {","    ContentUnavailableView(\"No Articles Yet\", systemImage: \"newspaper\")","} loading: {","    ProgressView(\"Loading articles…\")","} error: { error in","    MyErrorBanner(error: error, retry: reload)","}"],"type":"codeListing"},{"inlineContent":[{"text":"A fully custom placeholder like ","type":"text"},{"type":"codeVoice","code":"MyErrorBanner"},{"text":" can still announce transitions to VoiceOver with the same wording the default placeholders use, via ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".onAppear {","    if let announcement = state.accessibilityAnnouncement {","        AccessibilityNotification.Announcement(announcement).post()","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"It’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" for ","type":"text"},{"type":"codeVoice","code":".data"},{"text":" — your own content is what VoiceOver should read at that point — and, for ","type":"text"},{"type":"codeVoice","code":".empty"},{"text":", it’s the default “Nothing Here” text; announce your own custom title directly instead if your placeholder shows one, so VoiceOver matches what’s on screen.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Refreshing without losing data","anchor":"Refreshing-without-losing-data"},{"inlineContent":[{"type":"codeVoice","code":"loadCollection(_:)"},{"text":" always shows ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":" first, which is right for the initial fetch but wrong for pull-to-refresh — the list shouldn’t disappear behind a spinner while it’s being refetched. Use ","type":"text"},{"type":"codeVoice","code":"refreshCollection(_:)"},{"text":" instead: it keeps the current ","type":"text"},{"type":"codeVoice","code":".data"},{"text":" on screen while the operation runs, and leaves it there if the operation fails instead of switching to ","type":"text"},{"type":"codeVoice","code":".error"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["List(articles) { article in","    Text(article.title)","}",".refreshable {","    await store.refreshCollection { try await api.fetchArticles() }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"store.isRefreshing"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" for the duration; a failure is reported via ","type":"text"},{"type":"codeVoice","code":"store.refreshError"},{"text":" rather than by discarding ","type":"text"},{"type":"codeVoice","code":"state"},{"text":", so the list stays visible and you can surface the error separately (a toast, for example).","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Retrying on failure","anchor":"Retrying-on-failure"},{"inlineContent":[{"text":"For a flaky call worth retrying automatically before showing an error, use ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadWithRetry(maxAttempts:backoff:_:)","isActive":true},{"text":" instead of ","type":"text"},{"type":"codeVoice","code":"loadCollection(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["await store.loadWithRetry(maxAttempts: 3) {","    try await api.fetchArticles()","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"state"},{"text":" stays ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":" across every attempt; only the final failure, once ","type":"text"},{"type":"codeVoice","code":"maxAttempts"},{"text":" is exhausted, switches it to ","type":"text"},{"type":"codeVoice","code":".error"},{"text":". ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" is called with the attempt number that just failed and returns how long to wait before the next try, defaulting to doubling from one second.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Overlapping calls are safe","anchor":"Overlapping-calls-are-safe"},{"inlineContent":[{"text":"Nothing extra is needed to handle a screen firing off a second ","type":"text"},{"type":"codeVoice","code":"loadCollection(_:)"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"refresh(_:)"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"loadWithRetry(_:)"},{"text":" call before an earlier one has finished — a fast double-tap on Retry, or a new query arriving before the previous one resolved. ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"text":" only ever applies the most recently started call’s result; a slower, now-stale response landing late is dropped instead of overwriting state a newer call already produced.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Cancelling an in-flight call","anchor":"Cancelling-an-in-flight-call"},{"inlineCon