{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" is an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" class that owns a screen’s "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"type":"text","text":" and knows how to run an async load. "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"type":"text","text":" switches on that state, rendering your content only for the "},{"type":"codeVoice","code":".data"},{"type":"text","text":" case and a placeholder otherwise."}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import ScreenStates","","struct ArticlesScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"store.loadCollection(_:)"},{"type":"text","text":" sets "},{"type":"codeVoice","code":".loading"},{"type":"text","text":", runs the closure, and maps the outcome to "},{"type":"codeVoice","code":".data"},{"type":"text","text":", "},{"type":"codeVoice","code":".empty"},{"type":"text","text":" (when the result is an empty collection), or "},{"type":"codeVoice","code":".error"},{"type":"text","text":". "},{"type":"codeVoice","code":"ScreenStateView"},{"type":"text","text":" shows the default Loading spinner, Empty placeholder, or Error view — with a working Retry button wired to "},{"type":"codeVoice","code":"onRetry"},{"type":"text","text":" — automatically."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you’d rather not wrap the whole call site in an initializer, "},{"type":"codeVoice","code":".screenState(_:onRetry:secondaryAction:content:)"},{"type":"text","text":" is the same thing as a view modifier:"}],"type":"paragraph"},{"syntax":"swift","code":["EmptyView()","    .screenState(store.state, onRetry: reload) { articles in","        List(articles) { article in Text(article.title) }","    }"],"type":"codeListing"},{"level":2,"text":"Customizing the placeholders","anchor":"Customizing-the-placeholders","type":"heading"},{"inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"empty"},{"type":"text","text":", "},{"type":"codeVoice","code":"loading"},{"type":"text","text":", and "},{"type":"codeVoice","code":"error"},{"type":"text","text":" view builders to fully replace the defaults:"}],"type":"paragraph"},{"syntax":"swift","code":["ScreenStateView(store.state) { articles in","    ArticleList(articles)","} empty: {","    ContentUnavailableView(\"No Articles Yet\", systemImage: \"newspaper\")","} loading: {","    ProgressView(\"Loading articles…\")","} error: { error in","    MyErrorBanner(error: error, retry: reload)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A fully custom placeholder like "},{"type":"codeVoice","code":"MyErrorBanner"},{"type":"text","text":" can still announce transitions to VoiceOver with the same wording the default placeholders use, via "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":[".onAppear {","    if let announcement = state.accessibilityAnnouncement {","        AccessibilityNotification.Announcement(announcement).post()","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"It’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for "},{"type":"codeVoice","code":".data"},{"type":"text","text":" — your own content is what VoiceOver should read at that point — and, for "},{"type":"codeVoice","code":".empty"},{"type":"text","text":", it’s the default “Nothing Here” text; announce your own custom title directly instead if your placeholder shows one, so VoiceOver matches what’s on screen."}],"type":"paragraph"},{"level":2,"text":"Refreshing without losing data","anchor":"Refreshing-without-losing-data","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":" always shows "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" first, which is right for the initial fetch but wrong for pull-to-refresh — the list shouldn’t disappear behind a spinner while it’s being refetched. Use "},{"type":"codeVoice","code":"refreshCollection(_:)"},{"type":"text","text":" instead: it keeps the current "},{"type":"codeVoice","code":".data"},{"type":"text","text":" on screen while the operation runs, and leaves it there if the operation fails instead of switching to "},{"type":"codeVoice","code":".error"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["List(articles) { article in","    Text(article.title)","}",".refreshable {","    await store.refreshCollection { try await api.fetchArticles() }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"store.isRefreshing"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for the duration; a failure is reported via "},{"type":"codeVoice","code":"store.refreshError"},{"type":"text","text":" rather than by discarding "},{"type":"codeVoice","code":"state"},{"type":"text","text":", so the list stays visible and you can surface the error separately (a toast, for example)."}],"type":"paragraph"},{"level":2,"text":"Retrying on failure","anchor":"Retrying-on-failure","type":"heading"},{"inlineContent":[{"type":"text","text":"For a flaky call worth retrying automatically before showing an error, use "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadWithRetry(maxAttempts:backoff:_:)","type":"reference","isActive":true},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["await store.loadWithRetry(maxAttempts: 3) {","    try await api.fetchArticles()","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"state"},{"type":"text","text":" stays "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" across every attempt; only the final failure, once "},{"type":"codeVoice","code":"maxAttempts"},{"type":"text","text":" is exhausted, switches it to "},{"type":"codeVoice","code":".error"},{"type":"text","text":". "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" is called with the attempt number that just failed and returns how long to wait before the next try, defaulting to doubling from one second."}],"type":"paragraph"},{"level":2,"text":"Overlapping calls are safe","anchor":"Overlapping-calls-are-safe","type":"heading"},{"inlineContent":[{"type":"text","text":"Nothing extra is needed to handle a screen firing off a second "},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadWithRetry(_:)"},{"type":"text","text":" call before an earlier one has finished — a fast double-tap on Retry, or a new query arriving before the previous one resolved. "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" only ever applies the most recently started call’s result; a slower, now-stale response landing late is dropped instead of overwriting state a newer call already produced."}],"type":"paragraph"},{"level":2,"text":"Cancelling an in-flight call","anchor":"Cancelling-an-in-flight-call","type":"heading"},{"inlineContent":[{"type":"text","text":"Call "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","type":"reference","isActive":true},{"type":"text","text":" to stop whatever call is currently running, without waiting for it to resolve — useful from "},{"type":"codeVoice","code":"onDisappear"},{"type":"text","text":", or right before firing off a newer query:"}],"type":"paragraph"},{"syntax":"swift","code":["store.cancel()"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"state"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":") are left exactly as they were; cancelling never surfaces a "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" through "},{"type":"codeVoice","code":"state"},{"type":"text","text":" the way letting "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" itself fail would. If nothing is in flight, "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" does nothing."}],"type":"paragraph"},{"level":2,"text":"Resetting a store","anchor":"Resetting-a-store","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)","type":"reference","isActive":true},{"type":"text","text":" snaps a store back to "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" (or any state you give it) outside of a "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" call — useful for a full sign-out\/reset flow, where whatever the store was showing or fetching no longer applies:"}],"type":"paragraph"},{"syntax":"swift","code":["store.reset() \/\/ back to .loading, as if freshly created","store.reset(to: .empty) \/\/ or straight to a specific state"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"It cancels whatever operation is currently in flight, the same as "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","type":"reference","isActive":true},{"type":"text","text":", and clears "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":", so nothing stale can land and overwrite "},{"type":"codeVoice","code":"state"},{"type":"text","text":" after the reset."}],"type":"paragraph"},{"level":2,"text":"Previewing a screen in a specific state","anchor":"Previewing-a-screen-in-a-specific-state","type":"heading"},{"inlineContent":[{"type":"text","text":"Give a preview-friendly screen its store via "},{"type":"codeVoice","code":"init"},{"type":"text","text":" instead of owning it in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", and pin that store to one state with a "},{"type":"codeVoice","code":"preview"},{"type":"text","text":"-prefixed factory instead of driving it through a real "},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":" call:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ArticlesScreen: View {","    let store: ScreenStateStore<[Article]>","","    var body: some View {","        ScreenStateView(store.state) { articles in","            List(articles) { Text($0.title) }","        }","    }","}","","#Preview(\"Empty\") {","    ArticlesScreen(store: .previewEmpty)","}","#Preview(\"Error\") {","    ArticlesScreen(store: .previewError(\"Couldn't reach the server\"))","}"],"type":"codeListing"},{"inli