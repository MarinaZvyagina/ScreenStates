","type":"text"}]},{"syntax":"swift","code":["EmptyView()","    .screenState(store.state, onRetry: reload) { articles in","        List(articles) { article in Text(article.title) }","    }"],"type":"codeListing"},{"anchor":"Customizing-the-placeholders","level":2,"text":"Customizing the placeholders","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"empty","type":"codeVoice"},{"text":", ","type":"text"},{"code":"loading","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" view builders to fully replace the defaults:","type":"text"}]},{"code":["ScreenStateView(store.state) { articles in","    ArticleList(articles)","} empty: {","    ContentUnavailableView(\"No Articles Yet\", systemImage: \"newspaper\")","} loading: {","    ProgressView(\"Loading articles…\")","} error: { error in","    MyErrorBanner(error: error, retry: reload)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A fully custom placeholder like ","type":"text"},{"code":"MyErrorBanner","type":"codeVoice"},{"text":" can still announce transitions to VoiceOver with the same wording the default placeholders use, via ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement","type":"reference","isActive":true},{"text":":","type":"text"}]},{"code":[".onAppear {","    if let announcement = state.accessibilityAnnouncement {","        AccessibilityNotification.Announcement(announcement).post()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"It’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" — your own content is what VoiceOver should read at that point — and, for ","type":"text"},{"code":".empty","type":"codeVoice"},{"text":", it’s the default “Nothing Here” text; announce yo