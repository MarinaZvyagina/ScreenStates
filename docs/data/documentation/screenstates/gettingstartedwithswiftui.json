{"abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true},{"type":"text","text":"."}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" is an ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" class that owns a screen’s ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":" and knows how to run an async load. ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"text":" switches on that state, rendering your content only for the ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" case and a placeholder otherwise.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import ScreenStates","","struct ArticlesScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"]},{"inlineContent":[{"code":"store.loadCollection(_:)","type":"codeVoice"},{"text":" sets ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":", runs the closure, and maps the outcome to ","type":"text"},{"code":".data","type":"codeVoice"},{"text":", ","type":"text"},{"code":".empty","type":"codeVoice"},{"text":" (when the result is an empty collection), or ","type":"text"},{"code":".error","type":"codeVoice"},{"text":". ","type":"text"},{"code":"ScreenStateView","type":"codeVoice"},{"text":" shows the default Loading spinner, Empty placeholder, or Error view — with a working Retry button wired to ","type":"text"},{"code":"onRetry","type":"codeVoice"},{"text":" — automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you’d rather not wrap the whole call site in an initializer, ","type":"text"},{"code":".screenState(_:onRetry:secondaryAction:content:)","type":"codeVoice"},{"text":" is the same thing as a view modifier:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["EmptyView()","    .screenState(store.state, onRetry: reload) { articles in","        List(articles) { article in Text(article.title) }","    }"]},{"type":"heading","level":2,"anchor":"Customizing-the-placeholders","text":"Customizing the placeholders"},{"inlineContent":[{"text":"Pass ","type":"text"},{"code":"empty","type":"codeVoice"},{"text":", ","type":"text"},{"code":"loading","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" view builders to fully replace the defaults:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["ScreenStateView(store.state) { articles in","    ArticleList(articles)","} empty: {","    ContentUnavailableView(\"No Articles Yet\", systemImage: \"newspaper\")","} loading: {","    ProgressView(\"Loading articles…\")","} error: { error in","    MyErrorBanner(error: error, retry: reload)","}"]},{"inlineContent":[{"text":"A fully custom placeholder like ","type":"text"},{"code":"MyErrorBanner","type":"codeVoice"},{"text":" can still announce transitions to VoiceOver with the same wording the default placeholders use, via ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".onAppear {","    if let announcement = state.accessibilityAnnouncement {","        AccessibilityNotification.Announcement(announcement).post()","    }","}"]},{"inlineContent":[{"text":"It’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" — your own content is what VoiceOver should read at that point — and, for ","type":"text"},{"code":".empty","type":"codeVoice"},{"text":", it’s the default “Nothing Here” text; announce your own custom title directly instead if your placeholder shows one, so VoiceOver matches what’s on screen.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Refreshing-without-losing-data","text":"Refreshing without losing data"},{"inlineContent":[{"code":"loadCollection(_:)","type":"codeVoice"},{"text":" always shows ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" first, which is right for the initial fetch but wrong for pull-to-refresh — the list shouldn’t disappear behind a spinner while it’s being refetched. Use ","type":"text"},{"code":"refreshCollection(_:)","type":"codeVoice"},{"text":" instead: it keeps the current ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" on screen while the operation runs, and leaves it there if the operation fails instead of switching to ","type":"text"},{"code":".error","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["List(articles) { article in","    Text(article.title)","}",".refreshable {","    await store.refreshCollection { try await api.fetchArticles() }","}"]},{"inlineContent":[{"code":"store.isRefreshing","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for the duration; a failure is reported via ","type":"text"},{"code":"store.refreshError","type":"codeVoice"},{"text":" rather than by discarding ","type":"text"},{"code":"state","type":"codeVoice"},{"text":", so the list stays visible and you can surface the error separately (a toast, for example).","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Retrying-on-failure","text":"Retrying on failure"},{"inlineContent":[{"text":"For a flaky call worth retrying automatically before showing an error, use ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadWithRetry(maxAttempts:backoff:_:)","isActive":true,"type":"reference"},{"text":" instead of ","type":"text"},{"code":"loadCollection(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["await store.loadWithRetry(maxAttempts: 3) {","    try await api.fetchArticles()","}"]},{"inlineContent":[{"code":"state","type":"codeVoice"},{"text":" stays ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" across every attempt; only the final failure, once ","type":"text"},{"code":"maxAttempts","type":"codeVoice"},{"text":" is exhausted, switches it to ","type":"text"},{"code":".error","type":"codeVoice"},{"text":". ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" is called with the attempt number that just failed and returns how long to wait before the next try, defaulting to doubling from one second.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Overlapping-calls-are-safe","text":"Overlapping calls are safe"},{"inlineContent":[{"text":"Nothing extra is needed to handle a screen firing off a second ","type":"text"},{"code":"loadCollection(_:)","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refresh(_:)","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"loadWithRetry(_:)","type":"codeVoice"},{"text":" call before an earlier one has finished — a fast double-tap on Retry, or a new query arriving before the previous one resolved. ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" only ever applies the most recently started call’s result; a slower, now-stale response landing late is dropped instead of overwriting state a newer call already produced.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Cancelling-an-in-flight-call","text":"Cancelling an in-flight call"},{"inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","isActive":true,"type":"reference"},{"text":" to stop whatever call is currently running, without waiting for it to resolve — useful from ","type":"text"},{"code":"onDisappear","type":"codeVoice"},{"text":", or right before firing off a newer query:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["store.cancel()"]},{"inlineContent":[{"code":"state","type":"codeVoice"},{"text":" (and ","type":"text"},{"code":"isRefreshing","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refreshError","type":"codeVoice"},{"text":") are left exactly as they were; cancelling never surfaces a ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" the way letting ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" itself fail would. If nothing is in flight, ","type":"text"},{"code":"cancel()","type":"codeVoice"},{"text":" does nothing.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Resetting-a-store","text":"Resetting a store"},{"i