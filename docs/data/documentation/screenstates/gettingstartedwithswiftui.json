so a preview doesn’t need a placeholder "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" type of its own. "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/preview(_:)","isActive":true},{"type":"text","text":" accepts any "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true},{"type":"text","text":" directly for anything the named helpers don’t cover."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/gettingstartedwithswiftui"]}],"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/preview(_:)":{"url":"\/documentation\/screenstates\/screenstatestore\/preview(_:)","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/preview(_:)","title":"preview(_:)","role":"symbol","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preview","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:12ScreenStates0A5StateO","text":"ScreenState","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:12ScreenStates0A10StateStoreC5Valuexmfp","text":"Value","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:12ScreenStates0A10StateStoreC","text":"ScreenStateStore","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:12ScreenStates0A10StateStoreC5Valuexmfp","text":"Value","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"A store pinned to ","type":"text"},{"type":"codeVoice","code":"state"},{"text":", never transitioning on its own.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStatePreviewError":{"n