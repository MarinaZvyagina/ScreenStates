tUnavailableView(\"No Articles Yet\", systemImage: \"newspaper\")","} loading: {","    ProgressView(\"Loading articles…\")","} error: { error in","    MyErrorBanner(error: error, retry: reload)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A fully custom placeholder like ","type":"text"},{"code":"MyErrorBanner","type":"codeVoice"},{"text":" can still announce transitions to VoiceOver with the same wording the default placeholders use, via ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement"},{"text":":","type":"text"}]},{"syntax":"swift","code":[".onAppear {","    if let announcement = state.accessibilityAnnouncement {","        AccessibilityNotification.Announcement(announcement).post()","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"It’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" — your own content is what VoiceOver should read at that point — and, for ","type":"text"},{"code":".empty","type":"codeVoice"},{"text":", it’s the default “Nothing Here” text; announce your own custom title directly instead if your placeholder shows one, so VoiceOver matches what’s on screen.","type":"text"}]},{"level":2,"type":"heading","text":"Refreshing without losing data","anchor":"Refreshing-without-losing-data"},{"type":"paragraph","inlineContent":[{"code":"loadCollection(_:)","type":"codeVoice"},{"text":" always shows ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" first, which is right for the initial fetch but wrong for pull-to-refresh — the list shouldn’t disappear behind a spinner while it’s being refetched. Use ","type":"text"},{"code":"refreshCollection(_:)","type":"codeVoice"},{"text":" instead: it keeps the current ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" on screen while t