{"variants":[{"paths":["\/documentation\/screenstates\/gettingstartedwithswiftui"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Drive a SwiftUI screen’s four states with "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"type":"text","text":"."}],"metadata":{"roleHeading":"Article","role":"article","title":"Getting Started with SwiftUI","modules":[{"name":"ScreenStates"}]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" is an ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" class that owns a screen’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"text":" and knows how to run an async load. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":" switches on that state, rendering your content only for the ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" case and a placeholder otherwise.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import ScreenStates","","struct ArticlesScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"store.loadCollection(_:)","type":"codeVoice"},{"text":" sets ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":", runs the closure, and maps the outcome to ","type":"text"},{"code":".data","type":"codeVoice"},{"text":", ","type":"text"},{"code":".empty","type":"codeVoice"},{"text":" (when the result is an empty collection), or ","type":"text"},{"code":".error","type":"codeVoice"},{"text":". ","type":"text"},{"code":"ScreenStateView","type":"codeVoice"},{"text":" shows the default Loading spinner, Empty placeholder, or Error view — with a working Retry button wired to ","type":"text"},{"code":"onRetry","type":"codeVoice"},{"text":" — automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you’d rather not wrap the whole call site in an initializer, ","type":"text"},{"code":".screenState(_:onRetry:secondaryAction:content:)","type":"codeVoice"},{"text":" is the same thing as a view modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["EmptyView()","    .screenState(store.state, onRetry: reload) { articles in","        List(articles) { article in Text(article.title) }","    }"],"type":"codeListing"},{"level":2,"type":"heading","text":"Customizing the placeholders","anchor":"Customizing-the-placeholders"},{"inlineContent":[{"text":"Pass ","type":"text"},{"code":"empty","type":"codeVoice"},{"text":", ","type":"text"},{"code":"loading","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" view builders to fully replace the defaults:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ScreenStateView(store.state) { articles in","    ArticleList(articles)","} empty: {","    ContentUnavailableView(\"No Articles Yet\", systemImage: \"newspaper\")","} loading: {","    ProgressView(\"Loading articles…\")","} error: { error in","    MyErrorBanner(error: error, retry: reload)","}"],"type":"codeListing"},{"inlineContent":[{"text":"A fully custom placeholder like ","type":"text"},{"code":"MyErrorBanner","type":"codeVoice"},{"text":" can still announce transitions to VoiceOver with the same wording the default placeholders use, via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".onAppear {","    if let announcement = state.accessibilityAnnouncement {","        AccessibilityNotification.Announcement(announcement).post()","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"It’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" — your own content is what VoiceOver should read at that point — and, for ","type":"text"},{"code":".empty","type":"codeVoice"},{"text":", it’s the default “Nothing Here” text; announce your own custom title directly instead if your placeholder shows one, so VoiceOver matches what’s on screen.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Refreshing without losing data","anchor":"Refreshing-without-losing-data"},{"inlineContent":[{"code":"loadCollection(_:)","type":"codeVoice"},{"text":" always shows ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" first, which is right for the initial fetch but wrong for pull-to-refresh — the list shouldn’t disappear behind a spinner while it’s being refetched. Use ","type":"text"},{"code":"refreshCollection(_:)","type":"codeVoice"},{"text":" instead: it keeps the current ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" on screen while the operation runs, and leaves it there if the operation fails instead of switching to ","type":"text"},{"code":".error","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["List(articles) { article in","    Text(article.title)","}",".refreshable {","    await store.refreshCollection { try await api.fetchArticles() }","}"],"type":"codeListing"},{"inlineContent":[{"code":"store.isRefreshing","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for the duration; a failure is reported via ","type":"text"},{"code":"store.refreshError","type":"codeVoice"},{"text":" rather than by discarding ","type":"text"},{"code":"state","type":"codeVoice"},{"text":", so the list stays visible and you can surface the error separately (a toast, for example).","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Retrying on failure","anchor":"Retrying-on-failure"},{"inlineContent":[{"type":"text","text":"For a flaky call worth retrying automatically before showing an error, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadWithRetry(maxAttempts:backoff:_:)"},{"text":" instead of ","type":"text"},{"code":"loadCollection(_:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["await store.loadWithRetry(maxAttempts: 3) {","    try await api.fetchArticles()","}"],"type":"codeListing"},{"inlineContent":[{"code":"state","type":"codeVoice"},{"type":"text","text":" stays "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" across every attempt; only the final failure, once "},{"code":"maxAttempts","type":"codeVoice"},{"type":"text","text":" is exhausted, switches it to "},{"code":".error","type":"codeVoice"},{"type":"text","text":". "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" is called with the attempt number that just failed and returns how long to wait before the next try, defaulting to doubling from one second."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Overlapping calls are safe","anchor":"Overlapping-calls-are-safe"},{"inlineContent":[{"type":"text","text":"Nothing extra is needed to handle a screen firing off a second "},{"code":"loadCollection(_:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refresh(_:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"loadWithRetry(_:)","type":"codeVoice"},{"type":"text","text":" call before an earlier one has finished — a fast double-tap on Retry, or a new query arriving before the previous one resolved. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" only ever applies the most recently started call’s result; a slower, now-stale response landing late is dropped instead of overwriting state a newer call already produced."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Cancelling an in-flight call","anchor":"Cancelling-an-in-flight-call"},{"inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()"},{"type":"text","text":" to stop whatever call is currently running, without waiting for it to resolve — useful from "},{"code":"onDisappear","type":"codeVoice"},{"type":"text","text":", or right before firing off a newer query:"}],"type":"paragraph"},{"syntax":"swift","code":["store.cancel()"],"type":"codeListing"},{"inlineContent":[{"code":"state","type":"codeVoice"},{"type":"text","text":" (and "},{"code":"isRefreshing","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refreshError","type":"codeVoice"},{"type":"text","text":") are left exactly as they were; cancelling never surfaces a "},{"code":"CancellationError","type":"codeVoice"},{"type":"text","text":" through "},{"code":"state","type":"codeVoice"},{"type":"text","text":" the way letting "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" itself fail would. If nothing is in flight, "},{"code":"cancel()","type":"codeVoice"},{"type":"text","text":" does nothing."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Resetting a store","anchor":"Resetting-a-store"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)"},{"type":"text","text":" snaps a store back to "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" (or any state you give it) outside of a "},{"code":"load","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refresh","type":"codeVoice"},{"type":"text","text":" call — useful for a full sign-out\/reset flow, where whatever the store was showing or fetching no longer applies:"}],"type":"paragraph"},{"syntax":"swift","code":["store.reset() \/\/ back to .loading, as if freshly created","store.reset(to: .empty) \/\/ or straight to a specific state"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"It cancels whatever operation is currently in flight, the same as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()"},{"type":"text","text":", and clears "},{"code":"isRefreshing","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refreshError","type":"codeVoice"},{"type":"text","text":", so nothing stale can land and overwrite "},{"code":"state","type":"codeVoice"},{"type":"text","text":" after the reset."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Previewing a screen in a specific state","anchor":"Previewing-a-screen-in-a-specific-state"},{"inlineContent":[{"type":"text","text":"Give a preview-friendly screen its store via "},{"code":"init","type":"codeVoice"},{"type":"text","text":" instead of owning it in "},{"code":"@State","type":"codeVoice"},{"type":"tex