mentation\/ScreenStates\/ScreenStateView","isActive":true},{"type":"text","text":" switches on that state, rendering your content only for the "},{"code":".data","type":"codeVoice"},{"type":"text","text":" case and a placeholder otherwise."}]},{"code":["import SwiftUI","import ScreenStates","","struct ArticlesScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"store.loadCollection(_:)"},{"text":" sets ","type":"text"},{"type":"codeVoice","code":".loading"},{"text":", runs the closure, and maps the outcome to ","type":"text"},{"type":"codeVoice","code":".data"},{"type":"text","text":", "},{"code":".empty","type":"codeVoice"},{"type":"text","text":" (when the result is an empty collection), or "},{"code":".error","type":"codeVoice"},{"type":"text","text":". "},{"code":"ScreenStateView","type":"codeVoice"},{"type":"text","text":" shows the default Loading spinner, Empty placeholder, or Error view — with a working Retry button wired to "},{"code":"onRetry","type":"codeVoice"},{"type":"text","text":" — automatically."}]},{"type":"paragraph","inlineContent":[{"text":"If you’d rather not wrap the whole call site in an initializer, ","type":"text"},{"type":"codeVoice","code":".screenState(_:onRetry:secondaryAction:content:)"},{"text":" is the same thing as a view modifier:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["EmptyView()","    .screenState(store.state, onRetry: reload) { articles in","        List(articles) { article in Text(article.title) }","    }