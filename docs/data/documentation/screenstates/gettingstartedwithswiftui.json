odeVoice","code":"@Observable"},{"type":"text","text":" class that owns a screen’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":" and knows how to run an async load. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"type":"text","text":" switches on that state, rendering your content only for the "},{"type":"codeVoice","code":".data"},{"type":"text","text":" case and a placeholder otherwise."}]},{"code":["import SwiftUI","import ScreenStates","","struct ArticlesScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"store.loadCollection(_:)"},{"type":"text","text":" sets "},{"type":"codeVoice","code":".loading"},{"type":"text","text":", runs the closure, and maps the outcome to "},{"type":"codeVoice","code":".data"},{"type":"text","text":", "},{"type":"codeVoice","code":".empty"},{"type":"text","text":" (when the result is an empty collection), or "},{"type":"codeVoice","code":".error"},{"type":"text","text":". "},{"type":"codeVoice","code":"ScreenStateView"},{"type":"text","text":" shows the default Loading spinner, Empty placeholder, or Error view — with a working Retry button wired to "},{"type":"codeVoice","code":"onRetry"},{"type":"text","text":" — automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’d rather not wrap the whole call site in an i