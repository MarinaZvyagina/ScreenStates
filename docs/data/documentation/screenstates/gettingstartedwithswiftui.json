:)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["await store.loadWithRetry(maxAttempts: 3) {","    try await api.fetchArticles()","}"]},{"inlineContent":[{"type":"codeVoice","code":"state"},{"type":"text","text":" stays "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" across every attempt; only the final failure, once "},{"type":"codeVoice","code":"maxAttempts"},{"type":"text","text":" is exhausted, switches it to "},{"type":"codeVoice","code":".error"},{"type":"text","text":". "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" is called with the attempt number that just failed and returns how long to wait before the next try, defaulting to doubling from one second."}],"type":"paragraph"},{"level":2,"anchor":"Overlapping-calls-are-safe","type":"heading","text":"Overlapping calls are safe"},{"inlineContent":[{"type":"text","text":"Nothing extra is needed to handle a screen firing off a second "},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh(_:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"loadWithRetry(_:)"},{"type":"text","text":" call before an earlier one has finished — a fast double-tap on Retry, or a new query arriving before the previous one resolved. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" only ever applies the most recently started call’s result; a slower, now-stale response landing late is dropped instead of overwriting state a newer call already produced."}],"type":"paragraph"},{"level":2,"anchor":"Cancelling-an-in-flight-call","type":"heading","text":"Cancelling an in-flight call"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()"},{"type":"text","text":" to stop whatever call is currently running, without waiting for it to resolve — useful from "},{"type":"codeVoice","code":"onDisappear"},{"type":"text","text":", or right before firing off a newer query:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["store.cancel()"]},{"inlineContent":[{"type":"codeVoice","code":"state"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":") are left exactly as they were; cancelling never surfaces a "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" through "},{"type":"codeVoice","code":"state"},{"type":"text","text":" the way letting "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" itself fail would. If nothing is in flight, "},{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" does nothing."}],"type":"paragraph"},{"level":2,"anchor":"Resetting-a-store","type":"heading","text":"Resetting a store"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)"},{"type":"text","text":" snaps a store back to "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" (or any state you give it) outside of a "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" call — useful for a full sign-out\/reset flow, where whatever the store was showing or fetching no longer applies:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["store.reset() \/\/ back to .loading, as if freshly created","store.reset(to: .empty) \/\/ or straight to a specific state"]},{"inlineContent":[{"type":"text","text":"It cancels whatever operation is currently in flight, the same as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()"},{"type":"text","text":", and clears "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":", so nothing stale can land and overwrite "},{"type":"codeVoice","code":"state"},{"type":"text","text":" after the reset."}],"type":"paragraph"},{"type":"heading","text":"Previewing a screen in a specific state","anchor":"Previewing-a-screen-in-a-specific-state","level":2},{"inlineContent":[{"type":"text","text":"Give a preview-friendly screen its store via "},{"code":"init","type":"codeVoice"},{"type":"text","text":" instead of owning it in "},{"code":"@State","type":"codeVoice"},{"type":"text","text":", and pin that store to one state with a "},{"code":"preview","type":"codeVoice"},{"type":"text","text":"-prefixed factory instead of driving it through a real "},{"code":"loadCollection(_:)","type":"codeVoice"},{"type":"text","text":" call:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ArticlesScreen: View {","    let store: ScreenStateStore<[Article]>","","    var body: some View {","        ScreenStateView(store.state) { articles in","            List(articles) { Text($0.title) }","        }","    }","}","","#Preview(\"Empty\") {","    ArticlesScreen(store: .previewEmpty)","}","#Preview(\"Error\") {","    ArticlesScreen(store: .previewError(\"Couldn't reach the server\"))","}"]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/previewError(_:)","isActive":true},{"type":"text","text":" uses a built-in "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStatePreviewError","isActive":true,"type":"reference"},{"type":"text","text":" so a preview doesn’t need a placeholder "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" type of its own. "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/preview(_:)","isActive":true,"type":"reference"},{"type":"text","text":" accepts any "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"type":"text","text":" directly for anything the named helpers don’t cover."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/gettingstartedwithswiftui"]}],"sections":[],"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","interfaceLanguage":"swift"},"references":{"doc://screenstates.ScreenStates/documentation/ScreenStates/Recipes":{"kind":"article","url":"\/documentation\/screenstates\/recipes","abstract":[{"type":"text","text":"Common multi-screen patterns built on "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true},{"type":"text","text":"."}],"title":"Recipes","role":"article","type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Recipes"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore/cancel()":{"kind":"symbol","url":"\/documentation\/screenstates\/screenstatestore\/cancel()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"text":"Cancels whatever ","type":"text"},{"code":"load","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"loadCollection","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refresh","type":"codeVoice"},{"text":"\/","type":"text"},{"text":" ","type":"text"},{"code":"refreshCollection","type":"cod