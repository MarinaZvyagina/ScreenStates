{"identifier":{"url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"text":".","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates"]]},"metadata":{"role":"article","title":"Getting Started with SwiftUI","modules":[{"name":"ScreenStates"}],"roleHeading":"Article"},"variants":[{"paths":["\/documentation\/screenstates\/gettingstartedwithswiftui"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"type":"text","text":" is an "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" class that owns a screen’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":" and knows how to run an async load. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"type":"text","text":" switches on that state, rendering your content only for the "},{"code":".data","type":"codeVoice"},{"type":"text","text":" case and a placeholder otherwise."}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import ScreenStates","","struct ArticlesScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"store.loadCollection(_:)"},{"type":"text","text":" sets "},{"type":"codeVoice","code":".loading"},{"type":"text","text":", runs the closure, and maps the outcome to "},{"type":"codeVoice","code":".data"},{"type":"text","text":", "},{"type":"codeVoice","code":".empty"},{"type":"text","text":" (when the result is an empty collection), or "},{"type":"codeVoice","code":".error"},{"type":"text","text":". "},{"code":"ScreenStateView","type":"codeVoice"},{"text":" shows the default Loading spinner, Empty placeholder, or Error view — with a working Retry button wired to ","type":"text"},{"code":"onRetry","type":"codeVoice"},{"text":" — automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’d rather not wrap the whole call site in an initializer, "},{"type":"codeVoice","code":".screenState(_:onRetry:secondaryAction:content:)"},{"type":"text","text":" is the same thing as a view modifier:"}]},{"type":"codeListing","code":["EmptyView()","    .screenState(store.state, onRetry: reload) { articles in","        List(articles) { article in Text(article.title) }","    }"],"syntax":"swift"},{"level":2,"anchor":"Customizing-the-placeholders","type":"heading","text":"Customizing the placeholders"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"code":"empty","type":"codeVoice"},{"type":"text","text":", "},{"code":"loading","type":"codeVoice"},{"type":"text","text":", and "},{"code":"error","type":"codeVoice"},{"type":"text","text":" view builders to fully replace the defaults:"}]},{"type":"codeListing","code":["ScreenStateView(store.state) { articles in","    ArticleList(articles)","} empty: {","    ContentUnavailableView(\"No Articles Yet\", systemImage: \"newspaper\")","} loading: {","    ProgressView(\"Loading articles…\")","} error: { error in","    MyErrorBanner(error: error, retry: reload)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A fully custom placeholder like ","type":"text"},{"code":"MyErrorBanner","type":"codeVoice"},{"text":" can still announce transitions to VoiceOver with the same wording the default placeholders use, via ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":[".onAppear {","    if let announcement = state.accessibilityAnnouncement {","        AccessibilityNotification.Announcement(announcement).post()","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for "},{"code":".data","type":"codeVoice"},{"type":"text","text":" — your own content is what VoiceOver should read at that point — and, for "},{"code":".empty","type":"codeVoice"},{"type":"text","text":", it’s the default “Nothing Here” text; announce your own custom title directly instead if your placeholder shows one, so VoiceOver matches what’s on screen."}]},{"text":"Refreshing without losing data","type":"heading","anchor":"Refreshing-without-losing-data","level":2},{"type":"paragraph","inlineContent":[{"code":"loadCollection(_:)","type":"codeVoice"},{"text":" always shows ","type":"text"},{"code":".loading","type":"codeVoice"},{"text":" first, which is right for the initial fetch but wrong for pull-to-refresh — the list shouldn’t disappear behind a spinner while it’s being refetched. Use ","type":"text"},{"code":"refreshCollection(_:)","type":"codeVoice"},{"text":" instead: it keeps the current ","type":"text"},{"code":".data","type":"codeVoice"},{"text":" on screen while the operation runs, and leaves it there if the operation fails instead of switching to ","type":"text"},{"code":".error","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["List(articles) { article in","    Text(article.title)","}",".refreshable {","    await store.refreshCollection { try await api.fetchArticles() }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"store.isRefreshing","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for the duration; a failure is reported via "},{"code":"store.refreshError","type":"codeVoice"},{"type":"text","text":" rather than by discarding "},{"code":"state","type":"codeVoice"},{"type":"text","text":", so the list stays visible and you can surface the error separately (a toast, for example)."}]},{"text":"Retrying on failure","type":"heading","anchor":"Retrying-on-failure","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a flaky call worth retrying automatically before showing an error, use "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadWithRetry(maxAttempts:backoff:_:)","type":"reference","isActive":true},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"loadCollection(_:)"},{"type":"text","text":":"}]},{"code":["await store.loadWithRetry(maxAttempts: 3) {","    try await api.fetchArticles()","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"state","type":"codeVoice"},{"text":" stays ","type":"text"},{"code":".loading","type":"codeVoice"},{"type":"text","text":" across every attempt; only the final failure, once "},{"type":"codeVoice","code":"maxAttempts"},{"type":"text","text":" is exhausted, switches it to "},{"code":".error","type":"codeVoice"},{"text":". ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" is called with the attempt number that just failed and returns how long to wait before the next try, defaulting to doubling from one second.","type":"text"}]},{"level":2,"type":"heading","anchor":"Overlapping-calls-are-safe","text":"Overlapping calls are safe"},{"type":"paragraph","inlineContent":[{"text":"Nothing extra is needed to handle a screen firing off a second ","type":"text"},{"code":"loadCollection(_:)","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"refresh(_:)","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"loadWithRetry(_:)","type":"codeVoice"},{"text":" call before an earlier one has finished — a fast double-tap on Retry, or a new query arriving before the previous one resolved. ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" only ever applies the most recently started call’s result; a slower, now-stale response landing late is dropped instead of overwriting state a newer call already produced.","type":"text"}]},{"level":2,"type":"heading","anchor":"Cancelling-an-in-flight-call","text":"Cancelling an in-flight call"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","isActive":true,"type":"reference"},{"text":" to stop whatever call is currently running, without waiting for it to resolve — useful from ","type":"text"},{"code":"onDisappear","type":"codeVoice"},{"text":", or right before firing off a newer query:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["store.cancel()"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"state"},{"text":" (and ","type":"text"},{"type":"codeVoice","code":"isRefreshing"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"refreshError"},{"text":") are left exactly as they were; cancelling never surfaces a ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":" through ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" the way letting ","type":"text"},{"type":"codeVoice","code":"operation"},{"text":" itself fail would. If nothing is in flight, ","type":"text"},{"type":"codeVoice","code":"cancel()"},{"text":" does nothing.","type":"text"}]},{"type":"heading","text":"Resetting a store","level":2,"anchor":"Resetting-a-store"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)"},{"type":"text","text":" snaps a store back to "},{"type":"codeVoice","code":".loading"},{"type":"text","text":" (or any state you give it) outside of a "},{"type":"codeVoice","code":"load"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" call — useful for a full sign-out\/reset flow, where whatever the store was showing or fetching no longer applies:"}]},{"type":"codeListing","syntax":"swift","code":["store.reset() \/\/ back to .loading, as if freshly created","store.reset(to: .empty) \/\/ or straight to a specific state"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It cancels whatever operation is currently in flight, the same as "},{"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","isActive":true},{"type":"text","text":", and clears "},{"type":"codeVoice","code":"isRefreshing"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"refreshError"},{"type":"text","text":", so nothing stale can land and overwrite "},{"type":"codeVoice","code":"state"},{"type":"text","text":" after the reset."}]},{"type":"heading","text":"Previewing a screen in a specific state","level":2,"anchor":"Previewing-a-screen-in-a-specific-sta