{"abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/screenstates\/gettingstartedwithswiftui"]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"ScreenStates"}],"title":"Getting Started with SwiftUI"},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference"},{"type":"text","text":" is an "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" class that owns a screen’s "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference"},{"type":"text","text":" and knows how to run an async load. "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference"},{"type":"text","text":" switches on that state, rendering your content only for the "},{"code":".data","type":"codeVoice"},{"type":"text","text":" case and a placeholder otherwise."}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import ScreenStates","","struct ArticlesScreen: View {","    @State private var store = ScreenStateStore<[Article]>()","","    var body: some View {","        ScreenStateView(store.state, onRetry: reload) { articles in","            List(articles) { article in","                Text(article.title)","            }","        }","        .task { await reload() }","    }","","    private func reload() async {","        await store.loadCollection { try await api.fetchArticles() }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"store.loadCollection(_:)","type":"codeVoice"},{"type":"text","text":" sets "},{"code":".loading","type":"codeVoice"},{"type":"text","text":", runs the closure, and maps the outcome to "},{"code":".data","type":"codeVoice"},{"type":"text","text":", "},{"code":".empty","type":"codeVoice"},{"type":"text","text":" (when the result is an empty collection), or "},{"code":".error","type":"codeVoice"},{"type":"text","text":". "},{"code":"ScreenStateView","type":"codeVoice"},{"type":"text","text":" shows the default Loading spinner, Empty placeholder, or Error view — with a working Retry button wired to "},{"code":"onRetry","type":"codeVoice"},{"type":"text","text":" — automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’d rather not wrap the whole call site in an initializer, "},{"code":".screenState(_:onRetry:content:)","type":"codeVoice"},{"type":"text","text":" is the same thing as a view modifier:"}]},{"syntax":"swift","type":"codeListing","code":["EmptyView()","    .screenState(store.state, onRetry: reload) { articles in","        List(articles) { article in Text(article.title) }","    }"]},{"text":"Customizing the placeholders","type":"heading","anchor":"Customizing-the-placeholders","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"code":"empty","type":"codeVoice"},{"type":"text","text":", "},{"code":"loading","type":"codeVoice"},{"type":"text","text":", and "},{"code":"error","type":"codeVoice"},{"type":"text","text":" view builders to fully replace the defaults:"}]},{"syntax":"swift","type":"codeListing","code":["ScreenStateView(store.state) { articles in","    ArticleList(articles)","} empty: {","    ContentUnavailableView(\"No Articles Yet\", systemImage: \"newspaper\")","} loading: {","    ProgressView(\"Loading articles…\")","} error: { error in","    MyErrorBanner(error: error, retry: reload)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A fully custom placeholder like "},{"code":"MyErrorBanner","type":"codeVoice"},{"type":"text","text":" can still announce transitions to VoiceOver with the same wording the default placeholders use, via "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement","type":"reference"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":[".onAppear {","    if let announcement = state.accessibilityAnnouncement {","        AccessibilityNotification.Announcement(announcement).post()","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for "},{"code":".data","type":"codeVoice"},{"type":"text","text":" — your own content is what VoiceOver should read at that point — and, for "},{"code":".empty","type":"codeVoice"},{"type":"text","text":", it’s the default “Nothing Here” text; announce your own custom title directly instead if your placeholder shows one, so VoiceOver matches what’s on screen."}]},{"text":"Refreshing without losing data","type":"heading","anchor":"Refreshing-without-losing-data","level":2},{"type":"paragraph","inlineContent":[{"code":"loadCollection(_:)","type":"codeVoice"},{"type":"text","text":" always shows "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" first, which is right for the initial fetch but wrong for pull-to-refresh — the list shouldn’t disappear behind a spinner while it’s being refetched. Use "},{"code":"refreshCollection(_:)","type":"codeVoice"},{"type":"text","text":" instead: it keeps the current "},{"code":".data","type":"codeVoice"},{"type":"text","text":" on screen while the operation runs, and leaves it there if the operation fails instead of switching to "},{"code":".error","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["List(articles) { article in","    Text(article.title)","}",".refreshable {","    await store.refreshCollection { try await api.fetchArticles() }","}"]},{"type":"paragraph","inlineContent":[{"code":"store.isRefreshing","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for the duration; a failure is reported via "},{"code":"store.refreshError","type":"codeVoice"},{"type":"text","text":" rather than by discarding "},{"code":"state","type":"codeVoice"},{"type":"text","text":", so the list stays visible and you can surface the error separately (a toast, for example)."}]},{"text":"Retrying on failure","type":"heading","anchor":"Retrying-on-failure","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a flaky call worth retrying automatically before showing an error, use "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/loadWithRetry(maxAttempts:backoff:_:)","type":"reference"},{"type":"text","text":" instead of "},{"code":"loadCollection(_:)","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["await store.loadWithRetry(maxAttempts: 3) {","    try await api.fetchArticles()","}"]},{"type":"paragraph","inlineContent":[{"code":"state","type":"codeVoice"},{"type":"text","text":" stays "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" across every attempt; only the final failure, once "},{"code":"maxAttempts","type":"codeVoice"},{"type":"text","text":" is exhausted, switches it to "},{"code":".error","type":"codeVoice"},{"type":"text","text":". "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" is called with the attempt number that just failed and returns how long to wait before the next try, defaulting to doubling from one second."}]},{"text":"Overlapping calls are safe","type":"heading","anchor":"Overlapping-calls-are-safe","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing extra is needed to handle a screen firing off a second "},{"code":"loadCollection(_:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refresh(_:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"loadWithRetry(_:)","type":"codeVoice"},{"type":"text","text":" call before an earlier one has finished — a fast double-tap on Retry, or a new query arriving before the previous one resolved. "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference"},{"type":"text","text":" only ever applies the most recently started call’s result; a slower, now-stale response landing late is dropped instead of overwriting state a newer call already produced."}]},{"text":"Cancelling an in-flight call","type":"heading","anchor":"Cancelling-an-in-flight-call","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","type":"reference"},{"type":"text","text":" to stop whatever call is currently running, without waiting for it to resolve — useful from "},{"code":"onDisappear","type":"codeVoice"},{"type":"text","text":", or right before firing off a newer query:"}]},{"syntax":"swift","type":"codeListing","code":["store.cancel()"]},{"type":"paragraph","inlineContent":[{"code":"state","type":"codeVoice"},{"type":"text","text":" (and "},{"code":"isRefreshing","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refreshError","type":"codeVoice"},{"type":"text","text":") are left exactly as they were; cancelling never surfaces a "},{"code":"CancellationError","type":"codeVoice"},{"type":"text","text":" through "},{"code":"state","type":"codeVoice"},{"type":"text","text":" the way letting "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" itself fail would. If nothing is in flight, "},{"code":"cancel()","type":"codeVoice"},{"type":"text","text":" does nothing."}]},{"text":"Resetting a store","type":"heading","anchor":"Resetting-a-store","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/reset(to:)","type":"reference"},{"type":"text","text":" snaps a store back to "},{"code":".loading","type":"codeVoice"},{"type":"text","text":" (or any state you give it) outside of a "},{"code":"load","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refresh","type":"codeVoice"},{"type":"text","text":" call — useful for a full sign-out\/reset flow, where whatever the store was showing or fetching no longer applies:"}]},{"syntax":"swift","type":"codeListing","code":["store.reset() \/\/ back to .loading, as if freshly created","store.reset(to: .empty) \/\/ or straight to a specific state"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It cancels whatever operation is currently in flight, the same as "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore\/cancel()","type":"reference"},{"type":"text","text":", and clears "},{"code":"isRefreshing","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"refreshError","type":"codeVoice"},{"type":"text","text":", so nothing stale can land and overwrite "},{"code":"state","type":"codeVoice"},{"type":"text","text":" after the reset."}]},{"text":"Previewing a screen in a specific state","type":"heading","anchor":"Previewing-a-screen-in-a-specific-state","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give a preview-friendly screen its store via "},{"code":"init","type":"codeVoice"},{"type":"text","text":" 