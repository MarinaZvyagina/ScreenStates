ttingstartedwithswiftui","abstract":[{"text":"Drive a SwiftUI screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"article","type":"topic","title":"Getting Started with SwiftUI","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithSwiftUI"},"doc://screenstates.ScreenStates/documentation/ScreenStates/Accessibility":{"role":"article","url":"\/documentation\/screenstates\/accessibility","abstract":[{"text":"Everything the default placeholders — and your own custom ones — get for free: VoiceOver, Reduce Motion, Increase Contrast, Dynamic Type, and stable identifiers for XCUITest.","type":"text"}],"kind":"article","type":"topic","title":"Accessibility","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Accessibility"},"doc://screenstates.ScreenStates/documentation/ScreenStates":{"type":"topic","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates","abstract":[{"type":"text","text":"Give any screen a standard "},{"type":"codeVoice","code":"Empty"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Loading"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" state, usable from both UIKit and SwiftUI."}],"title":"ScreenStates","url":"\/documentation\/screenstates","kind":"symbol","role":"collection"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","navigatorTitle":[{"text":"ScreenState","kind":"identifier"}],"type":"topic","kind":"symbol","abs