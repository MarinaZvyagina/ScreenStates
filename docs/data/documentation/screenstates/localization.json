odeVoice","code":"Error"},{"type":"text","text":" state, usable from both UIKit and SwiftUI."}],"role":"collection","url":"\/documentation\/screenstates","kind":"symbol","type":"topic","title":"ScreenStates"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateViewController":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UIViewController"},{"type":"text","text":" base class that owns a "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"pinned to the view’s edges and bound to a "},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"wrapping the boilerplate every UIKit screen using ScreenStates"},{"type":"text","text":" "},{"type":"text","text":"otherwise repeats in "},{"type":"codeVoice","code":"viewDidLoad()"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/screenstates\/screenstateviewcontroller","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenStateViewController"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateViewController"}],"type":"topic","title":"ScreenStateViewController"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateView":{"navigatorTitle":[{"text":"ScreenStateView","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/screenstates\/screenstateview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateView","kind":"identifier"}],"abstract":[{"type":"text","text":"Renders the right content for a "},{"identifier":"doc:\/\/screenstates.Scr