states.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"pinned to the view’s edges and bound to a "},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"wrapping the boilerplate every UIKit screen using ScreenStates"},{"type":"text","text":" "},{"type":"text","text":"otherwise repeats in "},{"type":"codeVoice","code":"viewDidLoad()"},{"type":"text","text":"."}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController","url":"\/documentation\/screenstates\/screenstateviewcontroller"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState/accessibilityAnnouncement":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityAnnouncement"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"role":"symbol","kind":"symbol","type":"topic","title":"accessibilityAnnouncement","abstract":[{"text":"The same text the default placeholders announce to VoiceOver for","type":"text"},{"text":" ","type":"text"},{"text":"this case, reusable by a fully custom placeholder that wants to","type":"text"},{"text":" ","type":"text"},{"text":"announce transitions with the same wording instead of inventing its","type":"text"},{"text":" ","type":"text"},{"text":"own. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".data","type":"codeVoice"},{"text":", since at that point a custom placeholder’s","type":"text"},{"text":" ","type":"text"},{"text":"own content is what VoiceOver should read, not a transition","type":"text"},{"text":" ","type":"text"},{"text":"announcement.","type":"text"}],"identifier":"doc: