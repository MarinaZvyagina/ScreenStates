 debugging string (or, for a"},{"type":"text","text":" "},{"type":"text","text":"plain "},{"code":"Error","type":"codeVoice"},{"type":"text","text":" with no "},{"code":"CustomStringConvertible","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"LocalizedError","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"conformance, just the type name) rather than something to put in front"},{"type":"text","text":" "},{"type":"text","text":"of the person using the app."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateStore":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenStateStore"}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenStateStore"}],"url":"\/documentation\/screenstates\/screenstatestore","title":"ScreenStateStore","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" holder of a screen’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState"},{"type":"text","text":", driving both"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI and UIKit consumers from a single source of truth."}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"type":"topic","role":"article","kind":"article","url":"\/documentation\/screenstates\/gettingstartedwithuikit","abstract":[{"text":"Drive a UIKit screen’s four states with ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","isActive":true,"type":"reference"},{"text":".","type"