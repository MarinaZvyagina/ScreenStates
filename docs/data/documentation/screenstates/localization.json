","type":"topic","title":"ScreenState"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateViewController":{"url":"\/documentation\/screenstates\/screenstateviewcontroller","title":"ScreenStateViewController","navigatorTitle":[{"text":"ScreenStateViewController","kind":"identifier"}],"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateViewController","abstract":[{"text":"A ","type":"text"},{"code":"UIViewController","type":"codeVoice"},{"text":" base class that owns a ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"pinned to the view’s edges and bound to a ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"wrapping the boilerplate every UIKit screen using ScreenStates","type":"text"},{"text":" ","type":"text"},{"text":"otherwise repeats in ","type":"text"},{"code":"viewDidLoad()","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateViewController","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateContainerView","kind":"identifier"}],"navigatorTitle":[{"text":"ScreenStateContainerView","kind":"identifier"}],"title":"ScreenStateContainerView","url":"\/documentation\/screenstates\/screenstatecontainerview","kind":"symbol","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","role":"symbol","abstract":[{"text":"A ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" that swaps its content for the right placeholder based on a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","isActive":true,"type":"reference"},{"text":", mirroring ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","isActive":true,"type":"reference"},{"text":" from the SwiftUI side.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/GettingStartedWithUIKit":{"type":"topic","title":"Getting Started with UIKit","url":"\/documentation\/screenstates\/gettingstartedwithuikit","kind":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/GettingStartedWithUIKit","role":"article","abstract":[{"text":"Drive a UIKit screen’s four states with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateStore"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView"},{"text":".","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState/accessibilityAnnouncement":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState\/accessibilityAnnouncement","title":"accessibilityAnnouncement","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The same text the default placeholders announce to VoiceOver for"},{"type":"text","text":" "},{"type":"text","text":"this case, reusable by a fully custom placeholder that wants to"},{"type":"text","text":" "},{"type":"text","text":"announce transitions with the same wording instead of inventing its"},{"type":"text","text":" "},{"type":"text","text":"own. "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for "},{"code":".data","type":"codeVoice"},{"type":"text","text":", since at that point a custom placeholder’s"},{"type":"text","text":" "},{"type":"text","text":"own content is what VoiceOver should read, not a transition"},{"type":"text","text":" "},{"type":"text","text":"announcement."}],"url":"\/documentation\/screenstates\/screenstate\/accessibilityannouncement","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityAnnouncement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateDisplayableError":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateDisplayableError","navigatorTitle":[{"text":"ScreenStateDisplayableError","kind":"identifier"}],"title":"ScreenStateDisplayableError","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Lets an error type supply its own user-facing message, distinct from"},{"type":"text","text":" "},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" — which is often a debugging string (or, for a"},{"type":"text","text":" "},{"type":"text","text":"plain "},{"code":"Error","type":"codeVoice"},{"type":"text","text":" with no "},{"code":"CustomStringConvertible","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"LocalizedError","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"conformance, just the type name) rather than something to put in front"},{"type":"text","text":" "},{"type":"text","text":"of the person using the app."}],"url":"\/documentation\/screenstates\/screenstatedisplayableerror","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateDisplayableError","kind":"identifier"}],"role":"symbol"},"doc://screenstates.ScreenStates/documentation/ScreenStates/Accessibility":{"abstract":[{"type":"text","text":"Everything the default placeholders — and your own custom ones — get for free: VoiceOver, Reduce Motion, Increase Contrast, Dynamic Type, and stable identifiers for XCUITest."}],"role":"article","identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/Accessibility","url":"\/documentation\/screenstates\/accessibility","type":"topic","title":"Accessibility","kind":"article"}}}