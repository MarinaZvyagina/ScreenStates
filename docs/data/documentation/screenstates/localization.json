de":"CustomStringConvertible"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"LocalizedError"},{"type":"text","text":" "},{"type":"text","text":"conformance, just the type name) rather than something to put in front"},{"type":"text","text":" "},{"type":"text","text":"of the person using the app."}],"title":"ScreenStateDisplayableError","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateDisplayableError","kind":"identifier"}],"url":"\/documentation\/screenstates\/screenstatedisplayableerror","kind":"symbol","navigatorTitle":[{"text":"ScreenStateDisplayableError","kind":"identifier"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenStateContainerView":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateContainerView","url":"\/documentation\/screenstates\/screenstatecontainerview","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenStateContainerView","kind":"identifier"}],"kind":"symbol","title":"ScreenStateContainerView","navigatorTitle":[{"text":"ScreenStateContainerView","kind":"identifier"}],"type":"topic","abstract":[{"text":"A ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" that swaps its content for the right placeholder based on a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","type":"reference","isActive":true},{"text":", mirroring ","type":"text"},{"isActive":true,"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenStateView","type":"reference"},{"text":" from the SwiftUI side.","type":"text"}]},"doc://screenstates.ScreenStates/documentation/ScreenStates/ScreenState":{"identifier":"doc:\/\/screenstates.ScreenStates\/documentation\/ScreenStates\/ScreenState","url":"\/documentation\/screenstates\/screenstate","role":"symbol","fragments":[{"kind":"keyword","text":"e